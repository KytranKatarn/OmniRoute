# A.R.C.H.I.E. Platform - Git Ignore Rules
# Created: 2026-01-05

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Environment
.env
.env.local
*.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/

# QA / P.R.O.B.E. test artifacts
platform_v2/qa/test-screenshots/

# Database
*.db
*.sqlite
*.sqlite3

# Backups (handled separately in /backups/)
*.backup
*.bak
# Suffixed backup variants (e.g. .bak-npm-decom-20260627, .bak-4287) — *.bak above
# only matches files ending in .bak, NOT .bak-<suffix>. These often back up
# secrets (.env.bak-*) so they MUST be ignored before a git add -A near-miss.
*.bak-*
*.bak.*
.env.bak*
*.env.bak*

# Temporary files
tmp/
temp/
*.tmp

# OS
.DS_Store
Thumbs.db

# Node modules (if any)
node_modules/

# Sensitive data
secrets/
credentials/
*.key
*.pem

# Test coverage
.coverage
htmlcov/

# pytest temp directories (e.g. pytest-of-kytran/)
pytest-of-*/

# MCP Server Config (contains credentials)
.mcp.json

# Claude Code local settings (any depth)
**/settings.local.json
**/.claude/statsig/
**/.claude/todos/
**/.claude/projects/

# Local working notes — design/scoping plans + research scratch (not source)
.claude/plans/
.claude/research/

# Session data
conversation_logs/
persistence/

# Docker image tarballs
*.tar.gz

# Host-specific data
host_monitor_data.json
bandwidth_history.json
# Hardware-change detection baseline (host_monitor.py, PRs #2492/#2496) —
# runtime state beside its siblings above; versioning drift-detection state
# in git adds nothing (#5288).
hardware_baseline.json
CREDENTIALS.md

# Auto-generated skill index — rewritten every 6h by consciousness Job #54
# (sync_learned_skills). Its own header says the real content lives in the KB;
# keeping it tracked meant a permanently-dirty tree (#5288). Untracked
# 2026-07-27; sessions in fresh worktrees fall back to `mcp search_knowledge`.
.claude/rules/learned-skills.md

# Backups directory (36GB+, managed separately)
backups/

# Screenshots & test artifacts (Playwright, visual baselines)
/*.png
screenshots/
test-results/
.playwright-mcp/

# Audio samples (generated/test WAV files)
platform_v2/static/voice_*.wav

# Media Studio generated files (keep directory structure via .gitkeep)
platform_v2/static/media/users/
platform_v2/static/media/agents/
platform_v2/static/media/portraits/
platform_v2/static/media/environments/
platform_v2/static/media/brands/
!platform_v2/static/media/.gitkeep

# Node.js (Playwright test runner)
package.json
package-lock.json

# Root-level test scripts (one-off, not part of CI)
/test_*.py

# Local debug scratch + generated QA artifacts
sandbox/
platform_v2/static/qa_reports/

# Host command queue
host_commands/

# Website QA screenshots & large assets
website/qa-screenshots/
platform_v2/static/baselines/
# Portrait dir: ignore heavy SDXL PNG originals, but track JPEG thumbs
# that ship with the public site (generated by scripts/generate_portrait_thumbnails.py).
website/kytranempowerment.com/assets/portraits/*.png
website/kytranempowerment.com/assets/logo.png
website/kytranempowerment.com/assets/cart-icon.png

# Standalone products (live at /mnt/standalone/, symlinked here)
archie-code/
kytran-creed/
website/creed-ai.org/
kytran-server-manager/
kytran-gov-watch/
kytran-business-suite/
kytran-news/
watch-api/
legal-watch/
market-watch/

# Ingested GitHub skills — reference corpus (KB-searchable, NOT loadable Claude skills; #3962)
.claude/skills/github/
.claude/skills-library/

# HTML mockup files in root
/*.html
.worktrees/
.claude/worktrees/
repos/
platform_v2/static/downloads/*.exe
.superpowers/
.secrets/

# ============================================================================
# Project #272 Phase 4 — persistent untracked artifacts (#2115)
# ============================================================================

# P.R.O.B.E. QA report PDFs — generated per run, not committed
platform_v2/static/qa_reports/

# Sandbox — repair-bay / Project #272 smoke-test artifacts
sandbox/

# Ad-hoc debug scripts (session-scoped, not part of CI).
# Project #272 Phase 4 task #2114 organized one-shot debugs into
# scripts/debug/. Root-level scripts/debug_*.py is kept ignored so a
# stray drop into scripts/ doesn't accidentally land in git. Real test
# utilities live in scripts/tests/ and remain tracked.
scripts/debug_*.py
scripts/debug/

# Generated DR triage reports (runtime output from backup_triage.sh, not source)
scripts/backup/dr_reports/

# Portrait thumb staging — portrait_service._sync_website_thumb writes
# here when the website dir is mounted read-only inside the container.
# publish_website.sh sweeps these into website/.../assets/portraits/
# before each deploy. Staging output is runtime state, not source.
platform_v2/static/media/thumbs/
scripts/opencode
OPERATIONAL_RUNBOOK.md
account-center-snap.md

# GPU per-card telemetry (#5273) — written by scripts/gpu_state_exporter.py host cron
platform_v2/.runtime/

# /design-sync build output (regenerated; .design-sync/ holds the durable config)
ds-bundle/

# design handoff archives — the extracted bundle is committed, the zip is not
*.zip
