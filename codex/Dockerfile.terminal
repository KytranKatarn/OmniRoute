# Codex web terminal — the codex image + ttyd/tmux for an interactive browser terminal.
#
# ⚠️ This header said "Sandboxed … the container is the isolation boundary (no host fs/
# secrets)" until 2026-09-13. Under option B the compose file mounts the live platform
# tree and /var/run/docker.sock, and the bearer is read+write — so the container stops
# being the boundary. Whether that applies is decided in docker-compose.yml, not here;
# read it there rather than trusting this file. See start_codex_terminal.sh.
FROM archie_brain-archie_codex:latest

# Preserve the deployed CLI version even when the shared base tag is older.
ARG CODEX_CLI_VERSION=0.154.0
RUN npm install --global @openai/codex@${CODEX_CLI_VERSION}

# tmux from apt; ttyd is not in Debian repos → fetch the static release binary.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tmux curl ca-certificates python3 python3-yaml \
    && curl -fsSL https://github.com/tsl0922/ttyd/releases/download/1.7.7/ttyd.x86_64 -o /tmp/ttyd \
    && echo "8a217c968aba172e0dbf3f34447218dc015bc4d5e59bf51db2f2cd12b7be4f55  /tmp/ttyd" | sha256sum -c - \
    && install -m 0755 /tmp/ttyd /usr/local/bin/ttyd && rm /tmp/ttyd \
    # Docker CLIENT ONLY (no daemon) + the compose plugin, pinned. Added 2026-09-13
    # for option B: mounting /var/run/docker.sock gives a lane the ABILITY to drive
    # docker, but the socket is useless without a client — both lanes had none, so a
    # correctly-applied mount would still have failed with "docker: not found".
    #
    # ⚠️ INERT WITHOUT THE SOCKET. Shipping this binary grants nothing on its own; it
    # is the socket mount in docker-compose.yml that confers host-equivalent power.
    # Removing the mount disables this again without touching the image.
    && curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-29.8.0.tgz \
         | tar -xz -C /usr/local/bin --strip-components=1 docker/docker \
    && mkdir -p /usr/local/lib/docker/cli-plugins \
    && curl -fsSL https://github.com/docker/compose/releases/download/v5.5.1/docker-compose-linux-x86_64 \
         -o /usr/local/lib/docker/cli-plugins/docker-compose \
    && chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose \
    # gh — owner request, so the lane can open/inspect PRs without hand-rolling the
    # API. Not in Debian bookworm, so take the pinned release tarball + digest rather
    # than adding an apt repo; same supply-chain posture as ttyd above. It lands at
    # /usr/bin/gh and is SHADOWED on PATH by the guard copied in below — see
    # scripts/lane_gh_guard.sh for why (`gh pr merge` bypasses the F.O.R.G.E. gate).
    && curl -fsSL https://github.com/cli/cli/releases/download/v2.63.2/gh_2.63.2_linux_amd64.tar.gz -o /tmp/gh.tgz \
    && echo "912fdb1ca29cb005fb746fc5d2b787a289078923a29d0f9ec19a0b00272ded00  /tmp/gh.tgz" | sha256sum -c - \
    && tar -xzf /tmp/gh.tgz -C /tmp \
    && install -m 0755 /tmp/gh_2.63.2_linux_amd64/bin/gh /usr/bin/gh \
    && rm -rf /tmp/gh.tgz /tmp/gh_2.63.2_linux_amd64 \
    && apt-get purge -y curl && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/start_codex_terminal.sh /start.sh
COPY codex/workspace/init-workspace.sh /init-workspace.sh
COPY codex/workspace/ds9_profile.py /opt/codex-ds9/write_profile.py
COPY codex/workspace/codex-ds9.sh /usr/local/bin/codex-ds9
COPY codex/workspace/codex-pr.sh /usr/local/bin/codex-pr
# Baked, tamper-resistant scope guard: the hook + a copy of the allowlist live in
# the IMAGE (not the cloned tree), so editing repo files cannot loosen the guard.
# init-workspace points core.hooksPath at /opt/codex-guard.
COPY codex/workspace/git-hooks/pre-push /opt/codex-guard/pre-push
COPY config/agents/codex.yaml /opt/codex-guard/allowlist.yaml
COPY codex/skills/ /opt/archie-codex-skills/
COPY codex/workspace/start-with-skills.sh /start-with-skills.sh
# gh guard — /usr/local/bin precedes /usr/bin on PATH, so this shadows the real gh
# and refuses `pr merge` / `pr review` / protection edits, pointing at /merge-pr
# instead. A guardrail, not a boundary (the lane is root-equivalent since option B);
# the header of the script is explicit about that and about the server-side fix.
COPY scripts/lane_gh_guard.sh /usr/local/bin/gh
RUN chmod +x /usr/local/bin/codex-ds9 /start.sh /start-with-skills.sh /init-workspace.sh /usr/local/bin/codex-pr /opt/codex-guard/pre-push /usr/local/bin/gh

# UID 0 with cap_drop=ALL cannot map root into a fresh user namespace on this
# kernel. Keep the CLI unprivileged; do not add SYS_ADMIN/SETFCAP to compensate.
# Existing persistent volumes require the reviewed ownership migration before
# recreating this service. Image ownership initializes newly created volumes.
ENV HOME=/home/node
RUN install -d -o node -g node -m 0750 /codex-home /work
USER node

EXPOSE 7681
ENTRYPOINT ["/start-with-skills.sh"]
