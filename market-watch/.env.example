# Flask
SECRET_KEY=change-me-to-random-64-char-string
MW_DB_PATH=/app/data/market.db

# Kytran OAuth
KYTRAN_CLIENT_ID=market-watch-viewer
KYTRAN_CLIENT_SECRET=change-me
KYTRAN_AUTH_URL=http://192.168.1.200:3000
KYTRAN_REDIRECT_URI=http://192.168.1.200:8080/auth/kytran/callback

# Hub Dispatch (for agent pipeline)
ARCHIE_HUB_URL=http://192.168.1.200:3000
ARCHIE_SERVICE_TOKEN=change-me

# VPS overrides (uncomment for production)
# KYTRAN_AUTH_URL=http://100.64.0.1:3000
# KYTRAN_REDIRECT_URI=https://market.kytranempowerment.com/auth/kytran/callback
# ARCHIE_HUB_URL=http://100.64.0.1:3000

# Rate limiting
RATELIMIT_STORAGE_URI=memory://

# Risk Gates
MW_MIN_ORACLE_CONFIDENCE=0.65
MW_MAX_DAILY_LOSS_PCT=3.0
MW_MAX_DRAWDOWN_PCT=5.0
MW_MAX_POSITIONS=5
MW_MAX_POSITION_PCT=10.0
MW_MAX_SECTOR_POSITIONS=2
MW_VOLATILITY_ATR_LIMIT=5.0
MW_COOLOFF_LOSS_PCT=2.0

# Position Management
MW_DEFAULT_HOLD_DAYS=5

# Cycle Control
MW_CYCLE_DEDUP_MINUTES=15

# Safety
MW_DRY_RUN=true
MW_TRADING_ENABLED=true
MW_LIVE_TRADING=false

# News / Alpha Vantage
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_NEWS_ENABLED=true
NEWS_INGEST_INTERVAL=900
NEWS_MAX_AGE_MINUTES=30

# Position Monitoring
MW_POSITION_CHECK_INTERVAL=60

# Quant Risk
MW_KELLY_ENABLED=true
MW_KELLY_FRACTION=0.5
MW_KELLY_MIN_TRADES=10
MW_MAX_PORTFOLIO_BETA=1.5
MW_CORRELATION_THRESHOLD=0.7
MW_RISK_METRICS_TTL_DAYS=7
