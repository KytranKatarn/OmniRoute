# {{ node_name }} — Outpost node
# Auto-generated by ARCHIE monitoring service — do not edit manually

define host {
    use                     linux-server
    host_name               {{ node_id }}
    alias                   {{ node_name }} ({{ hostname }})
    address                 {{ hostname }}
    max_check_attempts      3
    check_interval          1
    retry_interval          0.5
    notification_interval   30
    notification_period     24x7
    hostgroups              archie-fleet
}

define service {
    use                     generic-service
    host_name               {{ node_id }}
    service_description     SMTP Relay
    check_command           check_smtp!-p 25
    check_interval          3
    retry_interval          0.5
    max_check_attempts      3
}

define service {
    use                     generic-service
    host_name               {{ node_id }}
    service_description     HTTP Proxy
    check_command           check_http!-p 80 -e "200,301,302,308"
    check_interval          3
    retry_interval          0.5
    max_check_attempts      3
}

define service {
    use                     generic-service
    host_name               {{ node_id }}
    service_description     Node API
    check_command           check_http!-p 3001 -u /health -e "200"
    check_interval          3
    retry_interval          0.5
    max_check_attempts      3
}
