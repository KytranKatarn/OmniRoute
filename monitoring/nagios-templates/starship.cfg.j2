# {{ node_name }} — Starship GPU node
# Auto-generated by ARCHIE monitoring service — do not edit manually

define host {
    use                     linux-server
    host_name               {{ node_id }}
    alias                   {{ node_name }} ({{ hostname }})
    address                 {{ hostname }}
    max_check_attempts      3
    check_interval          1
    retry_interval          0.5
    notification_interval   30
    notification_period     24x7
    hostgroups              archie-fleet
}

define service {
    use                     generic-service
    host_name               {{ node_id }}
    service_description     Ollama API
    check_command           check_http!-p 11434 -u /api/tags -e "200"
    check_interval          3
    retry_interval          0.5
    max_check_attempts      3
}

define service {
    use                     generic-service
    host_name               {{ node_id }}
    service_description     Node API
    check_command           check_http!-p 3001 -u /health -e "200"
    check_interval          3
    retry_interval          0.5
    max_check_attempts      3
}
