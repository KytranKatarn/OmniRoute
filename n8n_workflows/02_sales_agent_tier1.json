{
  "name": "Sales Agent - Tier 1",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sales-agent",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-sales",
      "name": "Sales Agent Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "sales-agent-tier1"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE conversations \nSET assigned_agent_id = (SELECT id FROM agents WHERE name = 'Sales Agent Tier 1' LIMIT 1),\n    agent_type = 'tier1'\nWHERE id = '{{ $json.conversationId }}'::uuid\nRETURNING *;",
        "options": {}
      },
      "id": "assign-agent",
      "name": "Assign Sales Agent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [450, 300],
      "credentials": {
        "postgres": {
          "id": "archie_database",
          "name": "Archie Database"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.*, cust.name as customer_name, cust.company, cust.previous_purchases\nFROM customers cust\nLEFT JOIN conversations c ON c.customer_id = cust.id\nWHERE cust.phone_number = '{{ $json.customerPhone }}'\nLIMIT 1;",
        "options": {}
      },
      "id": "get-customer-history",
      "name": "Get Customer History",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [650, 300],
      "credentials": {
        "postgres": {
          "id": "archie_database",
          "name": "Archie Database"
        }
      }
    },
    {
      "parameters": {
        "url": "http://archie_platform:5000/tools/archie/api/search",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"product catalog pricing sales information\",\n  \"limit\": 5,\n  \"context\": \"sales_call\"\n}",
        "options": {}
      },
      "id": "search-knowledge-base",
      "name": "Search A.R.C.H.I.E. Knowledge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [850, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "archie-api-key",
          "name": "A.R.C.H.I.E. API Key"
        }
      }
    },
    {
      "parameters": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-5-sonnet-20241022\",\n  \"max_tokens\": 1024,\n  \"system\": \"You are a professional sales representative for our company. You have access to customer history and product knowledge. Be helpful, friendly, and focus on understanding customer needs. If a question is too complex or requires technical expertise, escalate to Tier 2.\\n\\nCustomer History: {{ $json.customer_name ? $json.customer_name + ' from ' + $json.company : 'New customer' }}\\nPrevious Purchases: {{ $json.previous_purchases || 'None' }}\\n\\nKnowledge Base Context:\\n{{ $('Search A.R.C.H.I.E. Knowledge').item.json.results }}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Initial greeting for sales inquiry call. Customer is calling about: {{ $json.intent }}\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "claude-sales-response",
      "name": "Claude Sales Response",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1050, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "anthropic-api-key",
          "name": "Anthropic API Key"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO conversation_turns (id, conversation_id, turn_number, speaker, message, timestamp)\nVALUES (\n  gen_random_uuid(),\n  '{{ $json.conversationId }}'::uuid,\n  1,\n  'agent',\n  '{{ $('Claude Sales Response').item.json.content[0].text }}',\n  NOW()\n);",
        "options": {}
      },
      "id": "log-response",
      "name": "Log Agent Response",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1250, 300],
      "credentials": {
        "postgres": {
          "id": "archie_database",
          "name": "Archie Database"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "// Check if escalation is needed based on Claude's response\nconst response = $('Claude Sales Response').item.json.content[0].text;\nconst needsEscalation = response.toLowerCase().includes('escalate') || \n                        response.toLowerCase().includes('transfer') ||\n                        response.toLowerCase().includes('tier 2');\n\nif (needsEscalation) {\n  return {\n    json: {\n      ...items[0].json,\n      shouldEscalate: true,\n      escalationReason: 'Complex inquiry requiring Tier 2 expertise'\n    }\n  };\n}\n\nreturn {\n  json: {\n    ...items[0].json,\n    shouldEscalate: false\n  }\n};"
      },
      "id": "check-escalation",
      "name": "Check Escalation Need",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.shouldEscalate }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if-escalate",
      "name": "IF Escalate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1650, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO escalations (id, conversation_id, from_agent_id, to_agent_id, reason, status, escalated_at)\nVALUES (\n  gen_random_uuid(),\n  '{{ $json.conversationId }}'::uuid,\n  (SELECT id FROM agents WHERE name = 'Sales Agent Tier 1' LIMIT 1),\n  (SELECT id FROM agents WHERE name = 'Sales Agent Tier 2' LIMIT 1),\n  '{{ $json.escalationReason }}',\n  'pending',\n  NOW()\n)\nRETURNING *;",
        "options": {}
      },
      "id": "create-escalation",
      "name": "Create Escalation",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [1850, 200],
      "credentials": {
        "postgres": {
          "id": "archie_database",
          "name": "Archie Database"
        }
      }
    },
    {
      "parameters": {
        "url": "http://archie_platform:5000/n8n/workflows/sales-agent-tier2",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "conversationId",
              "value": "={{ $json.conversationId }}"
            },
            {
              "name": "escalationId",
              "value": "={{ $json.id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "trigger-tier2",
      "name": "Trigger Tier 2 Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [2050, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ \n  status: 'success', \n  response: $('Claude Sales Response').item.json.content[0].text,\n  escalated: $json.shouldEscalate || false\n}) }}",
        "options": {}
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1850, 400]
    }
  ],
