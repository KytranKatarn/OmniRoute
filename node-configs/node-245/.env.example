# A.R.C.H.I.E. Node .245 Configuration
# Copy to .env and fill in required values before starting.

# REQUIRED: Get NODE_ID from hub after registering this node
NODE_ID=

# REQUIRED: API key for hub communication
HUB_API_KEY=

# Hub connection (default: 192.168.1.200:3000)
HUB_URL=http://192.168.1.200:3000

# Database password (change in production)
DB_PASSWORD=archie_node_default

# Timezone
NODE_TIMEZONE=America/Toronto

# ComfyUI port (if enabled)
