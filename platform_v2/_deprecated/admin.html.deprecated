        <!-- IMPROVEMENTS SECTION - Moved to standalone module -->
        <!-- Access at: /tools/improvements-lab/ -->

        <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs/loader.min.js"></script>
        <script>
        // NOTE: Improvements functions moved to standalone module at /tools/improvements-lab/
        // Variables that might be referenced elsewhere (kept as stubs)
        let monacoInstance = null;
        let currentFile = null;
        let currentImprovementId = null;
        </script>

        <!-- API SETTINGS SECTION -->
        <script>
        // Load Agent-to-API Mapping
        async function loadAgentAPIMapping() {
            try {
                const res = await fetch('/tools/improvements-lab/api-settings/agent-mapping', {credentials: 'same-origin'});
                const data = await res.json();

                if (data.success) {
                    displayAgentAPIMapping(data.agents, data.providers);
                }
            } catch (error) {
                console.error('Error loading agent mapping:', error);
            }
        }

        function displayAgentAPIMapping(agents, providers) {
            const container = document.getElementById('agentAPIMapping');
            if (!container) return;

            // Group agents by required provider
            const providerGroups = {};

            agents.forEach(agent => {
                if (agent.worker_type !== 'contract') return;

                // Determine provider from model
                const model = agent.model.toLowerCase();
                let provider = 'unknown';

                if (model.includes('claude') || model.includes('anthropic')) provider = 'claude';
                else if (model.includes('gpt') || model.includes('openai')) provider = 'openai';
                else if (model.includes('mistral') && !model.includes(':latest')) provider = 'mistral';
                else if (model.includes('gemini') || model.includes('google')) provider = 'gemini';

                if (!providerGroups[provider]) providerGroups[provider] = [];
                providerGroups[provider].push(agent);
            });

            container.innerHTML = '';

            if (Object.keys(providerGroups).length === 0) {
                container.innerHTML = `
                    <div style="padding: 20px; text-align: center; opacity: 0.6;">
                        ✓ No contract agents configured. All agents use internal/FREE models.
                    </div>
                `;
                return;
            }

            // Create provider blocks
            for (const [provider, agentList] of Object.entries(providerGroups)) {
                const providerConfig = providers.find(p => p.provider === provider);
                const isConfigured = providerConfig && providerConfig.enabled && providerConfig.api_key;
                const statusColor = isConfigured ? '#00FF00' : '#FF4444';
                const statusIcon = isConfigured ? '✓' : '⚠️';
                const statusText = isConfigured ? 'CONFIGURED' : 'NOT CONFIGURED';

                const providerBlock = document.createElement('div');
                providerBlock.style.cssText = 'border: 1px solid ' + statusColor + '; padding: 20px; margin-bottom: 15px; background: rgba(0,255,0,0.02);';

                providerBlock.innerHTML = `
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                        <div>
                            <strong style="font-size: 1.1rem;">${provider.toUpperCase()} API</strong>
                            <div style="opacity: 0.7; margin-top: 5px;">${agentList.length} contract agent(s) require this API</div>
                        </div>
                        <div style="color: ${statusColor}; font-weight: bold;">
                            ${statusIcon} ${statusText}
                        </div>
                    </div>

                    <div style="margin: 15px 0; padding: 10px; background: rgba(0,0,0,0.3); border-left: 3px solid ${statusColor};">
                        <strong>Agents using ${provider.toUpperCase()}:</strong><br>
                        ${agentList.map(a => `
                            <span style="display: inline-block; margin: 5px 10px 5px 0;">
                                • ${a.name} (${a.department})
                            </span>
                        `).join('')}
                    </div>

                    ${!isConfigured ? `
                        <div style="margin-top: 10px; padding: 10px; background: rgba(255,68,68,0.1); border: 1px solid #FF4444;">
                            <strong>⚠️ WARNING:</strong> These agents cannot be used until ${provider.toUpperCase()} API is configured.<br>
                            <strong>Fallback:</strong> A.R.C.H.I.E. will automatically assign internal staff instead.
                        </div>
                    ` : ''}

                    <div style="margin-top: 15px;">
                        <button class="btn btn-small" onclick="document.querySelector('#api_key_${provider}').scrollIntoView({behavior: 'smooth'})">
                            ${isConfigured ? '📝 UPDATE API KEY' : '🔑 CONFIGURE API KEY'}
                        </button>
                    </div>
                `;

                container.appendChild(providerBlock);
            }
        }

        // Load API Providers
        async function loadAPIProviders() {
            try {
                const res = await fetch('/tools/improvements-lab/api-settings/providers', {credentials: 'same-origin'});
                const data = await res.json();

                if (data.success) {
                    displayAPIProviders(data.providers);
                }
            } catch (error) {
                console.error('Error loading API providers:', error);
            }
        }

        function displayAPIProviders(providers) {
            const container = document.getElementById('apiProvidersContainer');
            container.innerHTML = '';

            providers.forEach(provider => {
                const providerCard = document.createElement('div');
                providerCard.style.cssText = 'border: 1px solid #00FF00; padding: 20px; margin-bottom: 15px; background: rgba(0,255,0,0.02);';

                const isDefault = provider.is_default ? ' (DEFAULT)' : '';
                const statusColor = provider.enabled ? '#00FF00' : '#FF0000';

                providerCard.innerHTML = `
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                        <div>
                            <strong style="font-size: 1.1rem;">${provider.provider.toUpperCase()}${isDefault}</strong>
                            <div style="opacity: 0.7; margin-top: 5px;">${provider.model_name || 'No model set'}</div>
                        </div>
                        <div>
                            <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                                <input type="checkbox"
                                       ${provider.enabled ? 'checked' : ''}
                                       onchange="toggleProvider('${provider.provider}', this.checked)"
                                       style="width: 20px; height: 20px;">
                                <span style="color: ${statusColor};">${provider.enabled ? 'ENABLED' : 'DISABLED'}</span>
                            </label>
                        </div>
                    </div>

                    ${provider.provider !== 'ollama' ? `
                    <div style="margin-top: 15px;">
                        <label style="display: block; margin-bottom: 5px; opacity: 0.8;">API Key:</label>
                        <input type="password"
                               id="api_key_${provider.provider}"
                               value="${provider.api_key || ''}"
                               placeholder="Enter API key..."
                               style="width: 100%; background: #000; border: 1px solid #00FF00; color: #00FF00; padding: 8px; font-family: monospace;">
                    </div>
                    ` : ''}

                    <div style="margin-top: 15px; display: flex; gap: 10px;">
                        <button class="btn btn-small" onclick="setDefaultProvider('${provider.provider}')">
                            ${provider.is_default ? '✓ IS DEFAULT' : 'SET AS DEFAULT'}
                        </button>
                        <button class="btn btn-small" onclick="testProvider('${provider.provider}')">
                            🔌 TEST
                        </button>
                    </div>
                `;

                container.appendChild(providerCard);
            });
        }

        async function toggleProvider(provider, enabled) {
            const res = await fetch('/tools/improvements-lab/api-settings/toggle', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                credentials: 'same-origin',
                body: JSON.stringify({ provider, enabled })
            });

            const data = await res.json();
            if (data.success) {
                showNotification(`${provider} ${enabled ? 'enabled' : 'disabled'}`);
                loadAPIProviders();
            }
        }

        async function setDefaultProvider(provider) {
            try {
                const res = await fetch('/tools/improvements-lab/api-settings/set-default', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    credentials: 'same-origin',
                    body: JSON.stringify({ provider })
                });

                const data = await res.json();
                if (data.success) {
                    showSuccess(`${provider.toUpperCase()} set as default AI provider`);
                    loadAPIProviders();
                } else {
                    showError(`Failed to set ${provider} as default`);
                }
            } catch (error) {
                showError(`Failed to set default provider: ${error.message}`);
            }
        }

        async function testProvider(provider) {
            showInfo(`Testing ${provider.toUpperCase()} connection...`);

            try {
                const res = await fetch(`/tools/improvements-lab/api-settings/test/${provider}`, {credentials: 'same-origin'});
                const data = await res.json();

                if (data.success) {
                    showSuccess(`${provider.toUpperCase()} connection successful! ${data.message || ''}`);
                } else {
                    showError(`${provider.toUpperCase()} connection failed: ${data.error}`);
                }
            } catch (error) {
                showError(`Failed to test ${provider}: ${error.message}`);
            }
        }

        async function saveAPISettings() {
            showInfo('Saving API settings...');

            try {
                // Collect API keys
                const settings = {};
                ['claude', 'openai', 'gemini', 'grok'].forEach(provider => {
                    const input = document.getElementById(`api_key_${provider}`);
                    if (input) {
                        settings[provider + '_api_key'] = input.value;
                    }
                });

                const res = await fetch('/tools/improvements-lab/api-settings/save', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    credentials: 'same-origin',
                    body: JSON.stringify(settings)
                });

                const data = await res.json();
                if (data.success) {
                    showSuccess('API settings saved successfully!');
                    // Reload provider display
                    await loadAPIProviders();
                } else {
                    showError('Failed to save API settings: ' + (data.error || 'Unknown error'));
                }
            } catch (error) {
                showError('Failed to save API settings: ' + error.message);
            }
        }

        async function testAPIConnections() {
            showInfo('Testing API connections...');

            try {
                const res = await fetch('/tools/improvements-lab/api-settings/test', {
                    method: 'POST',
                    credentials: 'same-origin'
                });

                const data = await res.json();
                if (data.success) {
                    const working = data.results.filter(r => r.working).length;
                    const total = data.results.length;

                    if (working === total) {
                        showSuccess(`All ${total} API connections working!`);
                    } else if (working > 0) {
                        showWarning(`${working}/${total} API connections working`);
                    } else {
                        showError('All API connections failed');
                    }
                } else {
                    showError('Failed to test API connections');
                }
            } catch (error) {
                showError('Failed to test API connections: ' + error.message);
            }
        }
        </script>

