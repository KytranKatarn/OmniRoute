                <button class="btn" onclick="loadNotificationsPage(currentPage - 1)" id="notif-prev-btn" disabled>← PREV</button>
                <span id="notif-page-info" style="color: #00FF00;">Page 1 of 1</span>
                <button class="btn" onclick="loadNotificationsPage(currentPage + 1)" id="notif-next-btn" disabled>NEXT →</button>
            </div>
        </div>

