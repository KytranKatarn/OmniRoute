// ============================================================================
// ENHANCED NOTIFICATION SYSTEM
// Comprehensive notification center with filtering, search, pagination, etc.
// ============================================================================

let currentPage = 1;
let searchTimeout = null;

// Format relative time (e.g., "2 minutes ago")
function formatRelativeTime(dateString) {
    const date = new Date(dateString);
    const now = new Date();
    const seconds = Math.floor((now - date) / 1000);

    if (seconds < 60) return 'just now';
    const minutes = Math.floor(seconds / 60);
    if (minutes < 60) return `${minutes}m ago`;
    const hours = Math.floor(minutes / 60);
    if (hours < 24) return `${hours}h ago`;
    const days = Math.floor(hours / 24);
    if (days < 7) return `${days}d ago`;
    return date.toLocaleDateString();
}

// Render a single notification
function renderNotification(notif) {
    const div = document.createElement('div');
    div.className = `notification-item ${!notif.is_read ? 'unread' : ''}`;
    div.setAttribute('data-priority', notif.priority || 'normal');
    div.setAttribute('data-notif-id', notif.id);

    // Click to mark as read (click-to-dismiss)
    div.addEventListener('click', () => {
        if (!notif.is_read) {
            markRead(notif.id);
        }
    });

    const priorityBadge = notif.priority && notif.priority !== 'normal'
        ? `<span class="notification-priority-badge ${notif.priority}">${notif.priority.toUpperCase()}</span>`
        : '';

    const groupedBadge = notif.grouped_count > 1
        ? `<span class="notification-grouped-count">×${notif.grouped_count}</span>`
        : '';

    div.innerHTML = `
        <div class="notification-header">
            <div style="display: flex; align-items: center;">
                <span style="font-size: 1.2rem; margin-right: 8px;">${notif.source_icon || '📋'}</span>
                ${priorityBadge}
                <span class="notification-type ${notif.type}">${notif.type.toUpperCase()}</span>
                ${groupedBadge}
            </div>
            <span class="notification-time">${formatRelativeTime(notif.created_at)}</span>
        </div>
        <div style="font-size: 1rem; margin-bottom: 5px; font-weight: bold;">${notif.title}</div>
        <div style="font-size: 0.85rem; opacity: 0.9;">${notif.message}</div>
        ${!notif.is_read ? '<div style="margin-top: 10px; font-size: 0.75rem; opacity: 0.6;">Click to mark as read</div>' : ''}
    `;

    return div;
}

// Apply all filters and load notifications
async function applyFilters() {
    currentPage = 1;
    await loadNotificationsPage(1);
}

// Load notifications with current filters and pagination
async function loadNotificationsPage(page) {
    try {
        currentPage = page;

        const filter = document.getElementById('notif-filter').value;
        const type = document.getElementById('notif-type').value;
        const priority = document.getElementById('notif-priority').value;
        const dateRange = document.getElementById('notif-date').value;
        const searchQuery = document.getElementById('notif-search').value;

        const params = new URLSearchParams({
            filter, type, priority, date_range: dateRange, page, per_page: 20
        });

        if (searchQuery) params.append('q', searchQuery);

        const response = await fetch(`/tools/admin/notifications/search?${params}`);
        const data = await response.json();

        if (data.success) {
            const list = document.getElementById('notifications-list');
            list.innerHTML = '';

            if (data.notifications.length === 0) {
                list.innerHTML = '<div style="text-align: center; padding: 40px; opacity: 0.5;">No notifications found</div>';
            } else {
                data.notifications.forEach(notif => {
                    list.appendChild(renderNotification(notif));
                });
            }

            // Update pagination controls
            document.getElementById('notif-page-info').textContent = `Page ${page} of ${data.total_pages}`;
            document.getElementById('notif-prev-btn').disabled = page <= 1;
            document.getElementById('notif-next-btn').disabled = page >= data.total_pages;

            // Update stats
            document.getElementById('notif-stat-total').textContent = data.total;

            // Load count stats
            updateNotificationCounts();
        }
    } catch (error) {
        console.error('Error loading notifications:', error);
        showError('Failed to load notifications');
    }
}

// Debounced search
function debounceSearch(value) {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
        applyFilters();
    }, 500);
}

// Mark notification as read
async function markRead(notifId) {
    try {
        await fetch(`/tools/admin/notifications/mark-read/${notifId}`, {
            method: 'POST'
        });

        await loadNotificationsPage(currentPage);
    } catch (error) {
        console.error('Error marking notification as read:', error);
    }
}

// Mark all as read
async function markAllRead() {
    try {
        await fetch('/tools/admin/notifications/mark-all-read', {
            method: 'POST'
        });

        showSuccess('All notifications marked as read');
        await loadNotificationsPage(currentPage);
    } catch (error) {
        console.error('Error marking all as read:', error);
    }
}

// Update notification counts
async function updateNotificationCounts() {
    try {
        const response = await fetch('/tools/admin/notifications/count');
        const data = await response.json();

        if (data.success) {
            document.getElementById('notif-stat-unread').textContent = data.unread;
            document.getElementById('notif-stat-critical').textContent = data.critical;
            document.getElementById('notif-stat-errors').textContent = data.errors;

            // Update badge in sidebar
            const badge = document.querySelector('[data-section="notifications"] .nav-item-badge');
            if (badge) {
                if (data.unread > 0) {
                    badge.textContent = data.unread;
                    badge.style.display = '';
                } else {
                    badge.style.display = 'none';
                }
            }
        }
    } catch (error) {
        console.error('Error updating counts:', error);
    }
}

// Export notifications
async function exportNotifications(format) {
    try {
        window.location.href = `/tools/admin/notifications/export?format=${format}`;
        showSuccess(`Exporting notifications as ${format.toUpperCase()}...`);
    } catch (error) {
        console.error('Error exporting notifications:', error);
        showError('Failed to export notifications');
    }
}

// Archive old notifications
async function archiveOldNotifications() {
    try {
        const days = prompt('Archive notifications older than how many days?', '30');
        if (!days) return;

        const response = await fetch('/tools/admin/notifications/archive-old', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ days: parseInt(days) })
        });

        const data = await response.json();

        if (data.success) {
            showSuccess(`Archived ${data.archived} old notifications`);
            await applyFilters();
        }
    } catch (error) {
        console.error('Error archiving notifications:', error);
        showError('Failed to archive notifications');
    }
}

// Auto-refresh notification count every 30 seconds
setInterval(updateNotificationCounts, 30000);

// Keyboard shortcuts for notifications
document.addEventListener('keydown', (e) => {
    // Only when notifications section is active
    const notifSection = document.getElementById('section-notifications');
    if (!notifSection || notifSection.style.display === 'none') return;

    // Ctrl/Cmd + R: Refresh
    if ((e.ctrlKey || e.metaKey) && e.key === 'r') {
        e.preventDefault();
        applyFilters();
    }

    // Ctrl/Cmd + A: Mark all as read
    if ((e.ctrlKey || e.metaKey) && e.key === 'a') {
        e.preventDefault();
        markAllRead();
    }

    // Arrow keys for pagination
    if (e.key === 'ArrowLeft' && currentPage > 1) {
        loadNotificationsPage(currentPage - 1);
    }
    if (e.key === 'ArrowRight') {
        const nextBtn = document.getElementById('notif-next-btn');
        if (!nextBtn.disabled) {
            loadNotificationsPage(currentPage + 1);
        }
    }
});

// Analytics Functions
let userGrowthChart = null;
let revenueChart = null;

async function loadAnalytics() {
    try {
        // Load user growth data
        const userResponse = await fetch('/tools/admin/analytics/user-growth');
        const userData = await userResponse.json();
        
        if (userData.success && userData.data.length > 0) {
            const ctx = document.getElementById('userGrowthChart');
            if (ctx) {
                if (userGrowthChart) userGrowthChart.destroy();
                
                userGrowthChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: userData.data.map(d => d.date),
                        datasets: [{
                            label: 'New Users',
                            data: userData.data.map(d => d.count),
                            borderColor: '#00FF00',
                            backgroundColor: 'rgba(0, 255, 0, 0.1)',
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { labels: { color: '#00FF00' } }
                        },
                        scales: {
                            y: { 
                                ticks: { color: '#00FF00' },
                                grid: { color: 'rgba(0, 255, 0, 0.2)' }
                            },
                            x: { 
                                ticks: { color: '#00FF00' },
                                grid: { color: 'rgba(0, 255, 0, 0.2)' }
                            }
                        }
                    }
                });
            }
        }
        
        // Load revenue data
        const revenueResponse = await fetch('/tools/admin/analytics/revenue');
        const revenueData = await revenueResponse.json();
        
        if (revenueData.success && revenueData.data.length > 0) {
            const ctx = document.getElementById('revenueChart');
            if (ctx) {
                if (revenueChart) revenueChart.destroy();
                
                revenueChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: revenueData.data.map(d => d.date),
                        datasets: [{
                            label: 'Revenue ($)',
                            data: revenueData.data.map(d => parseFloat(d.revenue)),
                            backgroundColor: 'rgba(0, 255, 0, 0.3)',
                            borderColor: '#00FF00',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { labels: { color: '#00FF00' } }
                        },
                        scales: {
                            y: { 
                                ticks: { color: '#00FF00' },
                                grid: { color: 'rgba(0, 255, 0, 0.2)' }
                            },
                            x: { 
                                ticks: { color: '#00FF00' },
                                grid: { color: 'rgba(0, 255, 0, 0.2)' }
                            }
                        }
                    }
                });
            }
        }
    } catch (error) {
        console.error('Error loading analytics:', error);
    }
}

