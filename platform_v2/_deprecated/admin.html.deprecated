            <div class="section-subtitle">Centralized system alerts and activity feed with advanced filtering</div>

            <!-- Advanced Filter Bar -->
            <div class="action-bar" style="display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 20px;">
                <!-- Search Box -->
                <input type="text" id="notif-search" placeholder="🔍 Search notifications..."
                    style="flex: 1; min-width: 250px; background: #0a0a0a; border: 1px solid #00FF00; color: #00FF00; padding: 8px 12px; font-family: 'Courier New', monospace;"
                    onkeyup="debounceSearch(this.value)">

                <!-- Read/Unread Filter -->
                <select id="notif-filter" onchange="applyFilters()" style="background: #0a0a0a; border: 1px solid #00FF00; color: #00FF00; padding: 8px; font-family: 'Courier New', monospace;">
                    <option value="all">📋 All Status</option>
                    <option value="unread" selected>🔔 Unread Only</option>
                    <option value="read">✓ Read Only</option>
                </select>

                <!-- Type Filter -->
                <select id="notif-type" onchange="applyFilters()" style="background: #0a0a0a; border: 1px solid #00FF00; color: #00FF00; padding: 8px; font-family: 'Courier New', monospace;">
                    <option value="all">All Types</option>
                    <option value="success">✓ Success</option>
                    <option value="error">✗ Errors</option>
                    <option value="warning">⚠ Warnings</option>
                    <option value="info">ℹ Info</option>
                </select>

                <!-- Priority Filter -->
                <select id="notif-priority" onchange="applyFilters()" style="background: #0a0a0a; border: 1px solid #00FF00; color: #00FF00; padding: 8px; font-family: 'Courier New', monospace;">
                    <option value="all">All Priorities</option>
                    <option value="critical">🔴 Critical</option>
                    <option value="high">🟠 High</option>
                    <option value="normal">🟢 Normal</option>
                    <option value="low">⚪ Low</option>
                </select>

                <!-- Date Range Filter -->
                <select id="notif-date" onchange="applyFilters()" style="background: #0a0a0a; border: 1px solid #00FF00; color: #00FF00; padding: 8px; font-family: 'Courier New', monospace;">
                    <option value="all">All Time</option>
                    <option value="24h" selected>Last 24 Hours</option>
                    <option value="7d">Last 7 Days</option>
                    <option value="30d">Last 30 Days</option>
                </select>
            </div>

            <!-- Action Buttons -->
            <div class="action-bar" style="margin-bottom: 20px;">
                <button class="btn" onclick="markAllRead()">✓ MARK ALL READ</button>
                <button class="btn" onclick="applyFilters()">↻ REFRESH</button>
                <button class="btn" onclick="exportNotifications('csv')">📥 EXPORT CSV</button>
                <button class="btn" onclick="exportNotifications('json')">📥 EXPORT JSON</button>
                <button class="btn" onclick="archiveOldNotifications()">🗄️ ARCHIVE OLD</button>
            </div>

            <!-- Stats Summary -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 15px; margin-bottom: 20px;">
                <div style="background: rgba(0,255,0,0.05); border: 1px solid #00FF00; padding: 15px; text-align: center;">
                    <div style="font-size: 2rem; color: #00FF00;" id="notif-stat-total">0</div>
                    <div style="font-size: 0.8rem; color: #888;">Total</div>
                </div>
                <div style="background: rgba(255,0,0,0.05); border: 1px solid #FF0000; padding: 15px; text-align: center;">
                    <div style="font-size: 2rem; color: #FF0000;" id="notif-stat-unread">0</div>
                    <div style="font-size: 0.8rem; color: #888;">Unread</div>
                </div>
                <div style="background: rgba(255,100,0,0.05); border: 1px solid #FF6400; padding: 15px; text-align: center;">
                    <div style="font-size: 2rem; color: #FF6400;" id="notif-stat-critical">0</div>
                    <div style="font-size: 0.8rem; color: #888;">Critical</div>
                </div>
                <div style="background: rgba(255,0,0,0.05); border: 1px solid #FF0000; padding: 15px; text-align: center;">
                    <div style="font-size: 2rem; color: #FF0000;" id="notif-stat-errors">0</div>
                    <div style="font-size: 0.8rem; color: #888;">Errors</div>
                </div>
            </div>

            <!-- Notifications List -->
