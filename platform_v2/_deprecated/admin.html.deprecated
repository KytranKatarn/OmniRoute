</div>

<style>
@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

/* Admin Notification Styles */
@keyframes slideInDown {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes slideOutUp {
    from {
        opacity: 1;
        transform: translateY(0);
    }
    to {
        opacity: 0;
        transform: translateY(-20px);
    }
}

.admin-notification {
    margin: 8px 0;
    padding: 12px 15px;
    border-radius: 4px;
    border-left: 4px solid;
    background: rgba(0, 0, 0, 0.6);
    font-size: 0.85rem;
    animation: slideInDown 0.3s ease-out;
    position: relative;
    overflow: hidden;
}

.admin-notification.fade-out {
    animation: slideOutUp 0.3s ease-out forwards;
}

.admin-notification.success {
    border-left-color: #00FF00;
    background: linear-gradient(90deg, rgba(0,255,0,0.15) 0%, rgba(0,0,0,0.6) 100%);
}

.admin-notification.error {
    border-left-color: #FF0000;
    background: linear-gradient(90deg, rgba(255,0,0,0.15) 0%, rgba(0,0,0,0.6) 100%);
}

.admin-notification.info {
    border-left-color: #00FFFF;
    background: linear-gradient(90deg, rgba(0,255,255,0.15) 0%, rgba(0,0,0,0.6) 100%);
}

.admin-notification.warning {
    border-left-color: #FF8800;
    background: linear-gradient(90deg, rgba(255,136,0,0.15) 0%, rgba(0,0,0,0.6) 100%);
}

.admin-notification-icon {
    display: inline-block;
    margin-right: 8px;
    font-size: 1rem;
}

.admin-notification-text {
    color: #FFFFFF;
    line-height: 1.4;
}

.admin-notification-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    background: rgba(255, 255, 255, 0.3);
    animation: progressBar 5s linear forwards;
}

@keyframes progressBar {
    from { width: 100%; }
    to { width: 0%; }
}
</style>

        <!-- SECURITY SECTION - Moved to standalone module -->
        <!-- Access at: /tools/security-network/ -->

        <!-- WEBSITE SECTION - Moved to standalone module -->
        <!-- Access at: /tools/website-studio/ -->

        <!-- AGENT DIRECTORY SECTION - Moved to Team Management standalone module -->
