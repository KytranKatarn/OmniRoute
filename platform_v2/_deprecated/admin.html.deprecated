// ===============================================
// AGENT MANAGEMENT FUNCTIONS
// ===============================================

let currentAgentFilter = 'all';
let allAgents = [];

async function loadAgents() {
    const grid = document.getElementById('agentsGrid');

    // Show loading indicator
    grid.innerHTML = `
        <div style="grid-column: 1 / -1; text-align: center; padding: 60px;">
            <div style="display: inline-block; width: 50px; height: 50px; border: 4px solid rgba(0, 255, 0, 0.1); border-radius: 50%; border-top-color: #00FF00; animation: spin 1s linear infinite;"></div>
            <div style="margin-top: 20px; color: #00FF00; font-size: 1.1rem;">Loading agents...</div>
        </div>
    `;

    try {
        const response = await fetch('/tools/admin/agents', {
            credentials: 'same-origin',
            headers: {
                'Accept': 'application/json'
            }
        });

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }

        const data = await response.json();

        if (data.success) {
            allAgents = data.agents;
            displayAgents(allAgents);
            console.log(`✓ Loaded ${data.count} agents successfully`);
        } else {
            console.error('Failed to load agents:', data.error);
            grid.innerHTML = `
                <div style="grid-column: 1 / -1; text-align: center; padding: 40px; border: 2px solid #ff4444; background: rgba(255, 68, 68, 0.05);">
                    <div style="font-size: 2rem; margin-bottom: 10px;">⚠️</div>
                    <div style="color: #ff4444; font-size: 1.1rem; margin-bottom: 10px;">Error loading agents</div>
                    <div style="color: #888; font-size: 0.9rem; margin-bottom: 20px;">${data.error}</div>
                    <button onclick="loadAgents()" class="btn">↻ RETRY</button>
                </div>
            `;
        }
    } catch (error) {
        console.error('Error loading agents:', error);
        grid.innerHTML = `
            <div style="grid-column: 1 / -1; text-align: center; padding: 40px; border: 2px solid #ff4444; background: rgba(255, 68, 68, 0.05);">
                <div style="font-size: 2rem; margin-bottom: 10px;">⚠️</div>
                <div style="color: #ff4444; font-size: 1.1rem; margin-bottom: 10px;">Error loading agents</div>
                <div style="color: #888; font-size: 0.9rem; margin-bottom: 5px;">${error.message}</div>
                <div style="color: #666; font-size: 0.8rem; margin-bottom: 20px;">This usually means authentication failed or the server is unavailable.</div>
                <button onclick="loadAgents()" class="btn">↻ RETRY</button>
            </div>
        `;
    }
}

function filterAgentsByTier(tier) {
    currentAgentFilter = tier;

    let filteredAgents;
    if (tier === 'all') {
        filteredAgents = allAgents;
    } else {
        filteredAgents = allAgents.filter(agent => agent.tier === tier);
    }

    displayAgents(filteredAgents);
}

function displayAgents(agents) {
    const grid = document.getElementById('agentsGrid');

    if (!agents || agents.length === 0) {
        grid.innerHTML = '<div style="text-align: center; padding: 40px; opacity: 0.5; grid-column: 1 / -1;">No agents found for this filter</div>';
        return;
    }

    // Use DocumentFragment for better performance (single reflow)
    const fragment = document.createDocumentFragment();
    const startTime = performance.now();

    agents.forEach(agent => {
        const card = document.createElement('div');
        card.className = 'agent-card';
        card.style.cssText = 'background: #1a1a1a; border: 2px solid #00FF00; padding: 20px; border-radius: 5px; cursor: pointer; transition: all 0.2s ease;';
        card.onmouseover = function() { this.style.borderColor = '#00FF88'; this.style.boxShadow = '0 0 15px rgba(0, 255, 0, 0.3)'; };
        card.onmouseout = function() { this.style.borderColor = '#00FF00'; this.style.boxShadow = 'none'; };

        const tierStars = '⭐'.repeat(agent.tier || 1);
        const statusColor = agent.status === 'active' ? '#00FF00' : '#888';
        const statusText = agent.status === 'active' ? 'ACTIVE' : (agent.status || 'UNKNOWN').toUpperCase();

        // Escape special characters in agent name for onclick handler
        const safeAgentName = (agent.name || 'Unknown').replace(/'/g, "\\'");

        card.innerHTML = `
            <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 15px;">
                <div>
                    <div style="font-size: 1.8rem; margin-bottom: 5px;">${agent.type_icon || '🤖'}</div>
                    <div style="font-size: 1.1rem; font-weight: bold; color: #FFFFFF; margin-bottom: 5px;">${agent.name || 'Unnamed Agent'}</div>
                    <div style="font-size: 0.85rem; color: #888;">${agent.type_name || 'Unknown Type'}</div>
                </div>
                <div style="text-align: right;">
                    <div style="font-size: 1rem; margin-bottom: 5px;">${tierStars}</div>
                    <div style="font-size: 0.75rem; color: ${statusColor}; font-weight: bold;">${statusText}</div>
                </div>
            </div>

            <div style="margin: 15px 0; padding: 10px; background: rgba(0, 255, 0, 0.05); border-left: 3px solid #00FF00; font-size: 0.85rem; color: #ccc; line-height: 1.4;">
                ${agent.system_prompt ? agent.system_prompt.substring(0, 150) + '...' : 'No description available'}
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 15px 0;">
                <div style="text-align: center; padding: 8px; background: rgba(0,0,0,0.3); border-radius: 3px;">
                    <div style="font-size: 1.2rem; color: #00FF00; font-weight: bold;">${agent.total_executions || 0}</div>
                    <div style="font-size: 0.7rem; color: #888;">EXECUTIONS</div>
                </div>
                <div style="text-align: center; padding: 8px; background: rgba(0,0,0,0.3); border-radius: 3px;">
                    <div style="font-size: 1.2rem; color: ${agent.failed_executions > 0 ? '#ff4444' : '#00FF00'}; font-weight: bold;">${agent.failed_executions || 0}</div>
                    <div style="font-size: 0.7rem; color: #888;">FAILED</div>
                </div>
            </div>

            <div style="margin-top: 10px; padding: 8px; background: rgba(0,0,0,0.2); border-radius: 3px;">
                <div style="font-size: 0.75rem; color: #888; margin-bottom: 5px;">MODEL: <span style="color: #00FF00;">${agent.model || 'N/A'}</span></div>
                <div style="font-size: 0.75rem; color: #888;">AVG DURATION: <span style="color: #00FF00;">${agent.avg_duration && typeof agent.avg_duration === 'number' ? agent.avg_duration.toFixed(1) + 's' : 'N/A'}</span></div>
            </div>

            <div style="margin-top: 15px; display: flex; gap: 10px;">
                <button onclick="event.stopPropagation(); viewAgentDetails(${agent.id})" class="btn btn-small" style="flex: 1;">📊 DETAILS</button>
                <button onclick="event.stopPropagation(); openExecuteModal(${agent.id}, '${safeAgentName}')" class="btn btn-small" style="flex: 1; background: #00FF00; color: black;">▶ EXECUTE</button>
            </div>
        `;

        card.onclick = function() { viewAgentDetails(agent.id); };
        fragment.appendChild(card);
    });

    // Single DOM update for better performance
    grid.innerHTML = '';
    grid.appendChild(fragment);

    const renderTime = (performance.now() - startTime).toFixed(1);
    console.log(`✓ Rendered ${agents.length} agents in ${renderTime}ms`);
}

async function viewAgentDetails(agentId) {
    try {
        const response = await fetch(`/tools/admin/agents/${agentId}`, {
            credentials: 'same-origin',
            headers: {
                'Accept': 'application/json'
            }
        });

        if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }

        const data = await response.json();

        if (data.success) {
            const agent = data.agent;
            const tools = data.tools || [];
            const executions = data.recent_executions || [];

            const modal = document.getElementById('agentDetailModal');
            const content = document.getElementById('agentDetailContent');

            const tierStars = '⭐'.repeat(agent.tier);
            const statusColor = agent.status === 'active' ? '#00FF00' : '#888';

            let toolsHTML = '<div style="color: #888; text-align: center; padding: 20px;">No tools configured</div>';
            if (tools.length > 0) {
                toolsHTML = tools.map(tool => `
                    <div style="padding: 10px; background: rgba(0,0,0,0.3); margin-bottom: 8px; border-left: 3px solid ${tool.enabled ? '#00FF00' : '#888'};">
                        <div style="font-weight: bold; color: ${tool.enabled ? '#00FF00' : '#888'};">${tool.tool_name} ${tool.enabled ? '✓' : '✗'}</div>
                        <div style="font-size: 0.75rem; color: #888;">Used ${tool.usage_count || 0} times</div>
                    </div>
                `).join('');
            }

            let executionsHTML = '<div style="color: #888; text-align: center; padding: 20px;">No executions yet</div>';
            if (executions.length > 0) {
                executionsHTML = executions.map(exec => `
                    <div style="padding: 10px; background: rgba(0,0,0,0.3); margin-bottom: 8px; border-left: 3px solid ${exec.status === 'completed' ? '#00FF00' : '#ff4444'};">
                        <div style="font-size: 0.85rem; margin-bottom: 5px;">${exec.task_description || 'No description'}</div>
                        <div style="font-size: 0.75rem; color: #888;">
                            Status: <span style="color: ${exec.status === 'completed' ? '#00FF00' : '#ff4444'};">${exec.status.toUpperCase()}</span> |
                            Duration: ${exec.duration_seconds && typeof exec.duration_seconds === 'number' ? exec.duration_seconds.toFixed(1) + 's' : 'N/A'} |
                            ${new Date(exec.started_at).toLocaleString()}
                        </div>
                    </div>
                `).join('');
            }

            content.innerHTML = `
                <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 20px;">
                    <div style="font-size: 3rem;">${agent.type_icon || '🤖'}</div>
                    <div style="flex: 1;">
                        <h2 style="color: #00FF00; margin: 0 0 5px 0;">${agent.name}</h2>
                        <div style="color: #888; margin-bottom: 5px;">${agent.type_name || 'Unknown Type'}</div>
                        <div style="font-size: 1rem;">
                            ${tierStars} <span style="color: ${statusColor}; font-weight: bold; margin-left: 10px;">${agent.status.toUpperCase()}</span>
                        </div>
                    </div>
                </div>

                <div style="background: rgba(0, 255, 0, 0.05); border-left: 3px solid #00FF00; padding: 15px; margin-bottom: 20px;">
                    <div style="font-weight: bold; color: #00FF00; margin-bottom: 5px;">SYSTEM PROMPT</div>
                    <div style="color: #ccc; font-size: 0.9rem;">${agent.system_prompt || 'No system prompt configured'}</div>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 15px; margin-bottom: 20px;">
                    <div style="text-align: center; padding: 15px; background: rgba(0,0,0,0.3);">
                        <div style="font-size: 0.7rem; color: #888; margin-bottom: 5px;">MODEL</div>
                        <div style="color: #00FF00; font-weight: bold;">${agent.model}</div>
                    </div>
                    <div style="text-align: center; padding: 15px; background: rgba(0,0,0,0.3);">
                        <div style="font-size: 0.7rem; color: #888; margin-bottom: 5px;">TEMPERATURE</div>
                        <div style="color: #00FF00; font-weight: bold;">${agent.temperature}</div>
                    </div>
                    <div style="text-align: center; padding: 15px; background: rgba(0,0,0,0.3);">
                        <div style="font-size: 0.7rem; color: #888; margin-bottom: 5px;">MAX TOKENS</div>
                        <div style="color: #00FF00; font-weight: bold;">${agent.max_tokens}</div>
                    </div>
                </div>

                <div style="margin-bottom: 20px;">
                    <h3 style="color: #00FF00; margin-bottom: 10px;">🛠️ AVAILABLE TOOLS</h3>
                    ${toolsHTML}
                </div>

                <div>
                    <h3 style="color: #00FF00; margin-bottom: 10px;">📊 RECENT EXECUTIONS</h3>
                    ${executionsHTML}
                </div>
            `;

            modal.style.display = 'block';
        }
    } catch (error) {
        console.error('Error loading agent details:', error);
        alert('Error loading agent details');
    }
}

function closeAgentDetail() {
    document.getElementById('agentDetailModal').style.display = 'none';
}

let currentExecutingAgentId = null;

function openExecuteModal(agentId, agentName) {
    currentExecutingAgentId = agentId;
    document.getElementById('executeAgentName').textContent = agentName;
    document.getElementById('agentTaskInput').value = '';
    document.getElementById('executionProgress').style.display = 'none';
    document.getElementById('executionResult').style.display = 'none';
    document.getElementById('executeAgentModal').style.display = 'block';
}

function closeExecuteModal() {
    document.getElementById('executeAgentModal').style.display = 'none';
    currentExecutingAgentId = null;
}

async function executeAgentTask() {
    const task = document.getElementById('agentTaskInput').value.trim();

    if (!task) {
        alert('Please enter a task description');
        return;
    }

    if (!currentExecutingAgentId) {
        alert('No agent selected');
        return;
    }

    const progressDiv = document.getElementById('executionProgress');
    const resultDiv = document.getElementById('executionResult');
    const statusDiv = document.getElementById('executionStatus');
    const resultContent = document.getElementById('resultContent');

    progressDiv.style.display = 'block';
    resultDiv.style.display = 'none';
    statusDiv.textContent = 'Sending task to agent...';

    try {
        const response = await fetch(`/tools/admin/agents/${currentExecutingAgentId}/execute`, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({ task: task })
        });

        const data = await response.json();

        progressDiv.style.display = 'none';
        resultDiv.style.display = 'block';

        if (data.success) {
            resultContent.style.background = 'rgba(0, 255, 0, 0.05)';
            resultContent.style.borderLeft = '3px solid #00FF00';
            resultContent.innerHTML = `
                <div style="color: #00FF00; font-weight: bold; margin-bottom: 10px;">✓ TASK COMPLETED</div>
                <div style="color: #ccc; white-space: pre-wrap;">${data.result || 'Task executed successfully'}</div>
                ${data.execution_id ? `<div style="color: #888; font-size: 0.75rem; margin-top: 10px;">Execution ID: ${data.execution_id}</div>` : ''}
            `;
        } else {
            resultContent.style.background = 'rgba(255, 68, 68, 0.05)';
            resultContent.style.borderLeft = '3px solid #ff4444';
            resultContent.innerHTML = `
                <div style="color: #ff4444; font-weight: bold; margin-bottom: 10px;">✗ TASK FAILED</div>
                <div style="color: #ccc;">${data.error || 'Unknown error occurred'}</div>
            `;
        }
    } catch (error) {
        progressDiv.style.display = 'none';
        resultDiv.style.display = 'block';
        resultContent.style.background = 'rgba(255, 68, 68, 0.05)';
        resultContent.style.borderLeft = '3px solid #ff4444';
        resultContent.innerHTML = `
            <div style="color: #ff4444; font-weight: bold; margin-bottom: 10px;">✗ ERROR</div>
            <div style="color: #ccc;">${error.message}</div>
        `;
    }
}


// ===============================================
// CALL HANDLING FUNCTIONS
// ===============================================

let currentCallTab = 'overview';
let callHandlingData = {
    providers: [],
    conversations: [],
    escalations: [],
    stats: {}
};

async function loadCallHandlingData() {
    try {
        // Load stats
        const statsResponse = await fetch('/tools/admin/call-handling/stats');
        const statsData = await statsResponse.json();

        if (statsData.success) {
            callHandlingData.stats = statsData;
            updateCallStats(statsData);
        }

        // Load providers
        const providersResponse = await fetch('/tools/admin/call-handling/providers');
        const providersData = await providersResponse.json();

        if (providersData.success) {
            callHandlingData.providers = providersData.providers;
            displayProviderStatus(providersData.providers);
        }

        // Load recent conversations
        const convsResponse = await fetch('/tools/admin/call-handling/conversations?limit=10');
        const convsData = await convsResponse.json();

        if (convsData.success) {
            callHandlingData.conversations = convsData.conversations;
            displayRecentActivity(convsData.conversations);
        }

    } catch (error) {
        console.error('Error loading call handling data:', error);
    }
}

function updateCallStats(statsData) {
    const overall = statsData.overall || {};
    const today = statsData.today || {};

    document.getElementById('stat-active-calls').textContent = overall.active_calls || 0;
    document.getElementById('stat-calls-today').textContent = today.calls_today || 0;

    const resolutionRate = overall.total_calls > 0
        ? Math.round((overall.resolved_calls / overall.total_calls) * 100)
        : 0;
    document.getElementById('stat-resolution-rate').textContent = resolutionRate + '%';

    const avgSat = overall.avg_satisfaction || 0;
    document.getElementById('stat-avg-satisfaction').textContent = avgSat.toFixed(1);

    // Display agent performance
    if (statsData.by_agent && statsData.by_agent.length > 0) {
        displayAgentPerformance(statsData.by_agent);
    }
}

function displayProviderStatus(providers) {
    const grid = document.getElementById('provider-status-grid');
    grid.innerHTML = '';

    providers.forEach(provider => {
        const statusColor = provider.status === 'active' ? '#00FF00' : '#888';
        const card = document.createElement('div');
        card.style.cssText = 'background: rgba(0,0,0,0.3); border: 1px solid #00FF00; border-left: 4px solid ' + statusColor + '; padding: 15px;';

        card.innerHTML = `
            <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                <div style="font-weight: bold; color: #FFFFFF;">${provider.name}</div>
                <div style="color: ${statusColor}; font-size: 0.85rem;">${provider.status.toUpperCase()}</div>
            </div>
            <div style="font-size: 0.85rem; color: #888; margin-bottom: 8px;">
                Type: <span style="color: #00FF00;">${provider.type}</span>
            </div>
            <div style="font-size: 0.85rem; color: #888;">
                Quality: <span style="color: #00FF00;">${provider.quality_score}/10</span> |
                Cost: <span style="color: #00FF00;">$${provider.cost_per_minute.toFixed(4)}/min</span>
            </div>
        `;

        grid.appendChild(card);
    });
}

function displayAgentPerformance(agentStats) {
    const grid = document.getElementById('agent-performance-grid');
    grid.innerHTML = '';

    agentStats.forEach(agent => {
        const resolutionRate = agent.calls > 0
            ? Math.round((agent.resolved / agent.calls) * 100)
            : 0;

        const card = document.createElement('div');
        card.style.cssText = 'background: rgba(0,0,0,0.3); border: 1px solid #00FF00; padding: 12px; margin-bottom: 8px;';

        card.innerHTML = `
            <div style="display: flex; justify-content: space-between;">
                <div style="font-weight: bold; color: #FFFFFF;">${agent.agent_type.toUpperCase()}</div>
                <div style="color: #00FF00;">${agent.calls} calls</div>
            </div>
            <div style="font-size: 0.85rem; color: #888; margin-top: 5px;">
                Resolution: <span style="color: #00FF00;">${resolutionRate}%</span> |
                Satisfaction: <span style="color: #00FF00;">${(agent.avg_satisfaction || 0).toFixed(1)}/5.0</span>
            </div>
        `;

        grid.appendChild(card);
    });
}

function displayRecentActivity(conversations) {
    const list = document.getElementById('recent-activity-list');
    list.innerHTML = '';

    if (conversations.length === 0) {
        list.innerHTML = '<div style="text-align: center; padding: 40px; opacity: 0.5;">No recent call activity</div>';
        return;
    }

    conversations.slice(0, 5).forEach(conv => {
        const statusColor = conv.status === 'completed' ? '#00FF00' : conv.status === 'active' ? '#ffaa00' : '#ff4444';

        const item = document.createElement('div');
        item.style.cssText = 'background: rgba(0,0,0,0.3); border-left: 3px solid ' + statusColor + '; padding: 12px; margin-bottom: 8px; cursor: pointer;';
        item.onclick = () => viewConversationDetail(conv.id);

        const startTime = new Date(conv.start_time).toLocaleString();
        const duration = conv.duration_seconds ? Math.floor(conv.duration_seconds / 60) + 'm ' + (conv.duration_seconds % 60) + 's' : 'Ongoing';

        item.innerHTML = `
            <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
                <div style="font-weight: bold; color: #FFFFFF;">${conv.customer_name || conv.phone_number || 'Unknown'}</div>
                <div style="color: ${statusColor}; font-size: 0.85rem;">${conv.status.toUpperCase()}</div>
            </div>
            <div style="font-size: 0.85rem; color: #888;">
                ${conv.intent ? conv.intent.toUpperCase() : 'GENERAL'} | ${conv.provider_name} | ${duration}
            </div>
            <div style="font-size: 0.75rem; color: #666; margin-top: 5px;">
                ${startTime}
            </div>
        `;

        list.appendChild(item);
    });
}

function switchCallTab(tabName) {
    currentCallTab = tabName;

    // Hide all tabs
    document.querySelectorAll('.call-tab').forEach(tab => tab.style.display = 'none');

    // Show selected tab
    const selectedTab = document.getElementById('call-tab-' + tabName);
    if (selectedTab) {
        selectedTab.style.display = 'block';
    }

    // Update button styles
    ['overview', 'conversations', 'providers', 'escalations'].forEach(tab => {
        const btn = document.getElementById('tab-' + tab);
        if (btn) {
            if (tab === tabName) {
                btn.style.background = '#00FF00';
                btn.style.color = '#000';
            } else {
                btn.style.background = '';
                btn.style.color = '';
            }
        }
    });

    // Load tab-specific data
    if (tabName === 'conversations') {
        filterConversations('all');
    } else if (tabName === 'providers') {
        displayProvidersList();
    } else if (tabName === 'escalations') {
        filterEscalations('pending');
    }
}

async function filterConversations(status) {
    try {
        const url = status === 'all'
            ? '/tools/admin/call-handling/conversations'
            : `/tools/admin/call-handling/conversations?status=${status}`;

        const response = await fetch(url);
        const data = await response.json();

        if (data.success) {
            displayConversations(data.conversations);
        }
    } catch (error) {
        console.error('Error loading conversations:', error);
    }
}

function displayConversations(conversations) {
    const list = document.getElementById('conversations-list');
    list.innerHTML = '';

    if (conversations.length === 0) {
        list.innerHTML = '<div style="text-align: center; padding: 40px; opacity: 0.5;">No conversations found</div>';
        return;
    }

    conversations.forEach(conv => {
        const statusColor = conv.status === 'completed' ? '#00FF00' :
                           conv.status === 'active' ? '#ffaa00' : '#ff4444';

        const card = document.createElement('div');
        card.style.cssText = 'background: rgba(0,0,0,0.3); border: 1px solid #00FF00; border-left: 4px solid ' + statusColor + '; padding: 15px; cursor: pointer; transition: all 0.2s;';
        card.onmouseover = () => card.style.borderColor = '#00FF00';
        card.onmouseout = () => card.style.borderColor = '#00FF00';
        card.onclick = () => viewConversationDetail(conv.id);

        const startTime = new Date(conv.start_time).toLocaleString();
        const duration = conv.duration_seconds ? Math.floor(conv.duration_seconds / 60) + 'm ' + (conv.duration_seconds % 60) + 's' : 'Ongoing';

        card.innerHTML = `
            <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                <div>
                    <div style="font-weight: bold; color: #FFFFFF; font-size: 1.1rem;">${conv.customer_name || conv.phone_number || 'Unknown'}</div>
                    <div style="font-size: 0.85rem; color: #888; margin-top: 3px;">${conv.call_sid}</div>
                </div>
                <div style="text-align: right;">
                    <div style="color: ${statusColor}; font-weight: bold;">${conv.status.toUpperCase()}</div>
                    <div style="font-size: 0.85rem; color: #888; margin-top: 3px;">${conv.direction.toUpperCase()}</div>
                </div>
            </div>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 10px; font-size: 0.85rem; color: #888;">
                <div>
                    Intent: <span style="color: #00FF00;">${conv.intent || 'N/A'}</span>
                </div>
                <div>
                    Agent: <span style="color: #00FF00;">${conv.agent_name || conv.agent_type || 'N/A'}</span>
                </div>
                <div>
                    Duration: <span style="color: #00FF00;">${duration}</span>
                </div>
            </div>
            <div style="font-size: 0.75rem; color: #666; margin-top: 10px; border-top: 1px solid #333; padding-top: 8px;">
                Started: ${startTime} | Provider: ${conv.provider_name} ${conv.cost ? '| Cost: $' + conv.cost.toFixed(4) : ''}
            </div>
        `;

        list.appendChild(card);
    });
}

function displayProvidersList() {
    const list = document.getElementById('providers-list');
    list.innerHTML = '';

    if (callHandlingData.providers.length === 0) {
        list.innerHTML = '<div style="text-align: center; padding: 40px; opacity: 0.5;">No providers configured</div>';
        return;
    }

    callHandlingData.providers.forEach(provider => {
        const statusColor = provider.status === 'active' ? '#00FF00' : '#888';

        const card = document.createElement('div');
        card.style.cssText = 'background: rgba(0,0,0,0.3); border: 1px solid #00FF00; border-left: 4px solid ' + statusColor + '; padding: 20px; margin-bottom: 15px;';

        const capabilities = Object.entries(provider.capabilities || {})
            .filter(([key, val]) => val)
            .map(([key]) => key.replace(/_/g, ' ').toUpperCase())
            .join(', ');

        card.innerHTML = `
            <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
                <div>
                    <div style="font-size: 1.3rem; font-weight: bold; color: #FFFFFF;">${provider.name}</div>
                    <div style="font-size: 0.9rem; color: #888; margin-top: 5px;">Type: <span style="color: #00FF00;">${provider.type}</span></div>
                </div>
                <div style="text-align: right;">
                    <div style="color: ${statusColor}; font-weight: bold; font-size: 1rem;">${provider.status.toUpperCase()}</div>
                    <div style="font-size: 0.85rem; color: #888; margin-top: 5px;">Quality: <span style="color: #00FF00;">${provider.quality_score}/10</span></div>
                </div>
            </div>
            <div style="margin-bottom: 10px;">
                <div style="font-size: 0.85rem; color: #888; margin-bottom: 5px;">CAPABILITIES:</div>
                <div style="font-size: 0.9rem; color: #00FF00;">${capabilities || 'None configured'}</div>
            </div>
            <div style="border-top: 1px solid #333; padding-top: 10px; margin-top: 10px; font-size: 0.85rem; color: #888;">
                Cost Per Minute: <span style="color: #00FF00; font-weight: bold;">$${provider.cost_per_minute.toFixed(4)}</span>
            </div>
        `;

        list.appendChild(card);
    });
}

async function filterEscalations(status) {
    try {
        const url = `/tools/admin/call-handling/escalations?status=${status}`;
        const response = await fetch(url);
        const data = await response.json();

        if (data.success) {
            displayEscalations(data.escalations);
        }
    } catch (error) {
        console.error('Error loading escalations:', error);
    }
}

function displayEscalations(escalations) {
    const list = document.getElementById('escalations-list');
    list.innerHTML = '';

    if (escalations.length === 0) {
        list.innerHTML = '<div style="text-align: center; padding: 40px; opacity: 0.5;">No escalations found</div>';
        return;
    }

    escalations.forEach(esc => {
        const isPending = !esc.resolved_at;
        const statusColor = isPending ? '#ffaa00' : '#00FF00';

        const card = document.createElement('div');
        card.style.cssText = 'background: rgba(0,0,0,0.3); border: 1px solid #00FF00; border-left: 4px solid ' + statusColor + '; padding: 15px; margin-bottom: 10px;';

        const escalatedTime = new Date(esc.escalated_at).toLocaleString();

        card.innerHTML = `
            <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                <div>
                    <div style="font-weight: bold; color: #FFFFFF; font-size: 1.1rem;">${esc.customer_name || 'Unknown Customer'}</div>
                    <div style="font-size: 0.85rem; color: #888; margin-top: 3px;">${esc.phone_number || ''}</div>
                </div>
                <div style="text-align: right;">
                    <div style="color: ${statusColor}; font-weight: bold;">${isPending ? 'PENDING' : 'RESOLVED'}</div>
                    <div style="font-size: 0.85rem; color: #888; margin-top: 3px;">${esc.trigger_type || 'Manual'}</div>
                </div>
            </div>
            <div style="background: rgba(0,0,0,0.2); padding: 10px; margin: 10px 0; border-left: 3px solid #ffaa00;">
                <div style="font-weight: bold; color: #ffaa00; margin-bottom: 5px;">REASON:</div>
                <div style="color: #FFFFFF;">${esc.escalation_reason}</div>
            </div>
            <div style="font-size: 0.85rem; color: #888;">
                Escalated: ${escalatedTime} ${esc.assigned_to ? '| Assigned to: <span style="color: #00FF00;">' + esc.assigned_to + '</span>' : ''}
            </div>
            ${esc.resolution_notes ? '<div style="margin-top: 10px; padding-top: 10px; border-top: 1px solid #333; font-size: 0.85rem; color: #888;">Resolution: <span style="color: #00FF00;">' + esc.resolution_notes + '</span></div>' : ''}
        `;

        list.appendChild(card);
    });
}

async function viewConversationDetail(conversationId) {
    try {
        const response = await fetch(`/tools/admin/call-handling/conversations/${conversationId}`);
        const data = await response.json();

        if (!data.success) {
            alert('Error loading conversation details');
            return;
        }

        const conv = data.conversation;
        const turns = data.turns || [];

        const modal = document.getElementById('conversationDetailModal');
        const content = document.getElementById('conversationDetailContent');

        const startTime = new Date(conv.start_time).toLocaleString();
        const endTime = conv.end_time ? new Date(conv.end_time).toLocaleString() : 'Ongoing';
        const duration = conv.duration_seconds ? Math.floor(conv.duration_seconds / 60) + 'm ' + (conv.duration_seconds % 60) + 's' : 'Ongoing';

        const statusColor = conv.status === 'completed' ? '#00FF00' :
                           conv.status === 'active' ? '#ffaa00' : '#ff4444';

        let turnsHTML = '';
        turns.forEach(turn => {
            const roleColor = turn.role === 'customer' ? '#00AAFF' : turn.role === 'ai' ? '#00FF00' : '#888';
            const roleIcon = turn.role === 'customer' ? '👤' : turn.role === 'ai' ? '🤖' : 'ℹ️';

            turnsHTML += `
                <div style="background: rgba(0,0,0,0.2); padding: 12px; margin-bottom: 10px; border-left: 3px solid ${roleColor};">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <div style="color: ${roleColor}; font-weight: bold;">${roleIcon} ${turn.role.toUpperCase()}</div>
                        <div style="font-size: 0.75rem; color: #888;">${new Date(turn.timestamp).toLocaleTimeString()} ${turn.confidence_score ? '| Confidence: ' + (turn.confidence_score * 100).toFixed(0) + '%' : ''}</div>
                    </div>
                    <div style="color: #FFFFFF; line-height: 1.5;">${turn.content}</div>
                    ${turn.sentiment ? '<div style="margin-top: 5px; font-size: 0.75rem; color: #888;">Sentiment: <span style="color: #00FF00;">' + turn.sentiment + '</span></div>' : ''}
                </div>
            `;
        });

        content.innerHTML = `
            <h2 style="color: #00FF00; margin-bottom: 20px;">📞 Conversation Details</h2>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px;">
                <div>
                    <div style="font-size: 0.85rem; color: #888; margin-bottom: 5px;">CUSTOMER</div>
                    <div style="font-size: 1.2rem; font-weight: bold; color: #FFFFFF;">${conv.customer_name || 'Unknown'}</div>
                    <div style="font-size: 0.9rem; color: #888;">${conv.phone_number || 'No phone'}</div>
                </div>
                <div style="text-align: right;">
                    <div style="font-size: 0.85rem; color: #888; margin-bottom: 5px;">STATUS</div>
                    <div style="font-size: 1.2rem; font-weight: bold; color: ${statusColor};">${conv.status.toUpperCase()}</div>
                    <div style="font-size: 0.9rem; color: #888;">${conv.outcome || 'Pending'}</div>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-bottom: 30px;">
                <div style="background: rgba(0,0,0,0.3); padding: 12px; border: 1px solid #333;">
                    <div style="font-size: 0.75rem; color: #888;">DURATION</div>
                    <div style="font-size: 1.1rem; color: #00FF00; font-weight: bold;">${duration}</div>
                </div>
                <div style="background: rgba(0,0,0,0.3); padding: 12px; border: 1px solid #333;">
                    <div style="font-size: 0.75rem; color: #888;">AGENT</div>
                    <div style="font-size: 1.1rem; color: #00FF00; font-weight: bold;">${conv.agent_name || conv.agent_type || 'N/A'}</div>
                </div>
                <div style="background: rgba(0,0,0,0.3); padding: 12px; border: 1px solid #333;">
                    <div style="font-size: 0.75rem; color: #888;">PROVIDER</div>
                    <div style="font-size: 1.1rem; color: #00FF00; font-weight: bold;">${conv.provider_name}</div>
                </div>
            </div>

            <div style="margin-bottom: 20px; padding: 12px; background: rgba(0,0,0,0.2); border: 1px solid #333;">
                <div style="font-size: 0.85rem; color: #888;">
                    Started: <span style="color: #00FF00;">${startTime}</span> |
                    Ended: <span style="color: #00FF00;">${endTime}</span> |
                    Intent: <span style="color: #00FF00;">${conv.intent || 'N/A'}</span>
                    ${conv.customer_satisfaction ? '| Satisfaction: <span style="color: #00FF00;">' + conv.customer_satisfaction + '/5.0</span>' : ''}
                </div>
            </div>

            <h3 style="color: #00FF00; margin-bottom: 15px;">💬 Conversation Transcript (${turns.length} turns)</h3>
            <div style="max-height: 500px; overflow-y: auto;">
                ${turnsHTML || '<div style="text-align: center; padding: 40px; opacity: 0.5;">No transcript available</div>'}
            </div>
        `;

        modal.style.display = 'block';

    } catch (error) {
        console.error('Error viewing conversation detail:', error);
        alert('Error loading conversation details');
    }
}

function closeConversationDetail() {
    document.getElementById('conversationDetailModal').style.display = 'none';
}

function refreshCallData() {
    loadCallHandlingData();
}

// =============================================================================
// AGENT DIRECTORY FUNCTIONS
// =============================================================================

let allDirectoryAgents = [];
let currentDepartmentFilter = 'all';

async function loadAgentDirectory() {
    try {
        const response = await fetch('/tools/admin/agent-directory');
        const data = await response.json();

        if (data.success) {
            allDirectoryAgents = data.agents;
            displayDirectoryStats(data.statistics);
            displayDepartmentFilters(data.by_department);
            displayAgentDirectory(allDirectoryAgents);
        } else {
            console.error('Failed to load agent directory:', data.error);
            document.getElementById('agentDirectoryGrid').innerHTML =
                '<div style="text-align: center; padding: 40px; color: #ff4444;">Error loading agent directory: ' + data.error + '</div>';
        }
    } catch (error) {
        console.error('Error loading agent directory:', error);
        document.getElementById('agentDirectoryGrid').innerHTML =
            '<div style="text-align: center; padding: 40px; color: #ff4444;">Error loading agent directory. Please try again.</div>';
    }
}

function displayDirectoryStats(stats) {
    const statsDiv = document.getElementById('directoryStats');
    statsDiv.innerHTML = `
        <div style="background: #1a1a1a; border: 2px solid #00FF00; padding: 20px; text-align: center;">
            <div style="font-size: 2rem; color: #00FF00; font-weight: bold;">${stats.total_active_agents || stats.total_agents || 0}</div>
            <div style="font-size: 0.85rem; color: #888; margin-top: 5px;">TOTAL AGENTS</div>
        </div>
        <div style="background: #1a1a1a; border: 2px solid #00FF00; padding: 20px; text-align: center;">
            <div style="font-size: 2rem; color: #00FF00; font-weight: bold;">${stats.total_departments || 0}</div>
            <div style="font-size: 0.85rem; color: #888; margin-top: 5px;">DEPARTMENTS</div>
        </div>
        <div style="background: #1a1a1a; border: 2px solid #00FF00; padding: 20px; text-align: center;">
            <div style="font-size: 2rem; color: #00FF00; font-weight: bold;">$${parseFloat(stats.total_monthly_budget || stats.total_budget || 0).toFixed(2)}</div>
            <div style="font-size: 0.85rem; color: #888; margin-top: 5px;">MONTHLY BUDGET</div>
        </div>
        <div style="background: #1a1a1a; border: 2px solid #00FF00; padding: 20px; text-align: center;">
            <div style="font-size: 2rem; color: #00FF00; font-weight: bold;">$${parseFloat(stats.total_cost_to_date || 0).toFixed(2)}</div>
            <div style="font-size: 0.85rem; color: #888; margin-top: 5px;">TOTAL COST</div>
        </div>
    `;
}

function displayDepartmentFilters(byDepartment) {
    const filterDiv = document.getElementById('departmentFilter');
    const departments = Object.keys(byDepartment).sort();

    let html = '<div style="display: flex; flex-wrap: wrap; gap: 10px;">';
    html += '<button class="btn" onclick="filterByDepartment(\'all\')" style="background: #00FF00; color: black;">📊 ALL</button>';

    departments.forEach(dept => {
        const count = byDepartment[dept].length;
        html += `<button class="btn" onclick="filterByDepartment('${dept}')">${dept} (${count})</button>`;
    });

    html += '</div>';
    filterDiv.innerHTML = html;
}

function filterByDepartment(department) {
    currentDepartmentFilter = department;

    let filteredAgents;
    if (department === 'all') {
        filteredAgents = allDirectoryAgents;
    } else {
        filteredAgents = allDirectoryAgents.filter(agent => agent.department === department);
    }

    displayAgentDirectory(filteredAgents);
}

function displayAgentDirectory(agents) {
    const grid = document.getElementById('agentDirectoryGrid');

    if (!agents || agents.length === 0) {
        grid.innerHTML = '<div style="text-align: center; padding: 40px; opacity: 0.5; grid-column: 1 / -1;">No agents found</div>';
        return;
    }

    grid.innerHTML = '';

    agents.forEach(agent => {
        const card = document.createElement('div');

        // Determine worker type styling
        const isContractor = agent.worker_type === 'contract';
        const borderColor = isContractor ? '#FF4444' : '#00FF00';
        const badgeColor = isContractor ? 'rgba(255,68,68,0.2)' : 'rgba(0,255,0,0.2)';
        const badgeText = isContractor ? '⚠️ CONTRACTOR (PAID)' : '✓ INTERNAL STAFF (FREE)';

        card.style.cssText = `background: #1a1a1a; border: 2px solid ${borderColor}; padding: 20px; border-radius: 5px; transition: all 0.2s ease; cursor: pointer;`;
        card.onmouseover = function() { this.style.boxShadow = `0 0 15px rgba(${isContractor ? '255,68,68' : '0,255,0'}, 0.3)`; this.style.borderColor = isContractor ? '#FF6666' : '#00FF88'; };
        card.onmouseout = function() { this.style.boxShadow = 'none'; this.style.borderColor = borderColor; };
        card.onclick = function() { viewDirectoryAgentDetails(agent.id); };

        const fullName = `${agent.first_name || ''} ${agent.last_name || ''}`.trim() || agent.name || 'Unnamed Agent';
        const tierStars = '⭐'.repeat(agent.tier || 1);
        const budget = agent.monthly_budget ? `$${parseFloat(agent.monthly_budget).toFixed(2)}/mo` : 'N/A';
        const costDisplay = agent.total_cost ? `$${parseFloat(agent.total_cost).toFixed(2)}` : '$0.00';

        let capabilitiesHTML = '';
        if (agent.capabilities && agent.capabilities.specialties) {
            const specialties = agent.capabilities.specialties.slice(0, 3);
            capabilitiesHTML = specialties.map(s => `<span style="background: rgba(0,255,0,0.1); padding: 3px 8px; border-radius: 3px; font-size: 0.75rem; color: #00FF00;">${s.replace(/_/g, ' ')}</span>`).join(' ');
        }

        // Avatar URL or default
        const avatarUrl = agent.avatar_url || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + encodeURIComponent(fullName);

        card.innerHTML = `
            <!-- Worker Type Badge -->
            <div style="background: ${badgeColor}; border: 1px solid ${borderColor}; padding: 6px 10px; border-radius: 4px; margin-bottom: 12px; font-size: 0.75rem; font-weight: bold; text-align: center; color: ${borderColor};">
                ${badgeText}
            </div>

            <div style="display: flex; gap: 15px; margin-bottom: 15px;">
                <div style="flex-shrink: 0;">
                    <img src="${avatarUrl}" alt="${fullName}" style="width: 80px; height: 80px; border-radius: 50%; border: 3px solid ${borderColor}; background: #0a0a0a; object-fit: cover;">
                </div>
                <div style="flex: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: start;">
                        <div>
                            <div style="font-size: 1.2rem; font-weight: bold; color: #FFFFFF; margin-bottom: 5px;">${fullName}</div>
                            <div style="font-size: 0.85rem; color: #888;">${agent.pronouns || ''}</div>
                        </div>
                        <div style="text-align: right;">
                            <div style="color: ${borderColor};">${tierStars}</div>
                            <div style="font-size: 0.75rem; color: #888;">Tier ${agent.tier}</div>
                        </div>
                    </div>
                </div>
            </div>

            <div style="margin-bottom: 10px;">
                <div style="color: ${borderColor}; font-size: 0.9rem; font-weight: bold;">${agent.title || agent.name}</div>
                <div style="color: #888; font-size: 0.8rem;">${agent.department || 'Unassigned'} • ${agent.agent_type || ''}</div>
            </div>

            <div style="margin-bottom: 10px;">
                <div style="font-size: 0.8rem; color: #FFFFFF; line-height: 1.4;">${(agent.bio || 'No description available').substring(0, 120)}${agent.bio && agent.bio.length > 120 ? '...' : ''}</div>
            </div>

            <div style="margin-bottom: 15px; display: flex; flex-wrap: wrap; gap: 5px;">
                ${capabilitiesHTML}
            </div>

            <div style="border-top: 1px solid #333; padding-top: 10px; display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <div style="font-size: 0.75rem; color: #888;">📧 ${agent.email || 'N/A'}</div>
                    <div style="font-size: 0.75rem; color: #888; margin-top: 3px;">🤖 ${agent.model || 'N/A'}</div>
                </div>
                <div style="text-align: right;">
                    <div style="font-size: 0.85rem; color: ${borderColor}; font-weight: bold;">${budget}</div>
                    <div style="font-size: 0.7rem; color: #888; margin-top: 3px;">Total: ${costDisplay}</div>
                </div>
            </div>
        `;

        grid.appendChild(card);
    });
}

function exportAgentDirectory() {
    // Create CSV content
    let csv = 'First Name,Last Name,Email,Title,Department,Pronouns,Worker Type,Tier,Model,Monthly Budget,Total Cost,Status\n';

    allDirectoryAgents.forEach(agent => {
        csv += `"${agent.first_name || ''}","${agent.last_name || ''}","${agent.email || ''}","${agent.title || ''}","${agent.department || ''}","${agent.pronouns || ''}","${agent.worker_type || ''}",${agent.tier || 1},"${agent.model || ''}",${agent.monthly_budget || 0},${agent.total_cost || 0},"${agent.status || ''}"\n`;
    });

    // Download CSV
    const blob = new Blob([csv], { type: 'text/csv' });
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'agent_directory_' + new Date().toISOString().split('T')[0] + '.csv';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    window.URL.revokeObjectURL(url);
}

function viewDirectoryAgentDetails(agentId) {
    // Find the agent in the loaded directory
    const agent = allDirectoryAgents.find(a => a.id === agentId);

    if (!agent) {
        console.error('Agent not found:', agentId);
        return;
    }

    const modal = document.getElementById('directoryAgentModal');
    const content = document.getElementById('directoryAgentContent');

    const fullName = `${agent.first_name} ${agent.last_name}`;
    const tierStars = '⭐'.repeat(agent.tier);
    const budget = agent.monthly_budget ? `$${parseFloat(agent.monthly_budget).toFixed(2)}/mo` : 'N/A';
    const totalCost = agent.total_cost ? `$${parseFloat(agent.total_cost).toFixed(2)}` : '$0.00';
    const totalTokens = agent.total_tokens_used ? parseInt(agent.total_tokens_used).toLocaleString() : '0';

    // Default avatar if none provided
    const avatarUrl = agent.avatar_url || 'https://api.dicebear.com/7.x/avataaars/svg?seed=' + encodeURIComponent(fullName);

    // Build capabilities HTML
    let capabilitiesHTML = '<div style="color: #888; padding: 20px; text-align: center;">No capabilities defined</div>';
    if (agent.capabilities) {
        const caps = agent.capabilities;

        let sections = '';

        // Specialties
        if (caps.specialties && caps.specialties.length > 0) {
            const specialtiesHTML = caps.specialties.map(s =>
                `<span style="display: inline-block; background: rgba(0,255,0,0.1); border: 1px solid #00FF00; padding: 8px 15px; margin: 5px; border-radius: 5px; color: #00FF00;">${s.replace(/_/g, ' ')}</span>`
            ).join('');
            sections += `
                <div style="margin-bottom: 20px;">
                    <h4 style="color: #00FF00; margin-bottom: 10px;">🎯 Specialties</h4>
                    <div style="display: flex; flex-wrap: wrap; gap: 5px;">
                        ${specialtiesHTML}
                    </div>
                </div>
            `;
        }

        // Tools
        if (caps.tools && caps.tools.length > 0) {
            const toolsHTML = caps.tools.map(t =>
                `<span style="display: inline-block; background: rgba(255,170,0,0.1); border: 1px solid #FFAA00; padding: 8px 15px; margin: 5px; border-radius: 5px; color: #FFAA00;">${t.replace(/_/g, ' ')}</span>`
            ).join('');
            sections += `
                <div style="margin-bottom: 20px;">
                    <h4 style="color: #00FF00; margin-bottom: 10px;">🛠️ Tools & Technologies</h4>
                    <div style="display: flex; flex-wrap: wrap; gap: 5px;">
                        ${toolsHTML}
                    </div>
                </div>
            `;
        }

        // Skills
        if (caps.skills && caps.skills.length > 0) {
            const skillsHTML = caps.skills.map(s =>
                `<li style="color: #FFFFFF; margin-bottom: 5px;">${s}</li>`
            ).join('');
            sections += `
                <div style="margin-bottom: 20px;">
                    <h4 style="color: #00FF00; margin-bottom: 10px;">💡 Skills</h4>
                    <ul style="margin: 0; padding-left: 25px;">
                        ${skillsHTML}
                    </ul>
                </div>
            `;
        }

        // Languages
        if (caps.languages && caps.languages.length > 0) {
            const languagesHTML = caps.languages.map(l =>
                `<span style="display: inline-block; background: rgba(0,200,255,0.1); border: 1px solid #00C8FF; padding: 8px 15px; margin: 5px; border-radius: 5px; color: #00C8FF;">${l}</span>`
            ).join('');
            sections += `
                <div style="margin-bottom: 20px;">
                    <h4 style="color: #00FF00; margin-bottom: 10px;">🌐 Languages</h4>
                    <div style="display: flex; flex-wrap: wrap; gap: 5px;">
                        ${languagesHTML}
                    </div>
                </div>
            `;
        }

        if (sections) {
            capabilitiesHTML = sections;
        }
    }

    content.innerHTML = `
        <!-- Agent Header with Avatar -->
        <div style="display: flex; gap: 25px; margin-bottom: 30px; padding-bottom: 25px; border-bottom: 2px solid #00FF00;">
            <div style="flex-shrink: 0;">
                <img src="${avatarUrl}" alt="${fullName}" style="width: 150px; height: 150px; border-radius: 50%; border: 5px solid #00FF00; background: #0a0a0a; object-fit: cover; box-shadow: 0 0 20px rgba(0,255,0,0.4);">
            </div>
            <div style="flex: 1;">
                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 10px;">
                    <h2 style="color: #00FF00; margin: 0; font-size: 2rem;">${fullName}</h2>
                    <button onclick="openEditAgentModal(${agent.id})" style="padding: 10px 20px; background: #00FF00; border: none; color: #000000; cursor: pointer; font-family: 'Courier New', monospace; font-weight: bold; border-radius: 5px; font-size: 0.9rem; box-shadow: 0 0 10px rgba(0,255,0,0.3);">✏️ EDIT PROFILE</button>
                </div>
                <div style="color: #888; font-size: 1rem; margin-bottom: 5px;">${agent.pronouns || ''}</div>
                <div style="color: #FFFFFF; font-size: 1.3rem; font-weight: bold; margin-bottom: 10px;">${agent.title}</div>
                <div style="display: flex; gap: 20px; align-items: center; margin-bottom: 10px;">
                    <div>
                        <span style="color: #888;">Department:</span>
                        <span style="color: #00FF00; font-weight: bold; margin-left: 5px;">${agent.department || 'Unassigned'}</span>
                    </div>
                    <div>
                        <span style="color: #888;">Type:</span>
                        <span style="color: #00FF00; margin-left: 5px;">${agent.agent_type || 'N/A'}</span>
                    </div>
                </div>
                <div style="display: flex; gap: 10px; align-items: center;">
                    <div style="color: #00FF00; font-size: 1.2rem;">${tierStars}</div>
                    <div style="color: #888; font-size: 0.9rem;">Tier ${agent.tier}</div>
                </div>
            </div>
        </div>

        <!-- Bio Section -->
        <div style="background: rgba(0,255,0,0.05); border-left: 4px solid #00FF00; padding: 20px; margin-bottom: 25px; border-radius: 5px;">
            <h3 style="color: #00FF00; margin: 0 0 10px 0; font-size: 1.1rem;">📋 Biography</h3>
            <div style="color: #FFFFFF; line-height: 1.6; font-size: 0.95rem;">${agent.bio || 'No biography available'}</div>
        </div>

        <!-- Stats Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 25px;">
            <div style="background: rgba(0,0,0,0.5); border: 1px solid #00FF00; padding: 20px; text-align: center; border-radius: 5px;">
                <div style="font-size: 0.75rem; color: #888; margin-bottom: 5px;">EMAIL</div>
                <div style="color: #00FF00; font-weight: bold; font-size: 0.85rem;">${agent.email || 'N/A'}</div>
            </div>
            <div style="background: rgba(0,0,0,0.5); border: 1px solid #00FF00; padding: 20px; text-align: center; border-radius: 5px;">
                <div style="font-size: 0.75rem; color: #888; margin-bottom: 5px;">AI MODEL</div>
                <div style="color: #00FF00; font-weight: bold; font-size: 0.85rem;">${agent.model || 'N/A'}</div>
            </div>
            <div style="background: rgba(0,0,0,0.5); border: 1px solid #00FF00; padding: 20px; text-align: center; border-radius: 5px;">
                <div style="font-size: 0.75rem; color: #888; margin-bottom: 5px;">MONTHLY BUDGET</div>
                <div style="color: #00FF00; font-weight: bold; font-size: 1.2rem;">${budget}</div>
            </div>
            <div style="background: rgba(0,0,0,0.5); border: 1px solid #00FF00; padding: 20px; text-align: center; border-radius: 5px;">
                <div style="font-size: 0.75rem; color: #888; margin-bottom: 5px;">TOTAL COST</div>
                <div style="color: #FFAA00; font-weight: bold; font-size: 1.2rem;">${totalCost}</div>
            </div>
            <div style="background: rgba(0,0,0,0.5); border: 1px solid #00FF00; padding: 20px; text-align: center; border-radius: 5px;">
                <div style="font-size: 0.75rem; color: #888; margin-bottom: 5px;">TOKENS USED</div>
                <div style="color: #00C8FF; font-weight: bold; font-size: 1.2rem;">${totalTokens}</div>
            </div>
        </div>

        <!-- Capabilities Section -->
        <div style="background: rgba(0,0,0,0.3); border: 1px solid #00FF00; padding: 25px; margin-bottom: 25px; border-radius: 5px;">
            <h3 style="color: #00FF00; margin: 0 0 20px 0; font-size: 1.3rem;">🎯 Capabilities & Expertise</h3>
            ${capabilitiesHTML}
        </div>

        <!-- System Prompt Section -->
        <div style="background: rgba(0,255,0,0.05); border: 2px solid #00FF00; padding: 25px; border-radius: 5px;">
            <h3 style="color: #00FF00; margin: 0 0 15px 0; font-size: 1.3rem;">🤖 System Prompt</h3>
            <div style="color: #CCCCCC; line-height: 1.6; font-family: 'Courier New', monospace; font-size: 0.85rem; white-space: pre-wrap; background: #0a0a0a; padding: 15px; border-radius: 5px; max-height: 400px; overflow-y: auto;">${agent.system_prompt || 'No system prompt configured'}</div>
        </div>
    `;

    modal.style.display = 'block';
    document.body.style.overflow = 'hidden'; // Prevent background scrolling
}

function closeDirectoryAgentModal() {
    document.getElementById('directoryAgentModal').style.display = 'none';
    document.body.style.overflow = 'auto'; // Re-enable scrolling
}

// =============================================================================
// AGENT PROFILE EDITING FUNCTIONS
// =============================================================================

function openEditAgentModal(agentId) {
    // Find the agent in the loaded directory
    const agent = allDirectoryAgents.find(a => a.id === agentId);

    if (!agent) {
        console.error('Agent not found:', agentId);
        return;
    }

    // Populate the edit form
    document.getElementById('editAgentId').value = agent.id;
    document.getElementById('editFirstName').value = agent.first_name || '';
    document.getElementById('editLastName').value = agent.last_name || '';
    document.getElementById('editEmail').value = agent.email || '';
    document.getElementById('editPhone').value = agent.phone || '';
    document.getElementById('editAvatarUrl').value = agent.avatar_url || '';

    // Set avatar previews
    const fullName = `${agent.first_name} ${agent.last_name}`;
    const currentAvatar = agent.avatar_url || `https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(fullName)}`;
    document.getElementById('currentAvatarPreview').src = currentAvatar;
    document.getElementById('newAvatarPreview').src = currentAvatar;

    // Hide status message
    document.getElementById('editAgentStatus').style.display = 'none';

    // Show edit modal
    document.getElementById('editAgentModal').style.display = 'block';
}

function updateAvatarPreview() {
    const urlInput = document.getElementById('editAvatarUrl');
    const preview = document.getElementById('newAvatarPreview');
    const firstName = document.getElementById('editFirstName').value;
    const lastName = document.getElementById('editLastName').value;
    const fullName = `${firstName} ${lastName}`.trim();

    if (urlInput.value.trim()) {
        // User entered a custom URL
        preview.src = urlInput.value.trim();
        preview.onerror = function() {
            // If image fails to load, show placeholder
            this.src = `https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(fullName || 'agent')}`;
        };
    } else {
        // Empty = use auto-generated avatar
        preview.src = `https://api.dicebear.com/7.x/avataaars/svg?seed=${encodeURIComponent(fullName || 'agent')}`;
    }
}

function closeEditAgentModal() {
    document.getElementById('editAgentModal').style.display = 'none';
    document.getElementById('editAgentForm').reset();
}

async function saveAgentProfile(event) {
    event.preventDefault();

    const agentId = document.getElementById('editAgentId').value;
    const statusDiv = document.getElementById('editAgentStatus');

    // Show loading status
    statusDiv.style.display = 'block';
    statusDiv.style.background = 'rgba(0,255,0,0.1)';
    statusDiv.style.border = '1px solid #00FF00';
    statusDiv.style.color = '#00FF00';
    statusDiv.innerHTML = '⏳ Saving changes...';

    try {
        const formData = {
            first_name: document.getElementById('editFirstName').value,
            last_name: document.getElementById('editLastName').value,
            email: document.getElementById('editEmail').value,
            phone: document.getElementById('editPhone').value,
            avatar_url: document.getElementById('editAvatarUrl').value
        };

        const response = await fetch(`/tools/admin/agents/${agentId}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(formData)
        });

        const data = await response.json();

        if (data.success) {
            // Show success message
            statusDiv.style.background = 'rgba(0,255,0,0.2)';
            statusDiv.style.border = '2px solid #00FF00';
            statusDiv.style.color = '#00FF00';
            statusDiv.innerHTML = '✅ Profile updated successfully! Changes will appear in both Admin Directory and Public Directory.';

            // Update the agent in the local array
            const agentIndex = allDirectoryAgents.findIndex(a => a.id === parseInt(agentId));
            if (agentIndex !== -1) {
                allDirectoryAgents[agentIndex] = {...allDirectoryAgents[agentIndex], ...data.agent};
            }

            // Reload the directory to show updated data
            setTimeout(() => {
                closeEditAgentModal();
                closeDirectoryAgentModal();
                loadAgentDirectory();
            }, 1500);

        } else {
            // Show error message
            statusDiv.style.background = 'rgba(255,0,0,0.2)';
            statusDiv.style.border = '2px solid #ff4444';
            statusDiv.style.color = '#ff4444';
            statusDiv.innerHTML = '❌ Error: ' + (data.error || 'Failed to update profile');
        }
    } catch (error) {
        console.error('Error saving agent profile:', error);
        statusDiv.style.background = 'rgba(255,0,0,0.2)';
        statusDiv.style.border = '2px solid #ff4444';
        statusDiv.style.color = '#ff4444';
        statusDiv.innerHTML = '❌ Network error: ' + error.message;
    }
}

// Auto-load when section is shown
document.addEventListener('DOMContentLoaded', function() {
    // Check if agent-directory section is visible and load
    const observer = new MutationObserver(function(mutations) {
        const section = document.getElementById('section-agent-directory');
        if (section && section.style.display !== 'none' && allDirectoryAgents.length === 0) {
            loadAgentDirectory();
        }
    });
});

// ============================================================================
// GITHUB INTEGRATION FUNCTIONS
// ============================================================================

// Test GitHub connection
async function testGitHubConnection() {
    const token = document.getElementById('github-token').value;

    if (!token) {
        showWarning('Please enter a GitHub token first');
        return;
    }

    try {
        const response = await fetch('/tools/github/test-connection', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token })
        });

        const data = await response.json();

        if (response.ok) {
            showSuccess(`${data.message} | Username: ${data.username} | Name: ${data.name || 'N/A'} | Email: ${data.email || 'N/A'}`);
        } else {
            showError(`Connection failed: ${data.error}`);
        }
    } catch (error) {
        showError(`Error: ${error.message}`);
    }
}

// Save GitHub settings
// Load GitHub settings from database
async function loadGitHubSettings() {
    try {
        const response = await fetch('/tools/github/get-settings', {
            method: 'GET',
            credentials: 'same-origin'
        });

        const data = await response.json();

        if (response.ok && data.settings) {
            const s = data.settings;
            document.getElementById('github-token').value = s.token || '';
            document.getElementById('github-username').value = s.username || '';
            document.getElementById('github-email').value = s.email || '';
            document.getElementById('website-repo').value = s.website_repo || '';
            document.getElementById('auto-deploy').checked = s.auto_deploy || false;
            document.getElementById('auto-commit-docs').checked = s.auto_commit_docs !== false;
        }
    } catch (error) {
        console.error('Error loading GitHub settings:', error);
    }
}

async function saveGitHubSettings() {
    const settings = {
        token: document.getElementById('github-token').value,
        username: document.getElementById('github-username').value,
        email: document.getElementById('github-email').value,
        website_repo: document.getElementById('website-repo').value,
        auto_deploy: document.getElementById('auto-deploy').checked,
        auto_commit_docs: document.getElementById('auto-commit-docs').checked
    };

    try {
        const response = await fetch('/tools/github/save-settings', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(settings)
        });

        const data = await response.json();

        if (response.ok) {
            showSuccess('GitHub settings saved successfully!');
        } else {
            showError(`Error: ${data.error}`);
        }
    } catch (error) {
        showError(`Error: ${error.message}`);
    }
}

// Clone website repository
async function cloneWebsiteRepo() {
    const repo = document.getElementById('website-repo').value;

    if (!repo) {
        alert('Please enter a repository name (username/repository)');
        return;
    }

    if (!confirm(`Clone repository: ${repo}?`)) return;

    try {
        const response = await fetch('/tools/github/clone-repo', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ repo, type: 'website' })
        });

        const data = await response.json();

        if (response.ok) {
            alert(`✓ ${data.message}\n\nLocal path: ${data.local_path}\nFiles: ${data.file_count}`);
            refreshRepoStatus();
        } else {
            showError(data.error);
        }
    } catch (error) {
        showError(error.message);
    }
}

// Pull website changes
async function pullWebsiteChanges() {
    const localPath = document.getElementById('website-path').value;

    try {
        const response = await fetch('/tools/github/pull-repo', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ local_path: localPath })
        });

        const data = await response.json();

        if (response.ok) {
            showSuccess(data.message);
        } else {
            showError(data.error);
        }
    } catch (error) {
        showError(error.message);
    }
}

// Push website changes
async function pushWebsiteChanges() {
    const localPath = document.getElementById('website-path').value;

    const message = prompt('Enter commit message:', 'Update website from A.R.C.H.I.E.');
    if (!message) return;

    try {
        const response = await fetch('/tools/github/push-repo', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ local_path: localPath, commit_message: message })
        });

        const data = await response.json();

        if (response.ok) {
            showSuccess(data.message);
        } else {
            showError(data.error);
        }
    } catch (error) {
        showError(error.message);
    }
}

// Sync website
async function syncWebsite() {
    const localPath = document.getElementById('website-path').value;

    if (!confirm('Sync website (pull from GitHub, then push local changes)?')) return;

    try {
        // First pull
        let response = await fetch('/tools/github/pull-repo', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ local_path: localPath })
        });

        if (!response.ok) {
            const data = await response.json();
            alert(`✗ Pull failed: ${data.error}`);
            return;
        }

        // Then push
        response = await fetch('/tools/github/push-repo', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                local_path: localPath,
                commit_message: `Sync from A.R.C.H.I.E. - ${new Date().toISOString()}`
            })
        });

        const data = await response.json();

        if (response.ok) {
            alert('✓ Website synced successfully!');
        } else {
            alert(`✓ Pulled successfully, but push had no changes or failed: ${data.message || data.error}`);
        }
    } catch (error) {
        showError(error.message);
    }
}

// NOTE: Learning Resources functions moved to Consciousness module
// See /tools/consciousness/ → RESOURCES tab for repo management

// Open website preview
function openWebsitePreview() {
    alert('Website preview coming soon!\n\nThis will serve the local website for testing before deployment.');
}

// NOTE: refreshRepoStatus moved to Consciousness module

// Auto-load GitHub settings and refresh repo status when Configuration section is shown
document.addEventListener('DOMContentLoaded', function() {
    const navItems = document.querySelectorAll('[data-section="config"]');
    navItems.forEach(item => {
        item.addEventListener('click', function() {
            setTimeout(() => {
                loadGitHubSettings();  // Load saved settings
            }, 500);
        });
    });

    // Auto-load data when sections are clicked
    document.querySelectorAll('[data-section="subscriptions"]').forEach(item => {
        item.addEventListener('click', () => setTimeout(loadSubscriptions, 300));
    });

    document.querySelectorAll('[data-section="permissions"]').forEach(item => {
        item.addEventListener('click', () => setTimeout(loadUsersForPermissions, 300));
    });

    document.querySelectorAll('[data-section="modules"]').forEach(item => {
        item.addEventListener('click', () => setTimeout(loadModules, 300));
    });
});

// ===========================================================================
// SUBSCRIPTION MANAGEMENT (Phase 6.5)
// ===========================================================================

function loadSubscriptions() {
    fetch('/tools/admin/subscriptions')
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                // Update stats
                const stats = data.statistics;
                const statsGrid = document.getElementById('subscription-stats');
                if (statsGrid && stats) {
                    const tierLabels = { free: 'FREE TIER', pro: 'PRO TIER', business: 'BUSINESS TIER', enterprise: 'ENTERPRISE TIER' };
                    statsGrid.innerHTML = '';
                    stats.forEach(stat => {
                        const card = document.createElement('div');
                        card.className = 'stat-card';
                        card.innerHTML = `
                            <div class="stat-label">${tierLabels[stat.subscription_tier] || stat.subscription_tier.toUpperCase()}</div>
                            <div class="stat-value">${stat.user_count}</div>
                            <div style="font-size: 0.7rem; opacity: 0.6; margin-top: 5px;">${stat.active_count} active</div>
                        `;
                        statsGrid.appendChild(card);
                    });
                }

                // Update table
                const tbody = document.getElementById('subscriptions-table-body');
                if (tbody && data.paid_users) {
                    if (data.paid_users.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; opacity: 0.5;">No paid subscriptions</td></tr>';
                    } else {
                        tbody.innerHTML = data.paid_users.map(user => {
                            const expires = user.subscription_expires_at ? new Date(user.subscription_expires_at) : null;
                            const daysLeft = expires ? Math.ceil((expires - new Date()) / (1000 * 60 * 60 * 24)) : '∞';
                            const expiresStr = expires ? expires.toLocaleDateString() : 'Never';

                            return `
                                <tr>
                                    <td>${user.username}</td>
                                    <td>${user.email}</td>
                                    <td><span class="badge" style="border-color: #FFC107; color: #FFC107;">${user.subscription_tier.toUpperCase()}</span></td>
                                    <td>${expiresStr}</td>
                                    <td>${daysLeft}</td>
                                    <td>
                                        <button class="btn btn-small" onclick="editSubscription(${user.id})">EDIT</button>
                                    </td>
                                </tr>
                            `;
                        }).join('');
                    }
                }
            }
        })
        .catch(e => console.error('Failed to load subscriptions:', e));
}

function editSubscription(userId) {
    const newTier = prompt('Enter new subscription tier (free, pro, business, enterprise):');
    if (!newTier) return;

    const expiresAt = prompt('Enter expiration date (YYYY-MM-DD) or leave blank for never:');

    fetch(`/tools/admin/user/${userId}/subscription/update`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            subscription_tier: newTier.toLowerCase(),
            expires_at: expiresAt || null
        })
    })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                showNotification(data.message, 'success');
                loadSubscriptions();
            } else {
                showNotification(data.error || 'Failed to update subscription', 'error');
            }
        })
        .catch(e => showNotification('Error updating subscription', 'error'));
}

// ===========================================================================
// PERMISSION MANAGEMENT (Phase 6.5)
// ===========================================================================

function loadUsersForPermissions() {
    fetch('/tools/admin/users')
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                const select = document.getElementById('permission-user-select');
                if (select) {
                    select.innerHTML = '<option value="">-- Select User --</option>';
                    data.users.forEach(user => {
                        const option = document.createElement('option');
                        option.value = user.id;
                        option.textContent = `${user.username} (${user.subscription_tier})`;
                        select.appendChild(option);
                    });
                }
            }
        })
        .catch(e => console.error('Failed to load users:', e));
}

function loadUserPermissions() {
    const userId = document.getElementById('permission-user-select').value;
    if (!userId) {
        document.getElementById('permission-details').style.display = 'none';
        return;
    }

    fetch(`/tools/admin/user/${userId}/permissions`)
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                document.getElementById('permission-details').style.display = 'block';

                // Update user info
                document.getElementById('perm-username').textContent = data.user.username;
                document.getElementById('perm-subscription').textContent = data.user.subscription_tier.toUpperCase();
                document.getElementById('perm-role').textContent = data.computed_role;
                document.getElementById('perm-accessible').textContent = `${data.accessible_count} / ${data.total_count}`;

                // Update accessible modules table
                const accessibleTable = document.getElementById('accessible-modules-table');
                if (data.accessible_modules.length === 0) {
                    accessibleTable.innerHTML = '<tr><td colspan="3" style="text-align: center; opacity: 0.5;">No accessible modules</td></tr>';
                } else {
                    accessibleTable.innerHTML = data.accessible_modules.map(mod => `
                        <tr>
                            <td>${mod.name}</td>
                            <td>${mod.category}</td>
                            <td>${mod.minimum_role}</td>
                        </tr>
                    `).join('');
                }

                // Update locked modules table
                const lockedTable = document.getElementById('locked-modules-table');
                if (data.locked_modules.length === 0) {
                    lockedTable.innerHTML = '<tr><td colspan="4" style="text-align: center; opacity: 0.5;">All modules accessible!</td></tr>';
                } else {
                    lockedTable.innerHTML = data.locked_modules.map(mod => `
                        <tr>
                            <td>${mod.name}</td>
                            <td>${mod.category}</td>
                            <td>${mod.minimum_role}</td>
                            <td>
                                <button class="btn btn-small" onclick="grantAccess(${userId}, '${mod.id}')">GRANT ACCESS</button>
                            </td>
                        </tr>
                    `).join('');
                }
            }
        })
        .catch(e => console.error('Failed to load permissions:', e));
}

function grantAccess(userId, moduleId) {
    showNotification('To grant access, upgrade the user\'s subscription tier in the SUBSCRIPTIONS section', 'info');
}

// ===========================================================================
// MODULE REGISTRY (Phase 6.5)
// ===========================================================================

function loadModules() {
    fetch('/tools/admin/modules')
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                const tbody = document.getElementById('modules-table-body');
                if (tbody) {
                    if (data.modules.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; opacity: 0.5;">No modules found</td></tr>';
                    } else {
                        tbody.innerHTML = data.modules.map(mod => {
                            const statusBadge = mod.enabled ?
                                '<span class="badge badge-active">ENABLED</span>' :
                                '<span class="badge badge-inactive">DISABLED</span>';
                            const betaBadge = mod.beta ? '<span class="badge badge-beta">BETA</span>' : '';
                            const comingSoonBadge = mod.coming_soon ? '<span class="badge badge-coming-soon">COMING SOON</span>' : '';

                            return `
                                <tr>
                                    <td>${mod.id}</td>
                                    <td>${mod.name} ${betaBadge} ${comingSoonBadge}</td>
                                    <td>${mod.category}</td>
                                    <td>${mod.minimum_role}</td>
                                    <td>${statusBadge}</td>
                                    <td>${mod.priority}</td>
                                </tr>
                            `;
                        }).join('');
                    }
                }
            }
        })
        .catch(e => console.error('Failed to load modules:', e));
}

</script>
{% endblock %}
