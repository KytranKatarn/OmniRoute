{% extends "base.html" %}

{% block title %}Admin Control Panel{% endblock %}

{% block styles %}
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Courier New', monospace;
    background: #000000;
    color: #00FF00;
    overflow: hidden;
}

.admin-wrapper {
    display: flex;
    height: 100vh;
    padding-bottom: 60px;
}

/* Left Sidebar */
.admin-sidebar {
    width: 280px;
    border-right: 2px solid #00FF00;
    background: #000000;
    overflow-y: auto;
}

.admin-header {
    padding: 25px 20px;
    border-bottom: 2px solid #00FF00;
    text-align: center;
}

.admin-header h1 {
    font-size: 1.8rem;
    letter-spacing: 8px;
    margin-bottom: 5px;
}

.admin-header p {
    font-size: 0.7rem;
    opacity: 0.7;
    letter-spacing: 2px;
}

.admin-nav {
    padding: 20px 0;
}

.nav-section {
    margin-bottom: 30px;
}

.nav-section-title {
    padding: 12px 20px;
    margin: 15px 10px 10px 10px;
    font-size: 1.1rem;
    letter-spacing: 4px;
    text-align: center;
    font-weight: bold;
    text-transform: uppercase;
    background: rgba(0, 255, 0, 0.1);
    border: 1px solid rgba(0, 255, 0, 0.3);
    border-left: 3px solid #00FF00;
    color: #FFFFFF;
    border-radius: 3px;
}

.nav-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 15px 20px;
    cursor: pointer;
    transition: all 0.3s;
    border-left: 3px solid transparent;
    text-decoration: none;
    color: #00FF00;
}

.nav-item:hover {
    background: rgba(0, 255, 0, 0.1);
    border-left-color: #00FF00;
}

.nav-item.active {
    background: rgba(0, 255, 0, 0.15);
    border-left-color: #00FF00;
}

.nav-item-icon {
    font-size: 1.2rem;
    width: 30px;
    text-align: center;
    flex-shrink: 0;
}

.nav-item-text {
    letter-spacing: 2px;
    font-size: 0.9rem;
    text-align: center;
    white-space: nowrap;
}

.nav-item-badge {
    background: #FF0000;
    color: #000000;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 0.7rem;
    font-weight: bold;
    flex-shrink: 0;
}

/* Main Content */
.admin-content {
    flex: 1;
    overflow-y: auto;
    padding: 40px;
}

.content-section {
    display: none;
    animation: fadeIn 0.3s;
}

.content-section.active {
    display: block;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.section-header {
    font-size: 2rem;
    letter-spacing: 8px;
    margin-bottom: 10px;
    padding-bottom: 15px;
    border-bottom: 2px solid #00FF00;
    text-align: center;
}

.section-subtitle {
    font-size: 0.9rem;
    opacity: 0.7;
    margin-bottom: 30px;
    text-align: center;
}

/* Stats Grid */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
}

.stat-card {
    border: 2px solid #00FF00;
    padding: 25px;
    background: rgba(0, 255, 0, 0.05);
}

.stat-label {
    font-size: 0.8rem;
    opacity: 0.7;
    letter-spacing: 2px;
    margin-bottom: 10px;
}

.stat-value {
    font-size: 2.5rem;
    letter-spacing: 5px;
    font-weight: bold;
}

.stat-change {
    font-size: 0.8rem;
    margin-top: 10px;
}

.stat-change.positive { color: #00FF00; }
.stat-change.negative { color: #FF0000; }

/* Action Bar */
.action-bar {
    display: flex;
    gap: 15px;
    margin-bottom: 30px;
    align-items: center;
}

/* Data Tables */
.data-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
}

.data-table th,
.data-table td {
    padding: 15px;
    text-align: left;
    border-bottom: 1px solid rgba(0, 255, 0, 0.2);
}

.data-table th {
    background: rgba(0, 255, 0, 0.1);
    font-weight: bold;
    letter-spacing: 2px;
    font-size: 0.9rem;
}

.data-table tr:hover {
    background: rgba(0, 255, 0, 0.05);
}

/* Buttons */
.btn {
    padding: 10px 20px;
    border: 1px solid #00FF00;
    background: #000000;
    color: #00FF00;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.3s;
    text-decoration: none;
    display: inline-block;
}

.btn:hover {
    background: #00FF00;
    color: #000000;
}

.btn-small {
    padding: 5px 10px;
    font-size: 0.7rem;
}

.btn-danger {
    border-color: #FF0000;
    color: #FF0000;
}

.btn-danger:hover {
    background: #FF0000;
    color: #000000;
}

.btn-success {
    border-color: #00FF00;
    color: #00FF00;
}

/* Badges */
.badge {
    padding: 4px 10px;
    border: 1px solid #00FF00;
    font-size: 0.7rem;
    letter-spacing: 1px;
    display: inline-block;
}

.badge-admin { color: #FFD700; border-color: #FFD700; }
.badge-active { color: #00FF00; border-color: #00FF00; }
.badge-inactive { color: #FF0000; border-color: #FF0000; }
.badge-pending { color: #FFA500; border-color: #FFA500; }

/* Forms */
.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 20px;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    letter-spacing: 2px;
    font-size: 0.9rem;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 10px;
    background: #000000;
    border: 1px solid #00FF00;
    color: #00FF00;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    box-shadow: 0 0 10px #00FF00;
}

/* Modal */
.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.95);
    z-index: 10000;
    align-items: center;
    justify-content: center;
}

.modal.active {
    display: flex;
}

.modal-content {
    border: 2px solid #00FF00;
    background: #000000;
    padding: 30px;
    max-width: 600px;
    width: 90%;
    max-height: 90vh;
    overflow-y: auto;
}

.modal-header {
    font-size: 1.5rem;
    letter-spacing: 5px;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 1px solid #00FF00;
}

.modal-actions {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid #00FF00;
}

/* Notifications */
.notification-item {
    border: 1px solid #00FF00;
    padding: 15px;
    margin-bottom: 12px;
    background: rgba(0, 255, 0, 0.05);
    position: relative;
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: 4px;
}

.notification-item:hover {
    background: rgba(0, 255, 0, 0.1);
    transform: translateX(3px);
}

.notification-item.unread {
    border-left: 5px solid #00FF00;
    box-shadow: 0 0 10px rgba(0, 255, 0, 0.3);
}

/* Priority-based left border colors */
.notification-item[data-priority="critical"] {
    border-left: 5px solid #FF0000;
    background: rgba(255, 0, 0, 0.08);
}

.notification-item[data-priority="high"] {
    border-left: 5px solid #FF6400;
    background: rgba(255, 100, 0, 0.06);
}

.notification-item[data-priority="normal"] {
    border-left: 5px solid #00FF00;
    background: rgba(0, 255, 0, 0.05);
}

.notification-item[data-priority="low"] {
    border-left: 5px solid #888;
    background: rgba(136, 136, 136, 0.05);
}

/* Critical notifications pulse animation */
.notification-item[data-priority="critical"].unread {
    animation: criticalPulse 2s infinite;
}

@keyframes criticalPulse {
    0%, 100% { box-shadow: 0 0 10px rgba(255, 0, 0, 0.5); }
    50% { box-shadow: 0 0 20px rgba(255, 0, 0, 0.8); }
}

.notification-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.notification-priority-badge {
    padding: 2px 6px;
    font-size: 0.65rem;
    border-radius: 3px;
    font-weight: bold;
    margin-right: 5px;
}

.notification-priority-badge.critical {
    background: #FF0000;
    color: #000;
}

.notification-priority-badge.high {
    background: #FF6400;
    color: #000;
}

.notification-priority-badge.normal {
    background: #00FF00;
    color: #000;
}

.notification-priority-badge.low {
    background: #888;
    color: #000;
}

.notification-type {
    padding: 3px 8px;
    font-size: 0.7rem;
    border: 1px solid;
    border-radius: 3px;
}

.notification-type.info { border-color: #00BFFF; color: #00BFFF; background: rgba(0, 191, 255, 0.1); }
.notification-type.warning { border-color: #FFA500; color: #FFA500; background: rgba(255, 165, 0, 0.1); }
.notification-type.error { border-color: #FF0000; color: #FF0000; background: rgba(255, 0, 0, 0.1); }
.notification-type.success { border-color: #00FF00; color: #00FF00; background: rgba(0, 255, 0, 0.1); }

.notification-time {
    font-size: 0.7rem;
    opacity: 0.6;
}

.notification-grouped-count {
    background: #00FF00;
    color: #000;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 0.7rem;
    font-weight: bold;
    margin-left: 8px;
}

/* Charts */
.chart-container {
    border: 2px solid #00FF00;
    padding: 20px;
    margin-bottom: 30px;
    background: rgba(0, 255, 0, 0.02);
}

.chart-title {
    font-size: 1.2rem;
    letter-spacing: 3px;
    margin-bottom: 20px;
}

/* Network Dashboard */
.network-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 30px;
}

.network-card {
    border: 2px solid #00FF00;
    padding: 20px;
}

.network-card h3 {
    letter-spacing: 3px;
    margin-bottom: 15px;
    padding-bottom: 10px;
    border-bottom: 1px solid #00FF00;
}

.network-card iframe {
    width: 100%;
    height: 400px;
    border: 1px solid #00FF00;
    margin-top: 10px;
}

/* Brain Viewer */
.brain-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 30px;
}

.brain-card {
    border: 2px solid #00FF00;
    padding: 20px;
    text-align: center;
}

.brain-card-value {
    font-size: 2rem;
    margin: 15px 0;
}

.brain-card-label {
    font-size: 0.8rem;
    opacity: 0.7;
}

/* Back Button */
/* Dashboard link styling - looks like category header with arrow */
.dashboard-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 20px;
    margin: 10px 10px 15px 10px;
    background: rgba(0, 255, 0, 0.15);
    border: 2px solid #00FF00;
    border-left: 4px solid #00FF00;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 1rem;
    text-decoration: none;
    border-radius: 3px;
    transition: all 0.2s ease;
}

.dashboard-link:hover {
    background: rgba(0, 255, 0, 0.25);
    border-color: #00FF00;
    box-shadow: 0 0 10px rgba(0, 255, 0, 0.3);
}

/* ========================================
   RESPONSIVE DESIGN FOR MOBILE & FOLDABLE PHONES
   ======================================== */

/* Tablets and Unfolded Fold 5 (7.6" inner display ~750-900px) */
@media screen and (max-width: 1024px) {
    .admin-wrapper {
        flex-direction: column;
    }

    .admin-sidebar {
        width: 100%;
        border-right: none;
        border-bottom: 2px solid #00FF00;
        max-height: 60px;
        overflow: hidden;
        transition: max-height 0.3s ease;
    }

    .admin-sidebar.mobile-expanded {
        max-height: 60vh;
        overflow-y: auto;
    }

    .admin-header {
        padding: 15px;
    }

    .admin-header h1 {
        font-size: 1.3rem;
        letter-spacing: 5px;
    }

    .admin-content {
        padding: 20px 15px;
        height: auto;
    }

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .section-header {
        font-size: 1.4rem;
        letter-spacing: 4px;
    }

    .stat-value {
        font-size: 1.8rem;
    }

    /* Splash page adjustments for unfolded */
    #section-archie-splash > div > div:first-child {
        font-size: 2.5rem !important;
        letter-spacing: 8px !important;
    }

    #section-archie-splash > div > div:nth-child(2) {
        font-size: 1rem !important;
        letter-spacing: 2px !important;
    }

    /* Splash footer - ensure visibility on unfolded screen */
    .splash-footer {
        margin-top: 40px !important;
        padding-bottom: 40px !important;
        font-size: 0.75rem !important;
    }
}

/* Folded Fold 5 (6.2" cover) and Standard Phones */
@media screen and (max-width: 768px) {
    .admin-wrapper {
        flex-direction: column;
        padding-bottom: 0;
    }

    /* Make sidebar collapsible on mobile */
    .admin-sidebar {
        width: 100%;
        border-right: none;
        border-bottom: 2px solid #00FF00;
        max-height: 50px;
        overflow: hidden;
        transition: max-height 0.3s ease;
    }

    .admin-sidebar.mobile-expanded {
        max-height: 70vh;
        overflow-y: auto;
    }

    .admin-header {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 12px 15px;
        position: relative;
    }

    .admin-header h1 {
        font-size: 1.1rem;
        letter-spacing: 3px;
    }

    .admin-header p {
        display: none;
    }

    /* Mobile menu toggle button */
    .admin-header::after {
        content: '☰';
        font-size: 1.3rem;
        cursor: pointer;
        position: absolute;
        right: 15px;
    }

    .admin-nav {
        padding: 5px 0;
    }

    .nav-section {
        margin-bottom: 10px;
    }

    .dashboard-link {
        padding: 10px 15px;
        margin: 8px 8px 12px 8px;
        font-size: 0.95rem;
    }

    .nav-section-title {
        padding: 10px 15px;
        margin: 12px 8px 8px 8px;
        font-size: 1rem;
        font-weight: bold;
        letter-spacing: 3px;
        background: rgba(0, 255, 0, 0.1);
        border: 1px solid rgba(0, 255, 0, 0.3);
        border-left: 3px solid #00FF00;
        color: #FFFFFF;
        border-radius: 3px;
    }

    .nav-item {
        padding: 10px 15px;
    }

    .nav-item-icon {
        font-size: 1rem;
        width: 25px;
    }

    .nav-item-text {
        font-size: 0.8rem;
        letter-spacing: 1px;
    }

    .nav-item-badge {
        font-size: 0.65rem;
        padding: 2px 6px;
    }

    /* Main content adjustments */
    .admin-content {
        padding: 15px 12px;
        height: auto;
    }

    .section-header {
        font-size: 1.2rem;
        letter-spacing: 2px;
        padding-bottom: 10px;
        margin-bottom: 8px;
    }

    .section-subtitle {
        font-size: 0.75rem;
        margin-bottom: 15px;
    }

    /* Stats grid for mobile */
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .stat-card {
        padding: 12px;
    }

    .stat-label {
        font-size: 0.65rem;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .stat-value {
        font-size: 1.3rem;
        letter-spacing: 2px;
    }

    /* Action bar responsive */
    .action-bar {
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 20px;
    }

    .btn {
        padding: 8px 12px;
        font-size: 0.75rem;
        flex: 1 1 calc(50% - 8px);
        min-width: 100px;
    }

    /* Tables responsive */
    .data-table {
        font-size: 0.75rem;
    }

    .data-table th,
    .data-table td {
        padding: 8px 6px;
    }

    /* Forms */
    input, textarea, select {
        font-size: 16px; /* Prevents zoom on iOS */
    }

    /* Brain grid for mobile */
    .brain-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .brain-card-value {
        font-size: 1.3rem;
    }

    /* Modals on mobile */
    .modal-content,
    #agentDetailModal > div {
        margin: 15px;
        padding: 15px;
    }

    /* Splash page for folded */
    #section-archie-splash > div {
        padding: 25px 12px !important;
    }

    #section-archie-splash > div > div:first-child {
        font-size: 2rem !important;
        letter-spacing: 5px !important;
        margin-bottom: 15px !important;
    }

    #section-archie-splash > div > div:nth-child(2) {
        font-size: 0.85rem !important;
        letter-spacing: 1px !important;
        line-height: 1.4 !important;
    }

    #section-archie-splash > div > div:nth-child(3) {
        font-size: 0.65rem !important;
        margin-bottom: 25px !important;
    }

    /* Splash mission statement */
    #section-archie-splash .stat-card {
        padding: 15px 10px;
    }

    /* Splash footer - ensure visibility on folded screen */
    .splash-footer {
        margin-top: 30px !important;
        padding-top: 20px !important;
        padding-bottom: 30px !important;
        font-size: 0.7rem !important;
    }
}

/* Small Phones and Narrow Screens */
@media screen and (max-width: 480px) {
    .admin-header h1 {
        font-size: 1rem;
        letter-spacing: 2px;
    }

    .section-header {
        font-size: 1.1rem;
        letter-spacing: 2px;
    }

    .section-subtitle {
        font-size: 0.75rem;
    }

    /* Single column layouts */
    .stats-grid {
        grid-template-columns: 1fr;
    }

    .brain-grid {
        grid-template-columns: 1fr;
    }

    .action-bar {
        flex-direction: column;
    }

    /* A.R.C.H.I.E. Splash Page responsive */
    #section-archie-splash > div {
        padding: 20px 10px !important;
    }

    #section-archie-splash > div > div:first-child {
        font-size: 2rem !important;
        letter-spacing: 5px !important;
    }

    #section-archie-splash > div > div:nth-child(2) {
        font-size: 0.9rem !important;
        letter-spacing: 1px !important;
    }

    #section-archie-splash > div > div:nth-child(3) {
        font-size: 0.7rem !important;
    }

    .btn {
        width: 100%;
        flex: 1 1 100%;
    }

    .stat-value {
        font-size: 1.8rem;
    }

    /* Tables scroll horizontally on very small screens */
    .table-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .data-table {
        font-size: 0.75rem;
        min-width: 100%;
    }

    .data-table th,
    .data-table td {
        padding: 8px 5px;
    }

    /* Agent grid responsive */
    #agentsGrid {
        grid-template-columns: 1fr !important;
        gap: 15px;
    }
}

/* Landscape mode for foldable phones */
@media screen and (max-height: 500px) and (orientation: landscape) {
    .admin-sidebar {
        max-height: 50px;
    }

    .admin-content {
        padding: 15px;
    }

    .section-header {
        font-size: 1.2rem;
        margin-bottom: 8px;
        padding-bottom: 8px;
    }

    .section-subtitle {
        margin-bottom: 15px;
    }

    .stat-card {
        padding: 12px;
    }

    .stat-value {
        font-size: 1.3rem;
    }
}

/* Touch-friendly improvements */
@media (hover: none) and (pointer: coarse) {
    .nav-item,
    .btn,
    button {
        min-height: 44px; /* iOS recommended minimum */
        cursor: pointer;
    }

    .nav-item:active {
        background: rgba(0, 255, 0, 0.2);
    }

    .btn:active {
        transform: scale(0.98);
    }
}

/* Pulse animation for new tags alert */
@keyframes pulse {
    0%, 100% {
        box-shadow: 0 0 15px rgba(139, 92, 246, 0.5);
    }
    50% {
        box-shadow: 0 0 30px rgba(139, 92, 246, 0.8);
    }
}
{% endblock %}

{% block content %}
<!-- Sandbox Mode Banner (if in sandbox mode) -->
{% include 'sandbox_banner.html' %}

<div class="admin-wrapper">
    <!-- Sidebar -->
    <div class="admin-sidebar">
        <div class="admin-header" onclick="showSplashScreen()" style="cursor: pointer;">
            <h1>⚙️ ADMIN</h1>
        </div>

        <!-- Notifications Header and Container -->
        <div style="border-bottom: 1px solid rgba(0,255,0,0.2); margin-bottom: 10px;">
            <!-- Clickable Notifications Header -->
            <div class="nav-item" data-section="notifications" style="
                padding: 12px 15px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                border-bottom: 1px solid rgba(0,255,0,0.1);
                background: rgba(0,255,0,0.05);
            ">
                <span style="font-size: 1.2rem;">🔔</span>
                <span style="color: #00FF00; font-weight: bold;">NOTIFICATIONS</span>
                {% if unread_notifications > 0 %}
                <span class="nav-item-badge">{{ unread_notifications }}</span>
                {% endif %}
            </div>

            <!-- Notification Feed Container -->
            <div id="admin-notifications" style="
                min-height: 60px;
                max-height: 150px;
                overflow-y: auto;
                padding: 8px 15px;
            ">
                <div id="notification-placeholder" style="
