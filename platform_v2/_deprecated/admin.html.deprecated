<!-- Include Chart.js for analytics -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
// Admin Notification System
function showNotification(message, type = 'info', duration = 5000) {
    const container = document.getElementById('admin-notifications');
    if (!container) return;

    // Hide placeholder when first notification appears
    const placeholder = document.getElementById('notification-placeholder');
    if (placeholder) {
        placeholder.style.display = 'none';
    }

    // IMPORTANT: Remove ALL existing notifications first (only show last one)
    const existingNotifications = container.querySelectorAll('.admin-notification');
    existingNotifications.forEach(notif => notif.remove());

    // Icon mapping
    const icons = {
        success: '✓',
        error: '✗',
        info: 'ℹ️',
        warning: '⚠️'
    };

    // Create notification element
    const notification = document.createElement('div');
    notification.className = `admin-notification ${type}`;
    notification.innerHTML = `
        <span class="admin-notification-icon">${icons[type] || 'ℹ️'}</span>
        <span class="admin-notification-text">${message}</span>
        <div class="admin-notification-progress"></div>
    `;

    // Add to container (newest at top, after placeholder)
    if (placeholder) {
        container.insertBefore(notification, placeholder.nextSibling);
    } else {
        container.insertBefore(notification, container.firstChild);
    }

    // Auto-remove after duration
    setTimeout(() => {
        notification.classList.add('fade-out');
        setTimeout(() => {
            notification.remove();

            // Show placeholder again if no notifications left
            const notifCount = container.querySelectorAll('.admin-notification').length;
            if (notifCount === 0 && placeholder) {
                placeholder.style.display = 'block';
            }
        }, 300);
    }, duration);

    // Save notification to database for permanent record
    saveNotificationToDatabase(message, type);
}

// Save notification to database so it appears in full Notifications section
// IMPORTANT: Notifications are created as UNREAD to force counter increment
// User must manually mark as read in Notifications section
async function saveNotificationToDatabase(message, type) {
    try {
        // Determine priority based on type
        let priority = 'normal';
        let source_icon = '📋';

        if (type === 'error') {
            priority = 'high';
            source_icon = '❌';
        } else if (type === 'warning') {
            priority = 'normal';
            source_icon = '⚠️';
        } else if (type === 'success') {
            priority = 'normal';
            source_icon = '✅';
        } else if (type === 'info') {
            priority = 'low';
            source_icon = 'ℹ️';
        }

        // Check if message contains critical keywords
        const criticalKeywords = ['failed', 'error', 'critical', 'urgent', 'security'];
        if (criticalKeywords.some(keyword => message.toLowerCase().includes(keyword))) {
            priority = 'critical';
            source_icon = '🚨';
        }

        await fetch('/tools/admin/notifications', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                type: type,
                title: 'Admin Action',
                message: message,
                source: 'admin-panel',
                priority: priority,
                source_icon: source_icon
            })
        });
    } catch (error) {
        console.error('Error saving notification to database:', error);
    }
}

// Helper functions for common notification types
function showSuccess(message, duration = 5000) {
    showNotification(message, 'success', duration);
}

function showError(message, duration = 7000) {
    showNotification(message, 'error', duration);
}

function showInfo(message, duration = 5000) {
    showNotification(message, 'info', duration);
}

function showWarning(message, duration = 6000) {
    showNotification(message, 'warning', duration);
}

// Navigation
document.querySelectorAll('.nav-item').forEach(item => {
    item.addEventListener('click', function() {
        const section = this.getAttribute('data-section');
        const isAlreadyActive = this.classList.contains('active');

        // Special case: Don't close Notifications if already open
        if (section === 'notifications' && isAlreadyActive) {
            return; // Do nothing, keep it open
        }

        // Remove active class from all items and sections
        document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
        document.querySelectorAll('.content-section').forEach(s => s.classList.remove('active'));

        // Add active class to clicked item
        this.classList.add('active');

        // Show corresponding section
        const sectionElement = document.getElementById('section-' + section);
        if (sectionElement) {
            sectionElement.classList.add('active');
        }

        // Load section-specific data
        if (section === 'analytics') {
            loadAnalytics();
        } else if (section === 'notifications') {
            filterNotifications('unread'); // Default to unread notifications
        } else if (section === 'agents') {
            loadAgents();
        } else if (section === 'agent-directory') {
            loadAgentDirectory();
        } else if (section === 'call-handling') {
            loadCallHandlingData();
        } else if (section === 'backups') {
            loadBackupData();
        } else if (section === 'improvements') {
            loadImprovementsConversationHistory();
            loadImprovementsList();
            loadImprovementsStats();
        } else if (section === 'api') {
            loadAgentAPIMapping();
            loadAPIProviders();
        }
    });
});

// Navigate to a section (for Quick Access buttons)
function navigateToSection(sectionName) {
    // Remove active class from all nav items and sections
    document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
    document.querySelectorAll('.content-section').forEach(s => s.classList.remove('active'));

    // Show the requested section
    const sectionElement = document.getElementById('section-' + sectionName);
    if (sectionElement) {
        sectionElement.classList.add('active');
    }

    // Activate the corresponding nav item
    const navItem = document.querySelector('[data-section="' + sectionName + '"]');
    if (navItem) {
        navItem.classList.add('active');
    }

    // Load section-specific data
    if (sectionName === 'notifications') {
        applyFilters(); // Load notifications with current filters
    } else if (sectionName === 'agent-directory') {
        loadAgentDirectory();
    } else if (sectionName === 'improvements') {
        console.log('🎯 [FRONTEND] IMPROVEMENTS section activated, loading stats...');
        loadImprovementsStats();
    }

    // Close mobile menu if open
    const adminSidebar = document.querySelector('.admin-sidebar');
    if (adminSidebar && window.innerWidth <= 1024) {
        adminSidebar.classList.remove('mobile-expanded');
    }
}

// Show A.R.C.H.I.E. Splash Screen
function showSplashScreen() {
    // On mobile (<=1024px), only toggle menu, don't navigate to splash
    if (window.innerWidth <= 1024) {
        const adminSidebar = document.querySelector('.admin-sidebar');
        if (adminSidebar) {
            adminSidebar.classList.toggle('mobile-expanded');
        }
        return; // Don't show splash screen on mobile
    }

    // On desktop, show splash screen
    document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
    document.querySelectorAll('.content-section').forEach(s => s.classList.remove('active'));

    const splashSection = document.getElementById('section-archie-splash');
    if (splashSection) {
        splashSection.classList.add('active');
    }
}

// Mobile Menu Toggle and Navigation
document.addEventListener('DOMContentLoaded', function() {
    const adminSidebar = document.querySelector('.admin-sidebar');

    // Close mobile menu when a nav item is clicked
    document.querySelectorAll('.nav-item').forEach(item => {
        item.addEventListener('click', function() {
            if (window.innerWidth <= 1024 && adminSidebar) {
                adminSidebar.classList.remove('mobile-expanded');
            }
        });
    });
});

