[Unit]
Description=Host OpenCode Supervisor Broker
After=network.target
ConditionACPower=true

[Service]
Type=simple
User=kytran
Group=kytran
WorkingDirectory=/mnt/archie_brain
ExecStart=/usr/bin/python3 /mnt/archie_brain/platform_v2/tools/host_opencode/broker.py
ExecStartPre=-/bin/chmod 700 /var/lib/host-opencode/keys
ExecStartPre=-/bin/chmod 755 /var/lib/host-opencode/journal
ExecStartPre=-/bin/chmod 600 /var/lib/host-opencode/keys/broker_private.key
ExecStartPre=-/bin/chmod 640 /var/lib/host-opencode/keys/broker_public.key
StateDirectory=host-opencode
RuntimeDirectory=host-opencode-broker
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHostname=yes
MemoryMax=200M
TimeoutStartSec=60
TimeoutStopSec=30
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
