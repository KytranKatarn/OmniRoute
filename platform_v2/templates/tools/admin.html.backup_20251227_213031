{% extends "base.html" %}

{% block title %}Admin Control Panel{% endblock %}

{% block styles %}
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Courier New', monospace;
    background: #000000;
    color: #00FF00;
    overflow: hidden;
}

.admin-wrapper {
    display: flex;
    height: 100vh;
    padding-bottom: 60px;
}

/* Left Sidebar */
.admin-sidebar {
    width: 280px;
    border-right: 2px solid #00FF00;
    background: #000000;
    overflow-y: auto;
}

.admin-header {
    padding: 25px 20px;
    border-bottom: 2px solid #00FF00;
}

.admin-header h1 {
    font-size: 1.8rem;
    letter-spacing: 8px;
    margin-bottom: 5px;
}

.admin-header p {
    font-size: 0.7rem;
    opacity: 0.7;
    letter-spacing: 2px;
}

.admin-nav {
    padding: 20px 0;
}

.nav-section {
    margin-bottom: 30px;
}

.nav-section-title {
    padding: 0 20px 10px 20px;
    font-size: 0.7rem;
    opacity: 0.5;
    letter-spacing: 2px;
}

.nav-item {
    display: flex;
    align-items: center;
    padding: 15px 20px;
    cursor: pointer;
    transition: all 0.3s;
    border-left: 3px solid transparent;
    text-decoration: none;
    color: #00FF00;
}

.nav-item:hover {
    background: rgba(0, 255, 0, 0.1);
    border-left-color: #00FF00;
}

.nav-item.active {
    background: rgba(0, 255, 0, 0.15);
    border-left-color: #00FF00;
}

.nav-item-icon {
    font-size: 1.2rem;
    width: 30px;
}

.nav-item-text {
    flex: 1;
    letter-spacing: 2px;
    font-size: 0.9rem;
}

.nav-item-badge {
    background: #FF0000;
    color: #000000;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 0.7rem;
    font-weight: bold;
}

/* Main Content */
.admin-content {
    flex: 1;
    overflow-y: auto;
    padding: 40px;
}

.content-section {
    display: none;
    animation: fadeIn 0.3s;
}

.content-section.active {
    display: block;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.section-header {
    font-size: 2rem;
    letter-spacing: 8px;
    margin-bottom: 10px;
    padding-bottom: 15px;
    border-bottom: 2px solid #00FF00;
}

.section-subtitle {
    font-size: 0.9rem;
    opacity: 0.7;
    margin-bottom: 30px;
}

/* Stats Grid */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
}

.stat-card {
    border: 2px solid #00FF00;
    padding: 25px;
    background: rgba(0, 255, 0, 0.05);
}

.stat-label {
    font-size: 0.8rem;
    opacity: 0.7;
    letter-spacing: 2px;
    margin-bottom: 10px;
}

.stat-value {
    font-size: 2.5rem;
    letter-spacing: 5px;
    font-weight: bold;
}

.stat-change {
    font-size: 0.8rem;
    margin-top: 10px;
}

.stat-change.positive { color: #00FF00; }
.stat-change.negative { color: #FF0000; }

/* Action Bar */
.action-bar {
    display: flex;
    gap: 15px;
    margin-bottom: 30px;
    align-items: center;
}

/* Data Tables */
.data-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
}

.data-table th,
.data-table td {
    padding: 15px;
    text-align: left;
    border-bottom: 1px solid rgba(0, 255, 0, 0.2);
}

.data-table th {
    background: rgba(0, 255, 0, 0.1);
    font-weight: bold;
    letter-spacing: 2px;
    font-size: 0.9rem;
}

.data-table tr:hover {
    background: rgba(0, 255, 0, 0.05);
}

/* Buttons */
.btn {
    padding: 10px 20px;
    border: 1px solid #00FF00;
    background: #000000;
    color: #00FF00;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.3s;
    text-decoration: none;
    display: inline-block;
}

.btn:hover {
    background: #00FF00;
    color: #000000;
}

.btn-small {
    padding: 5px 10px;
    font-size: 0.7rem;
}

.btn-danger {
    border-color: #FF0000;
    color: #FF0000;
}

.btn-danger:hover {
    background: #FF0000;
    color: #000000;
}

.btn-success {
    border-color: #00FF00;
    color: #00FF00;
}

/* Badges */
.badge {
    padding: 4px 10px;
    border: 1px solid #00FF00;
    font-size: 0.7rem;
    letter-spacing: 1px;
    display: inline-block;
}

.badge-admin { color: #FFD700; border-color: #FFD700; }
.badge-active { color: #00FF00; border-color: #00FF00; }
.badge-inactive { color: #FF0000; border-color: #FF0000; }
.badge-pending { color: #FFA500; border-color: #FFA500; }

/* Forms */
.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 20px;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    letter-spacing: 2px;
    font-size: 0.9rem;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 10px;
    background: #000000;
    border: 1px solid #00FF00;
    color: #00FF00;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    box-shadow: 0 0 10px #00FF00;
}

/* Modal */
.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.95);
    z-index: 10000;
    align-items: center;
    justify-content: center;
}

.modal.active {
    display: flex;
}

.modal-content {
    border: 2px solid #00FF00;
    background: #000000;
    padding: 30px;
    max-width: 600px;
    width: 90%;
    max-height: 90vh;
    overflow-y: auto;
}

.modal-header {
    font-size: 1.5rem;
    letter-spacing: 5px;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 1px solid #00FF00;
}

.modal-actions {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
    margin-top: 30px;
    padding-top: 20px;
    border-top: 1px solid #00FF00;
}

/* Notifications */
.notification-item {
    border: 1px solid #00FF00;
    padding: 15px;
    margin-bottom: 10px;
    background: rgba(0, 255, 0, 0.05);
    position: relative;
}

.notification-item.unread {
    border-left: 4px solid #00FF00;
}

.notification-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.notification-type {
    padding: 3px 8px;
    font-size: 0.7rem;
    border: 1px solid;
}

.notification-type.info { border-color: #00BFFF; color: #00BFFF; }
.notification-type.warning { border-color: #FFA500; color: #FFA500; }
.notification-type.error { border-color: #FF0000; color: #FF0000; }
.notification-type.success { border-color: #00FF00; color: #00FF00; }

.notification-time {
    font-size: 0.7rem;
    opacity: 0.6;
}

/* Charts */
.chart-container {
    border: 2px solid #00FF00;
    padding: 20px;
    margin-bottom: 30px;
    background: rgba(0, 255, 0, 0.02);
}

.chart-title {
    font-size: 1.2rem;
    letter-spacing: 3px;
    margin-bottom: 20px;
}

/* Network Dashboard */
.network-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 30px;
}

.network-card {
    border: 2px solid #00FF00;
    padding: 20px;
}

.network-card h3 {
    letter-spacing: 3px;
    margin-bottom: 15px;
    padding-bottom: 10px;
    border-bottom: 1px solid #00FF00;
}

.network-card iframe {
    width: 100%;
    height: 400px;
    border: 1px solid #00FF00;
    margin-top: 10px;
}

/* Brain Viewer */
.brain-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 30px;
}

.brain-card {
    border: 2px solid #00FF00;
    padding: 20px;
    text-align: center;
}

.brain-card-value {
    font-size: 2rem;
    margin: 15px 0;
}

.brain-card-label {
    font-size: 0.8rem;
    opacity: 0.7;
}

/* Back Button */
.back-button {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 9999;
}
{% endblock %}

{% block content %}
<div class="admin-wrapper">
    <!-- Sidebar -->
    <div class="admin-sidebar">
        <div class="admin-header">
            <h1>⚙️ ADMIN</h1>
            <p>CONTROL PANEL</p>
        </div>

        <nav class="admin-nav">
            <!-- USER MANAGEMENT -->
            <div class="nav-section">
                <div class="nav-section-title">USER MANAGEMENT</div>
                <div class="nav-item active" data-section="users">
                    <span class="nav-item-icon">👥</span>
                    <span class="nav-item-text">USERS</span>
                    {% if pending_count > 0 %}
                    <span class="nav-item-badge">{{ pending_count }}</span>
                    {% endif %}
                </div>
            </div>

            <!-- MONITORING -->
            <div class="nav-section">
                <div class="nav-section-title">MONITORING</div>
                <div class="nav-item" data-section="notifications">
                    <span class="nav-item-icon">🔔</span>
                    <span class="nav-item-text">NOTIFICATIONS</span>
                    {% if unread_notifications > 0 %}
                    <span class="nav-item-badge">{{ unread_notifications }}</span>
                    {% endif %}
                </div>
                <div class="nav-item" data-section="analytics">
                    <span class="nav-item-icon">📈</span>
                    <span class="nav-item-text">ANALYTICS</span>
                </div>
                <div class="nav-item" data-section="network">
                    <span class="nav-item-icon">🖥️</span>
                    <span class="nav-item-text">NETWORK</span>
                </div>
            </div>

            <!-- BUSINESS -->
            <div class="nav-section">
                <div class="nav-section-title">BUSINESS</div>
                <div class="nav-item" data-section="billing">
                    <span class="nav-item-icon">💰</span>
                    <span class="nav-item-text">BILLING</span>
                </div>
                <div class="nav-item" data-section="store">
                    <span class="nav-item-icon">🛒</span>
                    <span class="nav-item-text">STORE</span>
                </div>
            </div>

            <!-- A.R.C.H.I.E. -->
            <div class="nav-section">
                <div class="nav-section-title">A.R.C.H.I.E.</div>
                <div class="nav-item" data-section="improvements">
                    <span class="nav-item-icon">🔧</span>
                    <span class="nav-item-text">IMPROVEMENTS</span>
                    {% if improvement_pending > 0 %}
                    <span class="nav-item-badge">{{ improvement_pending }}</span>
                    {% endif %}
                </div>
                <div class="nav-item" data-section="consciousness">
                    <span class="nav-item-icon">🧠</span>
                    <span class="nav-item-text">CONSCIOUSNESS</span>
                
                </div>
                <div class="nav-item" data-section="backups">
                    <span class="nav-item-icon">💾</span>
                    <span class="nav-item-text">BACKUP MANAGER</span>
                </div>

            </div>

            <!-- SYSTEM -->
            <div class="nav-section">
                <div class="nav-section-title">SYSTEM</div>
                <div class="nav-item" data-section="security">
                    <span class="nav-item-icon">🔐</span>
                    <span class="nav-item-text">SECURITY</span>
                    {% if failed_logins_24h > 10 %}
                    <span class="nav-item-badge">!</span>
                    {% endif %}
                </div>
                <div class="nav-item" data-section="website">
                    <span class="nav-item-icon">🌐</span>
                    <span class="nav-item-text">WEBSITE</span>
                </div>
                <div class="nav-item" data-section="api">
                    <span class="nav-item-icon">🔑</span>
                    <span class="nav-item-text">API SETTINGS</span>
                </div>
                <div class="nav-item" data-section="audit">
                    <span class="nav-item-icon">📊</span>
                    <span class="nav-item-text">AUDIT LOG</span>
                </div>
                <div class="nav-item" data-section="config">
                    <span class="nav-item-icon">⚙️</span>
                    <span class="nav-item-text">CONFIGURATION</span>
                </div>
            </div>
        </nav>
    </div>

    <!-- Main Content -->
    <div class="admin-content">
        <!-- Back Button -->
        <div class="back-button">
            <a href="{{ url_for('dashboard') }}" class="btn">← BACK TO DASHBOARD</a>
        </div>

        <!-- USERS SECTION (Existing - Keep as is) -->
        <div class="content-section active" id="section-users">
            <div class="section-header">👥 USER MANAGEMENT</div>
            <div class="section-subtitle">Manage user accounts and permissions</div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-label">TOTAL USERS</div>
                    <div class="stat-value">{{ stats.total }}</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">ACTIVE USERS</div>
                    <div class="stat-value">{{ stats.active }}</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">PENDING APPROVAL</div>
                    <div class="stat-value">{{ stats.pending }}</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">ADMINISTRATORS</div>
                    <div class="stat-value">{{ stats.admins }}</div>
                </div>
            </div>

            <div class="action-bar">
                <button class="btn" onclick="openCreateUserModal()">+ CREATE USER</button>
            </div>

            <table class="data-table">
                <thead>
                    <tr>
                        <th>USERNAME</th>
                        <th>EMAIL</th>
                        <th>ROLE</th>
                        <th>STATUS</th>
                        <th>JOINED</th>
                        <th>ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td>{{ user.username }}</td>
                        <td>{{ user.email }}</td>
                        <td>
                            {{ user.role.upper() }}
                            {% if user.is_admin %}<span class="badge badge-admin">ADMIN</span>{% endif %}
                        </td>
                        <td>
                            {% if user.is_active %}
                            <span class="badge badge-active">ACTIVE</span>
                            {% else %}
                            <span class="badge badge-pending">PENDING</span>
                            {% endif %}
                        </td>
                        <td>{{ user.created_at.strftime('%Y-%m-%d') if user.created_at else 'N/A' }}</td>
                        <td>
                            <button class="btn btn-small" onclick="editUser({{ user.id }})">EDIT</button>
                            <button class="btn btn-small btn-danger" onclick="deleteUser({{ user.id }})">DELETE</button>
                        </td>
                    </tr>
                    {% endfor %}
                </table>
        </div>

        <!-- NOTIFICATIONS SECTION (NEW) -->
        <div class="content-section" id="section-notifications">
            <div class="section-header">🔔 NOTIFICATIONS CENTER</div>
            <div class="section-subtitle">System alerts and activity feed</div>

            <div class="action-bar">
                <button class="btn" onclick="markAllRead()">MARK ALL READ</button>
                <button class="btn" onclick="refreshNotifications()">↻ REFRESH</button>
            </div>

            <div id="notifications-list">
                {% for notif in notifications %}
                <div class="notification-item {% if not notif.is_read %}unread{% endif %}">
                    <div class="notification-header">
                        <span class="notification-type {{ notif.type }}">{{ notif.type.upper() }}</span>
                        <span class="notification-time">{{ notif.created_at.strftime('%Y-%m-%d %H:%M') if notif.created_at else 'N/A' }}</span>
                    </div>
                    <div style="font-size: 1rem; margin-bottom: 5px;">{{ notif.title }}</div>
                    <div style="font-size: 0.85rem; opacity: 0.8;">{{ notif.message }}</div>
                    {% if not notif.is_read %}
                    <button class="btn btn-small" onclick="markRead({{ notif.id }})" style="margin-top: 10px;">MARK READ</button>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </div>

        <!-- ANALYTICS SECTION (NEW) -->
        <div class="content-section" id="section-analytics">
            <div class="section-header">📈 ANALYTICS DASHBOARD</div>
            <div class="section-subtitle">Platform metrics and insights</div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-label">TOTAL REVENUE (30D)</div>
                    <div class="stat-value">${{ "%.2f"|format(revenue_30d) }}</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">ACTIVE SUBSCRIPTIONS</div>
                    <div class="stat-value">{{ active_subscriptions }}</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">ORDERS (30D)</div>
                    <div class="stat-value">{{ orders_30d }}</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">TOTAL PRODUCTS</div>
                    <div class="stat-value">{{ total_products }}</div>
                </div>
            </div>

            <div class="chart-container">
                <div class="chart-title">USER GROWTH (LAST 30 DAYS)</div>
                <canvas id="userGrowthChart"></canvas>
            </div>

            <div class="chart-container">
                <div class="chart-title">REVENUE TREND (LAST 30 DAYS)</div>
                <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <!-- NETWORK SECTION (NEW) -->
        <div class="content-section" id="section-network">
            <div class="section-header">🖥️ NETWORK DASHBOARD</div>
            <div class="section-subtitle">Network monitoring and system health</div>

            {% if system_health %}
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-label">CPU USAGE</div>
                    <div class="stat-value">{{ "%.1f"|format(system_health.cpu.percent) }}%</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">MEMORY USAGE</div>
                    <div class="stat-value">{{ "%.1f"|format(system_health.memory.percent) }}%</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">DISK USAGE</div>
                    <div class="stat-value">{{ "%.1f"|format(system_health.disk.percent) }}%</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">SYSTEM STATUS</div>
                    <div class="stat-value" style="font-size: 1.5rem; color: #00FF00;">●</div>
                    <div style="font-size: 0.8rem; margin-top: 10px;">HEALTHY</div>
                </div>
            </div>
            {% endif %}

            <div class="network-grid">
                <div class="network-card">
                    <h3>🛡️ ADGUARD (DNS)</h3>
                    <p style="margin-bottom: 10px; opacity: 0.7;">DNS filtering and ad blocking</p>
                    <a href="http://192.168.1.250:5354" target="_blank" class="btn btn-small">OPEN ADGUARD</a>
                </div>
                <div class="network-card">
                    <h3>📡 NTOPNG (TRAFFIC)</h3>
                    <p style="margin-bottom: 10px; opacity: 0.7;">Network traffic monitoring</p>
                    <a href="http://192.168.1.250:3001" target="_blank" class="btn btn-small">OPEN NTOPNG</a>
                </div>
                <div class="network-card">
                    <h3>🚨 NAGIOS (MONITORING)</h3>
                    <p style="margin-bottom: 10px; opacity: 0.7;">Server and service monitoring</p>
                    <a href="http://192.168.1.250:8082" target="_blank" class="btn btn-small">OPEN NAGIOS</a>
                </div>
                <div class="network-card">
                    <h3>⚡ NGINX PROXY</h3>
                    <p style="margin-bottom: 10px; opacity: 0.7;">Reverse proxy manager</p>
                    <a href="http://192.168.1.250:81" target="_blank" class="btn btn-small">OPEN NGINX</a>
                </div>
            </div>
        </div>

        <!-- BILLING SECTION (NEW) -->
        <div class="content-section" id="section-billing">
            <div class="section-header">💰 BILLING & SUBSCRIPTIONS</div>
            <div class="section-subtitle">Manage subscriptions and revenue</div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-label">MONTHLY RECURRING REVENUE</div>
                    <div class="stat-value">$0.00</div>
                    <div class="stat-change positive">↑ Coming Soon</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">ACTIVE SUBSCRIPTIONS</div>
                    <div class="stat-value">{{ active_subscriptions }}</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">TOTAL REVENUE</div>
                    <div class="stat-value">${{ "%.2f"|format(revenue_30d) }}</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">CHURN RATE</div>
                    <div class="stat-value">0%</div>
                </div>
            </div>

            <div style="padding: 40px; border: 2px solid #00FF00; text-align: center; opacity: 0.7;">
                <div style="font-size: 1.5rem; margin-bottom: 20px;">🔧 STRIPE INTEGRATION</div>
                <p>Configure your Stripe API keys in .env to enable billing features</p>
                <p style="margin-top: 10px; font-size: 0.8rem;">STRIPE_SECRET_KEY, STRIPE_PUBLISHABLE_KEY, STRIPE_WEBHOOK_SECRET</p>
            </div>
        </div>

        <!-- STORE SECTION (NEW) -->
        <div class="content-section" id="section-store">
            <div class="section-header">🛒 STORE MANAGEMENT</div>
            <div class="section-subtitle">Printful products and orders</div>

            <div class="action-bar">
                <button class="btn" onclick="syncProducts()">↻ SYNC PRODUCTS</button>
                <button class="btn" onclick="viewOrders()">VIEW ORDERS</button>
            </div>

            <div style="padding: 40px; border: 2px solid #00FF00; text-align: center; opacity: 0.7;">
                <div style="font-size: 1.5rem; margin-bottom: 20px;">🔧 PRINTFUL INTEGRATION</div>
                <p>Configure your Printful API key in .env to enable store features</p>
                <p style="margin-top: 10px; font-size: 0.8rem;">PRINTFUL_API_KEY</p>
                <button class="btn" onclick="syncProducts()" style="margin-top: 20px;">SYNC NOW</button>
            </div>

            <div id="products-list" style="margin-top: 30px;"></div>
        </div>

