});

async function loadBackups() {
    try {
        const response = await fetch('/tools/admin/backups/api/list');
        const data = await response.json();
        
        if (data.success) {
            displayBackups(data.backups);
            updateBackupStats(data.backups);
        } else {
            showError('Failed to load backups: ' + data.error);
        }
    } catch (error) {
        showError('Error loading backups: ' + error.message);
    }
}

function displayBackups(backups) {
    const tbody = document.getElementById('backupsTableBody');
    
    if (backups.length === 0) {
        tbody.innerHTML = `
            <tr>
                <td colspan="5" style="text-align: center; padding: 40px; opacity: 0.7;">
                    No backups found. Create your first backup to get started.
                </td>
            </tr>
        `;
        return;
    }
    
    tbody.innerHTML = backups.map(backup => `
        <tr>
            <td><strong>${formatTimestamp(backup.created_at)}</strong></td>
            <td>${backup.description}</td>
            <td>${backup.created_by}</td>
            <td>${formatSize(backup.size)}</td>
            <td>
                <button class="btn btn-small" onclick="restoreBackupConfirm('${backup.name}')">
                    RESTORE
                </button>
                <button class="btn btn-small" onclick="downloadBackup('${backup.name}')">
                    DOWNLOAD
                </button>
                <button class="btn btn-small btn-danger" onclick="deleteBackupConfirm('${backup.name}')">
                    DELETE
                </button>
            </td>
        </tr>
    `).join('');
}

function updateBackupStats(backups) {
    document.getElementById('totalBackups').textContent = backups.length;
    
    if (backups.length > 0) {
        const latest = backups[0];
        document.getElementById('latestBackup').textContent = 
            formatTimestamp(latest.created_at).split(' ')[0];
        
        const totalSize = backups.reduce((sum, b) => sum + (b.size || 0), 0);
        document.getElementById('totalSize').textContent = formatSize(totalSize);
    } else {
        document.getElementById('latestBackup').textContent = 'None';
        document.getElementById('totalSize').textContent = '0 MB';
    }
}

async function createBackupNow() {
    const description = prompt('Enter backup description:', 'Manual backup');
    if (!description) return;
    
    showLoading('Creating backup... This may take a minute.');
    
    try {
        const response = await fetch('/tools/admin/backups/api/create', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ description: description })
        });
        
        const data = await response.json();
        hideLoading();
        
        if (data.success) {
            showSuccess('Backup created successfully!');
            loadBackups();
        } else {
            showError('Failed to create backup: ' + data.error);
        }
    } catch (error) {
        hideLoading();
        showError('Error creating backup: ' + error.message);
    }
}

function restoreBackupConfirm(name) {
    if (!confirm(`⚠️ RESTORE BACKUP\n\nAre you sure you want to restore "${name}"?\n\nThis will:\n• Stop the platform\n• Restore database\n• Restore files\n• Restart platform\n\nThis may take several minutes.\n\nContinue?`)) {
        return;
    }
    
    restoreBackup(name);
}

async function restoreBackup(name) {
    showLoading('Restoring backup... Please wait.');
    
    try {
        const response = await fetch(`/admin/backups/api/restore/${name}`, {
            method: 'POST'
        });
        
        const data = await response.json();
        hideLoading();
        
        if (data.success) {
            alert('✓ Restore initiated!\n\nThe platform is restarting...\n\nPlease wait 30 seconds and refresh this page.');
            setTimeout(() => location.reload(), 30000);
        } else {
            showError('Restore failed: ' + data.error);
        }
    } catch (error) {
        hideLoading();
        showError('Error restoring backup: ' + error.message);
    }
}

async function downloadBackup(name) {
    showLoading('Preparing download...');
    window.location.href = `/admin/backups/api/download/${name}`;
    setTimeout(hideLoading, 2000);
}

function deleteBackupConfirm(name) {
    if (!confirm(`⚠️ DELETE BACKUP\n\nAre you sure you want to delete "${name}"?\n\nThis action cannot be undone.`)) {
        return;
    }
    
    deleteBackup(name);
}

async function deleteBackup(name) {
    showLoading('Deleting backup...');
    
    try {
        const response = await fetch(`/admin/backups/api/delete/${name}`, {
            method: 'DELETE'
        });
        
        const data = await response.json();
        hideLoading();
        
        if (data.success) {
            showSuccess('Backup deleted successfully!');
            loadBackups();
        } else {
            showError('Delete failed: ' + data.error);
        }
    } catch (error) {
        hideLoading();
        showError('Error deleting backup: ' + error.message);
    }
}

function refreshBackupList() {
    loadBackups();
    showSuccess('Backup list refreshed!');
}

// Helper functions
function formatTimestamp(timestamp) {
    if (!timestamp) return 'N/A';
    return timestamp.replace('T', ' ').substring(0, 19);
}

function formatSize(bytes) {
    if (!bytes) return '0 MB';
    const mb = bytes / 1024 / 1024;
    return mb.toFixed(2) + ' MB';
}

function showLoading(message) {
    // Use existing modal or create simple overlay
    const existing = document.getElementById('loadingOverlay');
    if (existing) {
        existing.style.display = 'flex';
        document.getElementById('loadingMessage').textContent = message;
    }
}

function hideLoading() {
    const existing = document.getElementById('loadingOverlay');
    if (existing) {
        existing.style.display = 'none';
    }
}

function showSuccess(message) {
    alert('✓ ' + message);
}

function showError(message) {
    alert('✗ ' + message);
}
