            if (!confirm('Approve this improvement?')) return;
            try {
                const res = await fetch(`/tools/admin/improvements/${id}/approve`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    alert('✓ Approved');
                    loadImprovementsList();
                }
            } catch (e) {
                alert('Error: ' + e.message);
            }
        }

        async function rejectImprovement(id) {
            if (!confirm('Reject this improvement?')) return;
            try {
                const res = await fetch(`/tools/admin/improvements/${id}/reject`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    alert('✓ Rejected');
                    loadImprovementsList();
                }
            } catch (e) {
                alert('Error: ' + e.message);
            }
        }

        function editImprovement(id, filePath) {
            currentImprovementId = id;
            openFileEditor(filePath);
        }

        async function openFileEditor(filePath) {
            if (!monacoInstance) {
                require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.44.0/min/vs' }});
                require(['vs/editor/editor.main'], function() {
                    monacoInstance = monaco.editor.create(document.getElementById('monacoEditor'), {
                        value: '',
                        language: 'python',
                        theme: 'vs-dark',
                        automaticLayout: true
                    });
                });
                await new Promise(r => setTimeout(r, 1000));
            }

            try {
                const res = await fetch('/tools/admin/files/read', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ path: filePath })
                });
                const data = await res.json();
                if (data.success) {
                    currentFile = filePath;
                    monacoInstance.setValue(data.content);
                    document.getElementById('editingFile').textContent = filePath;
                    document.getElementById('fileEditorContainer').style.display = 'block';
                    document.getElementById('fileEditorContainer').scrollIntoView({ behavior: 'smooth' });
                }
            } catch (e) {
                alert('Error: ' + e.message);
            }
        }

        async function saveEditedFile() {
            if (!currentFile) return;
            if (!confirm('Save changes to ' + currentFile + '?')) return;

            try {
                const content = monacoInstance.getValue();
                const res = await fetch('/tools/admin/files/write', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ path: currentFile, content: content })
                });
                const data = await res.json();
                if (data.success) {
                    alert('✓ Saved! Backup created.');
                    if (currentImprovementId) {
                        await fetch(`/tools/admin/improvements/${currentImprovementId}/implement`, { method: 'POST' });
                    }
                    closeEditor();
                    loadImprovementsList();
                }
            } catch (e) {
                alert('Error: ' + e.message);
            }
        }

        function closeEditor() {
            document.getElementById('fileEditorContainer').style.display = 'none';
            currentFile = null;
            currentImprovementId = null;
        }

        function filterPending() {
            loadImprovementsList();
        }

        document.addEventListener('DOMContentLoaded', function() {
            const nav = document.querySelector('[data-section="improvements"]');
            if (nav) {
                nav.addEventListener('click', loadImprovementsList);
            }
        });
        </script>




