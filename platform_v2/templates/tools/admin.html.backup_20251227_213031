// Analytics Functions
let userGrowthChart = null;
let revenueChart = null;

async function loadAnalytics() {
    try {
        // Load user growth data
        const userResponse = await fetch('/tools/admin/analytics/user-growth');
        const userData = await userResponse.json();
        
        if (userData.success && userData.data.length > 0) {
            const ctx = document.getElementById('userGrowthChart');
            if (ctx) {
                if (userGrowthChart) userGrowthChart.destroy();
                
                userGrowthChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: userData.data.map(d => d.date),
                        datasets: [{
                            label: 'New Users',
                            data: userData.data.map(d => d.count),
                            borderColor: '#00FF00',
                            backgroundColor: 'rgba(0, 255, 0, 0.1)',
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { labels: { color: '#00FF00' } }
                        },
                        scales: {
                            y: { 
                                ticks: { color: '#00FF00' },
                                grid: { color: 'rgba(0, 255, 0, 0.2)' }
                            },
                            x: { 
                                ticks: { color: '#00FF00' },
                                grid: { color: 'rgba(0, 255, 0, 0.2)' }
                            }
                        }
                    }
                });
            }
        }
        
        // Load revenue data
        const revenueResponse = await fetch('/tools/admin/analytics/revenue');
        const revenueData = await revenueResponse.json();
        
        if (revenueData.success && revenueData.data.length > 0) {
            const ctx = document.getElementById('revenueChart');
            if (ctx) {
                if (revenueChart) revenueChart.destroy();
                
                revenueChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: revenueData.data.map(d => d.date),
                        datasets: [{
                            label: 'Revenue ($)',
                            data: revenueData.data.map(d => parseFloat(d.revenue)),
                            backgroundColor: 'rgba(0, 255, 0, 0.3)',
                            borderColor: '#00FF00',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: { labels: { color: '#00FF00' } }
                        },
                        scales: {
                            y: { 
                                ticks: { color: '#00FF00' },
                                grid: { color: 'rgba(0, 255, 0, 0.2)' }
                            },
                            x: { 
                                ticks: { color: '#00FF00' },
                                grid: { color: 'rgba(0, 255, 0, 0.2)' }
                            }
                        }
                    }
                });
            }
        }
    } catch (error) {
        console.error('Error loading analytics:', error);
    }
}

