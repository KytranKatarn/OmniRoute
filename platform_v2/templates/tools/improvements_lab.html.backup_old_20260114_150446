        async function loadEscalationChat(proposalId) {
            try {
                const res = await fetch(`/tools/improvements-lab/proposals/${proposalId}/chat-history`);
                const data = await res.json();

                const container = document.getElementById(`escalation-chat-messages-${proposalId}`);
                if (!container) return;

                if (data.success && data.messages && data.messages.length > 0) {
                    container.innerHTML = data.messages.map(msg => renderChatMessage(msg)).join('');
                    container.scrollTop = container.scrollHeight;
                } else {
                    container.innerHTML = '<div style="text-align: center; opacity: 0.5; padding: 20px;">No messages yet. Start the conversation!</div>';
                }
            } catch (e) {
                console.error('Error loading escalation chat:', e);
            }
        }

        function renderChatMessage(msg) {
            const isHuman = msg.sender.type === 'human';
            const isContractor = msg.sender.type === 'contractor';
            const isSystem = msg.sender.type === 'system';

            const bgColor = isHuman ? 'rgba(0,100,255,0.2)' : isContractor ? 'rgba(0,255,255,0.15)' : 'rgba(100,100,100,0.2)';
            const borderColor = isHuman ? '#0066FF' : isContractor ? '#00FFFF' : '#666';
            const align = isHuman ? 'flex-end' : 'flex-start';

            const time = new Date(msg.created_at).toLocaleTimeString();

            return `
                <div style="display: flex; justify-content: ${align}; margin-bottom: 10px;">
                    <div style="max-width: 80%; background: ${bgColor}; border-left: 3px solid ${borderColor}; padding: 10px; border-radius: 4px;">
                        <div style="font-size: 0.75rem; opacity: 0.7; margin-bottom: 5px;">
                            ${isSystem ? '🔔 System' : isContractor ? `🤖 ${msg.sender.name}` : `👤 ${msg.sender.name}`}
                            <span style="margin-left: 10px;">${time}</span>
                        </div>
                        <div style="white-space: pre-wrap; word-break: break-word;">${msg.content}</div>
                    </div>
                </div>
            `;
        }

        async function sendEscalationChat(proposalId) {
            const input = document.getElementById(`escalation-chat-input-${proposalId}`);
            const message = input.value.trim();
            if (!message) return;

            input.value = '';
            input.disabled = true;

            // Add user message immediately
            const container = document.getElementById(`escalation-chat-messages-${proposalId}`);
            container.innerHTML += renderChatMessage({
                sender: { type: 'human', name: 'You' },
                content: message,
                created_at: new Date().toISOString()
            });

            // Add typing indicator
            container.innerHTML += '<div id="typing-indicator" style="text-align: center; opacity: 0.5; padding: 10px;">🤖 Contractor is typing...</div>';
            container.scrollTop = container.scrollHeight;

            try {
                const res = await fetch(`/tools/improvements-lab/proposals/${proposalId}/contractor-chat`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message })
                });
                const data = await res.json();

                // Remove typing indicator
                const typingIndicator = document.getElementById('typing-indicator');
                if (typingIndicator) typingIndicator.remove();

                if (data.success) {
                    container.innerHTML += renderChatMessage({
                        sender: { type: 'contractor', name: data.contractor_name || 'Contractor' },
                        content: data.contractor_response,
                        created_at: new Date().toISOString()
                    });
                    container.scrollTop = container.scrollHeight;
                } else {
                    showError('Failed to send message: ' + data.error);
                }
            } catch (e) {
                const typingIndicator = document.getElementById('typing-indicator');
                if (typingIndicator) typingIndicator.remove();
                showError('Error: ' + e.message);
            }

            input.disabled = false;
            input.focus();
        }

        async function applyContractorFix(proposalId) {
            if (!confirm('Apply the contractor\'s fix?\n\nThis will update the code and reset the retry counter for re-testing.')) {
                return;
            }

            try {
                const res = await fetch(`/tools/improvements-lab/proposals/${proposalId}/apply-contractor-fix`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();

                if (data.success) {
                    showSuccess('Contractor fix applied! Ready for re-testing.');
                    setTimeout(() => {
                        closeModal('proposalDetailModal');
                        loadProposals();
                    }, 1000);
                } else {
                    showError('Failed to apply fix: ' + data.error);
                }
            } catch (e) {
                showError('Error: ' + e.message);
            }
        }

        async function tryAnotherContractor(proposalId) {
            if (!confirm('Switch to a different contractor?\n\nThe new contractor will review the same failure context.')) {
                return;
            }

            try {
                const res = await fetch(`/tools/improvements-lab/proposals/${proposalId}/try-another-contractor`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();

                if (data.success) {
                    showSuccess(`Switched to ${data.contractor.name} (${data.contractor.api_provider})`);
                    setTimeout(() => viewProposal(proposalId), 1000);
                } else {
                    showError('Failed to switch: ' + data.error);
                }
            } catch (e) {
                showError('Error: ' + e.message);
            }
        }

        async function escalateToHumanOnly(proposalId) {
            const reason = prompt('Why is this too complex for AI?\n(This will mark it for human-only investigation)', 'Too complex for automated resolution');
            if (reason === null) return;

            try {
                const res = await fetch(`/tools/improvements-lab/proposals/${proposalId}/escalate-to-human-only`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reason })
                });
                const data = await res.json();

                if (data.success) {
                    showSuccess('Marked for human-only investigation.');
                    setTimeout(() => {
                        closeModal('proposalDetailModal');
                        loadProposals();
                    }, 1000);
                } else {
                    showError('Failed: ' + data.error);
                }
            } catch (e) {
                showError('Error: ' + e.message);
            }
        }

        async function resetAndRetry(proposalId) {
            if (!confirm('Reset retry count and try again?\n\nThis will clear the escalation status and allow the internal team to retry.')) {
                return;
            }

            try {
                const res = await fetch(`/tools/improvements-lab/proposals/${proposalId}/reset-retries`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();

                if (data.success) {
                    showSuccess('Retries reset. Ready for new attempt.');
                    setTimeout(() => {
                        closeModal('proposalDetailModal');
                        loadProposals();
                    }, 1000);
                } else {
                    showError('Failed: ' + data.error);
                }
            } catch (e) {
                showError('Error: ' + e.message);
            }
        }

