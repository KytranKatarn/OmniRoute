        // Workflow Pipeline - show step-by-step progress for proposals
        async function refreshWorkflowPipeline() {
            try {
                // Pulse indicator to show refresh
                const indicator = document.getElementById('workflow-refresh-indicator');
                if (indicator) {
                    indicator.style.opacity = '1';
                    indicator.style.transition = 'opacity 0.3s';
                }
                // Get proposals in active workflow
                const res = await fetch('/tools/improvements-lab/proposals');
                const data = await res.json();
                const container = document.getElementById('workflow-pipeline');

                if (!data.success || !data.proposals || data.proposals.length === 0) {
                    container.innerHTML = '<div style="opacity: 0.6; padding: 8px; text-align: center; font-size: 0.85rem;">No active workflows</div>';
                    return;
                }

                // Find proposal with active or recent workflow
                // Priority: pending_approval > approved > generating_code > code_generated > creating_sandbox > applying_changes > ready_for_testing > testing > ready_for_review
                const workflowStates = ['pending_approval', 'approved', 'generating_code', 'code_generated', 'creating_sandbox', 'sandbox_created', 'applying_changes', 'ready_for_testing', 'testing', 'tested', 'ready_for_review'];
                let proposal = null;

                for (const state of workflowStates) {
                    proposal = data.proposals.find(p => p.status === state);
                    if (proposal) break;
                }

                if (!proposal) {
                    container.innerHTML = '<div style="opacity: 0.6; padding: 8px; text-align: center; font-size: 0.85rem;">No active workflows</div>';
                    return;
                }

                // Try to get live workflow status from background runner
                let workflowStatus = null;
                try {
                    const statusRes = await fetch(`/tools/improvements-lab/workflow/status/${proposal.id}`);
                    if (statusRes.ok) {
                        const statusData = await statusRes.json();
                        if (statusData.success) {
                            workflowStatus = statusData.workflow;
                        }
                    }
                } catch (e) {
                    console.log('No live workflow status available:', e);
                }

                // Define workflow steps based on new state machine
                const currentState = proposal.status;
                const stateOrder = ['proposed', 'approved', 'generating_code', 'code_generated', 'creating_sandbox', 'sandbox_created', 'applying_changes', 'ready_for_testing', 'testing', 'tested', 'ready_for_review', 'deploying', 'deployed'];
                const currentStateIndex = stateOrder.indexOf(currentState);

                // Map workflow states to visual steps
                const steps = [
                    {
                        id: 'approval',
                        name: currentStateIndex >= stateOrder.indexOf('approved') ? 'Approved' : 'Awaiting Approval',
                        icon: currentStateIndex >= stateOrder.indexOf('approved') ? '✅' : '⏳',
                        status: currentStateIndex >= stateOrder.indexOf('approved') ? 'complete' : (currentState === 'proposed' || currentState === 'pending_approval' ? 'active' : 'pending'),
                        states: ['proposed', 'pending_approval', 'approved']
                    },
                    {
                        id: 'code_gen',
                        name: currentState === 'generating_code' ? 'Generating...' : 'Code Gen',
                        icon: currentStateIndex >= stateOrder.indexOf('code_generated') ? '✅' : (currentState === 'generating_code' ? '⚡' : '📝'),
                        status: currentStateIndex >= stateOrder.indexOf('code_generated') ? 'complete' : (currentState === 'generating_code' ? 'active' : 'pending'),
                        states: ['generating_code', 'code_generated']
                    },
                    {
                        id: 'sandbox',
                        name: currentState === 'creating_sandbox' ? 'Creating...' : 'Sandbox',
                        icon: currentStateIndex >= stateOrder.indexOf('sandbox_created') ? '✅' : (currentState === 'creating_sandbox' ? '🏗️' : '🧪'),
                        status: currentStateIndex >= stateOrder.indexOf('sandbox_created') ? 'complete' : (currentState === 'creating_sandbox' ? 'active' : 'pending'),
                        states: ['creating_sandbox', 'sandbox_created']
                    },
                    {
                        id: 'apply',
                        name: currentState === 'applying_changes' ? 'Applying...' : 'Apply Code',
                        icon: currentStateIndex >= stateOrder.indexOf('ready_for_testing') ? '✅' : (currentState === 'applying_changes' ? '⚙️' : '📋'),
                        status: currentStateIndex >= stateOrder.indexOf('ready_for_testing') ? 'complete' : (currentState === 'applying_changes' ? 'active' : 'pending'),
                        states: ['applying_changes']
                    },
                    {
                        id: 'testing',
                        name: currentState === 'testing' ? 'Testing...' : 'Tests',
                        icon: currentStateIndex >= stateOrder.indexOf('tested') ? '✅' : (currentState === 'testing' ? '🔬' : '🧪'),
                        status: currentStateIndex >= stateOrder.indexOf('tested') ? 'complete' : (['testing', 'ready_for_testing'].includes(currentState) ? 'active' : 'pending'),
                        states: ['ready_for_testing', 'testing', 'tested']
                    },
                    {
                        id: 'review',
                        name: 'Ready',
                        icon: currentState === 'ready_for_review' ? '👁️' : (currentStateIndex >= stateOrder.indexOf('deploying') ? '✅' : '📊'),
                        status: currentState === 'ready_for_review' ? 'active' : (currentStateIndex >= stateOrder.indexOf('deploying') ? 'complete' : 'pending'),
                        states: ['ready_for_review']
                    },
                    {
                        id: 'deploy',
                        name: currentState === 'deploying' ? 'Deploying...' : 'Deploy',
                        icon: currentState === 'deployed' ? '✅' : (currentState === 'deploying' ? '🚀' : '🚀'),
                        status: currentState === 'deployed' ? 'complete' : (currentState === 'deploying' ? 'active' : 'pending'),
                        states: ['deploying', 'deployed']
                    }
                ];

                let html = `
                    <div style="border: 2px solid #FFA500; background: rgba(255,165,0,0.05); border-radius: 8px; padding: 15px;">
                        
                        <div style="margin-bottom: 15px;">
                            <div style="font-weight: bold; color: #FFA500; margin-bottom: 5px;">
