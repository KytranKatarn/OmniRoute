        async function runSandboxTests(sandboxId, proposalId) {
            showInfo(`Running tests in sandbox #${sandboxId}...`);

            try {
                const res = await fetch(`/tools/improvements-lab/sandboxes/${sandboxId}/test`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({
                        proposal_id: proposalId,
                        sandbox_type: 'schema_separation'
                    })
                });
                const data = await res.json();

                if (data.success) {
                    const passed = data.test_results?.passed || 0;
                    const total = data.test_results?.total || 0;
                    if (passed === total && total > 0) {
                        showSuccess(`✅ All tests passed! ${passed}/${total} successful`);
                    } else if (total === 0) {
                        showWarning(`⚠️ No test suites configured or found`);
                    } else {
                        showWarning(`⚠️ Tests completed: ${passed}/${total} passed`);
                    }
                    refreshSandboxes();
                    return data;
                } else {
                    showError(`Tests failed: ${data.error}`);
                    return data;
                }
            } catch (e) {
                showError(`Error running tests: ${e.message}`);
                return null;
            }
        }

