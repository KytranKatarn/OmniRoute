    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=JetBrains+Mono&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'JetBrains Mono', monospace;
            background: #010409;
            color: #00ff41;
            min-height: 100vh;
        }

        /* Navigation */
        nav {
            background: #0d1117;
            border-bottom: 2px solid #00ff41;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        nav h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.5rem;
            color: #39ff14;
            text-shadow: 0 0 10px #39ff14;
        }

        nav a {
            color: #00ff41;
            text-decoration: none;
            padding: 0.5rem 1rem;
            border: 1px solid #00ff41;
            border-radius: 4px;
            transition: all 0.3s;
        }

        nav a:hover {
            background: #00ff41;
            color: #010409;
            box-shadow: 0 0 10px #00ff41;
        }

        /* Main Container */
        .container {
            max-width: 1600px;
            margin: 0 auto;
            padding: 30px;
        }

        /* Section Headers */
        .section-header {
            font-family: 'Orbitron', sans-serif;
            font-size: 2rem;
            color: #39ff14;
            margin-bottom: 10px;
            text-shadow: 0 0 10px rgba(57, 255, 20, 0.5);
        }

        .section-subtitle {
            color: #888;
            margin-bottom: 30px;
            font-size: 1rem;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: #0d1117;
            border: 1px solid #00FF00;
            padding: 20px;
            text-align: center;
            border-radius: 8px;
            transition: all 0.3s;
        }

        .stat-card:hover {
            box-shadow: 0 0 15px rgba(0,255,0,0.3);
            transform: translateY(-2px);
        }

        .stat-label {
            font-size: 0.85rem;
            color: #888;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .stat-value {
            font-size: 2.5rem;
            font-weight: bold;
            color: #00FF00;
        }

        /* Buttons */
        .btn {
            padding: 10px 20px;
            border: 1px solid #00FF00;
            background: transparent;
            color: #00FF00;
            font-family: 'JetBrains Mono', monospace;
            cursor: pointer;
            border-radius: 4px;
            transition: all 0.3s;
        }

        .btn:hover {
            background: #00FF00;
            color: #000;
            box-shadow: 0 0 10px #00FF00;
        }

        .btn-small {
            padding: 6px 12px;
            font-size: 0.85rem;
        }

        .action-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 20px;
        }

        /* Chart containers */
        .chart-container {
            background: #0d1117;
            border: 1px solid #00FF00;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 768px) {
            .stats-grid { grid-template-columns: 1fr; }
            nav { flex-direction: column; gap: 10px; }
        }
    </style>
</head>
