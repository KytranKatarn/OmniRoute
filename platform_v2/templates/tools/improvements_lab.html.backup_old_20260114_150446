        function displayAgentAPIMapping(agents, providers) {
            const container = document.getElementById('agentAPIMapping');
            if (!container) return;

            // Group agents by required provider
            const providerGroups = {};

            agents.forEach(agent => {
                if (agent.worker_type !== 'contract') return;

                // Determine provider from model
                const model = agent.model.toLowerCase();
                let provider = 'unknown';

                if (model.includes('claude') || model.includes('anthropic')) provider = 'claude';
                else if (model.includes('gpt') || model.includes('openai')) provider = 'openai';
                else if (model.includes('mistral') && !model.includes(':latest')) provider = 'mistral';
                else if (model.includes('gemini') || model.includes('google')) provider = 'gemini';

                if (!providerGroups[provider]) providerGroups[provider] = [];
                providerGroups[provider].push(agent);
            });

            container.innerHTML = '';

            if (Object.keys(providerGroups).length === 0) {
                container.innerHTML = `
                    <div style="padding: 20px; text-align: center; opacity: 0.6;">
                        ✓ No contract agents configured. All agents use internal/FREE models.
                    </div>
                `;
                return;
            }

            // Create provider blocks
            for (const [provider, agentList] of Object.entries(providerGroups)) {
                const providerConfig = providers.find(p => p.provider === provider);
                const isConfigured = providerConfig && providerConfig.enabled && providerConfig.api_key;
                const statusColor = isConfigured ? '#00FF00' : '#FF4444';
                const statusIcon = isConfigured ? '✓' : '⚠️';
                const statusText = isConfigured ? 'CONFIGURED' : 'NOT CONFIGURED';

                const providerBlock = document.createElement('div');
                providerBlock.style.cssText = 'border: 1px solid ' + statusColor + '; padding: 20px; margin-bottom: 15px; background: rgba(0,255,0,0.02);';

                providerBlock.innerHTML = `
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                        <div>
                            <strong style="font-size: 1.1rem;">${provider.toUpperCase()} API</strong>
                            <div style="opacity: 0.7; margin-top: 5px;">${agentList.length} contract agent(s) require this API</div>
                        </div>
                        <div style="color: ${statusColor}; font-weight: bold;">
                            ${statusIcon} ${statusText}
                        </div>
                    </div>

                    <div style="margin: 15px 0; padding: 10px; background: rgba(0,0,0,0.3); border-left: 3px solid ${statusColor};">
                        <strong>Agents using ${provider.toUpperCase()}:</strong><br>
                        ${agentList.map(a => `
                            <span style="display: inline-block; margin: 5px 10px 5px 0;">
                                • ${a.name} (${a.department})
                            </span>
                        `).join('')}
                    </div>

                    ${!isConfigured ? `
                        <div style="margin-top: 10px; padding: 10px; background: rgba(255,68,68,0.1); border: 1px solid #FF4444;">
                            <strong>⚠️ WARNING:</strong> These agents cannot be used until ${provider.toUpperCase()} API is configured.<br>
                            <strong>Fallback:</strong> A.R.C.H.I.E. will automatically assign internal staff instead.
                        </div>
                    ` : ''}

                    <div style="margin-top: 15px;">
                        <button class="btn btn-small" onclick="document.querySelector('#api_key_${provider}').scrollIntoView({behavior: 'smooth'})">
                            ${isConfigured ? '📝 UPDATE API KEY' : '🔑 CONFIGURE API KEY'}
                        </button>
                    </div>
                `;

                container.appendChild(providerBlock);
            }
        }

