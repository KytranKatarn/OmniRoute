        async function executeProposal(proposalId) {
            // Use the proper sandbox workflow
            if (!confirm('Start sandbox workflow for this proposal?\n\nThis will:\n1. Create a sandbox environment\n2. Apply changes in isolation\n3. Run tests\n4. Allow you to review and deploy\n\nProceed?')) return;

            try {
                showInfo('🧪 Creating sandbox environment...');

                // Step 1: Create sandbox for the proposal
                const sandboxRes = await fetch('/tools/improvements-lab/sandboxes/create', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ proposal_id: proposalId })
                });
                const sandboxData = await sandboxRes.json();

                if (!sandboxData.success) {
                    showError('Failed to create sandbox: ' + sandboxData.error);
                    return;
                }

                showSuccess(`Sandbox #${sandboxData.sandbox_id} created!`);

                // Step 2: Update proposal status to testing
                await fetch(`/tools/improvements-lab/proposals/${proposalId}/update-status`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ status: 'testing' })
                });

                // Step 3: Open sandbox viewer to continue workflow
                closeProposalModal();
                loadProposals(currentProposalFilter);

                // Small delay to ensure UI updates
                setTimeout(() => {
                    openSandboxViewer(proposalId);
                }, 500);

            } catch (e) {
                showError('Error: ' + e.message);
            }
        }

