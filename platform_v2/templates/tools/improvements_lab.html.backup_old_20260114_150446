        async function fetchCodePreview(proposalId) {
            try {
                const response = await fetch(`/tools/improvements-lab/proposals/${proposalId}/preview`);
                const data = await response.json();

                const contentEl = document.getElementById(`code-preview-content-${proposalId}`);
                if (!contentEl) return;

                if (!data.success || !data.has_preview) {
                    contentEl.innerHTML = '<p style="opacity: 0.6; font-style: italic;">No code preview available</p>';
                    return;
                }

                // Parse diff data
                const diffData = typeof data.code_diff === 'string' ? JSON.parse(data.code_diff) : data.code_diff;

                let previewHtml = '';

                // Show summary stats
                if (diffData.summary) {
                    previewHtml += `
                        <div style="display: flex; gap: 20px; margin-bottom: 20px; padding: 15px; background: rgba(0,255,0,0.05); border-radius: 4px;">
                            <div style="flex: 1; text-align: center;">
                                <div style="font-size: 24px; color: #00FF00; font-weight: bold;">${diffData.summary.total_files}</div>
                                <div style="opacity: 0.7; font-size: 0.85rem;">Files</div>
                            </div>
                            <div style="flex: 1; text-align: center;">
                                <div style="font-size: 24px; color: #00FF00; font-weight: bold;">+${diffData.summary.total_added}</div>
                                <div style="opacity: 0.7; font-size: 0.85rem;">Added</div>
                            </div>
                            <div style="flex: 1; text-align: center;">
                                <div style="font-size: 24px; color: #FF6B6B; font-weight: bold;">-${diffData.summary.total_removed}</div>
                                <div style="opacity: 0.7; font-size: 0.85rem;">Removed</div>
                            </div>
                            <div style="flex: 1; text-align: center;">
                                <div style="font-size: 24px; color: #FFD700; font-weight: bold;">~${diffData.summary.total_modified}</div>
                                <div style="opacity: 0.7; font-size: 0.85rem;">Modified</div>
                            </div>
                        </div>
                    `;
                }

                // Show each file diff
                if (diffData.files && diffData.files.length > 0) {
                    diffData.files.forEach(file => {
                        previewHtml += `
                            <div style="margin-bottom: 25px; border: 1px solid rgba(0,255,0,0.2); border-radius: 4px; overflow: hidden;">
                                <div style="background: rgba(0,255,0,0.1); padding: 10px 15px; font-weight: bold; display: flex; justify-content: space-between; align-items: center;">
                                    <div>
                                        <span style="color: #00FF00;">📄</span> ${file.path}
                                    </div>
                                    <div style="font-size: 0.85rem; opacity: 0.8;">
                                        <span style="color: #00FF00;">+${file.stats.lines_added}</span>
                                        <span style="color: #FF6B6B;">-${file.stats.lines_removed}</span>
                                    </div>
                                </div>
                                <div style="background: #1a1a1a; padding: 15px; overflow-x: auto;">
                                    <pre style="margin: 0; font-family: 'Courier New', monospace; font-size: 0.85rem; line-height: 1.5;">${escapeHtml(file.diff || 'No diff available')}</pre>
                                </div>
                            </div>
                        `;
                    });
                } else {
                    previewHtml += '<p style="opacity: 0.6;">No file changes to preview</p>';
                }

                contentEl.innerHTML = previewHtml;

            } catch (error) {
                console.error('Error fetching code preview:', error);
                const contentEl = document.getElementById(`code-preview-content-${proposalId}`);
                if (contentEl) {
                    contentEl.innerHTML = '<p style="color: #FF6B6B;">Failed to load preview</p>';
                }
            }
        }

