        // Load and display test results for a proposal
        async function loadTestResults(proposalId) {
            try {
                const res = await fetch(`/tools/improvements-lab/proposals/${proposalId}/sandbox`);
                const data = await res.json();
                const container = document.getElementById(`test-results-${proposalId}`);

                if (!data.success || !data.sandbox) {
                    container.innerHTML = '<div style="opacity: 0.6; padding: 10px; text-align: center;">No sandbox created yet</div>';
                    return;
                }

                const sandbox = data.sandbox;
                const testResults = sandbox.test_results || {};

                let html = `
                    <div style="border: 1px solid #00FF00; padding: 15px; border-radius: 4px; background: rgba(0,255,0,0.03);">
                        <div style="margin-bottom: 10px;">
                            <strong style="color: #00FF00;">Sandbox #${sandbox.id}</strong> (${sandbox.sandbox_type})
                        </div>
                `;

                if (testResults.results && testResults.results.length > 0) {
                    html += '<div style="margin: 10px 0;"><strong>Test Results:</strong></div>';
                    testResults.results.forEach(test => {
