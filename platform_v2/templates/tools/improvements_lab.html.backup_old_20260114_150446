                    const onclick = clickable ? `onclick="openSandboxViewer(${proposal.id})"` : '';
                    const hoverEffect = clickable ? 'transition: all 0.2s; onmouseover="this.style.transform=\'scale(1.05)\'" onmouseout="this.style.transform=\'scale(1)\'"' : '';

                    html += `
