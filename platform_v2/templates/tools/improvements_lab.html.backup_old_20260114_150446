        function hexToRgb(hex) {
            // Convert hex color to RGB for rgba usage
            const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
            return result ? `${parseInt(result[1], 16)}, ${parseInt(result[2], 16)}, ${parseInt(result[3], 16)}` : '0, 255, 0';
        }

        async function retryProposalWithEscalation(proposalId) {
            if (!confirm('Retry this proposal?\n\nNote: After 3 attempts, it will be escalated to Level 3 contractor support (paid API).')) {
                return;
            }

            try {
                const res = await fetch(`/tools/improvements-lab/proposals/${proposalId}/retry`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin'
                });
                const data = await res.json();

                if (data.success) {
                    if (data.escalated) {
                        showSuccess(`🚀 Escalated to ${data.assigned_agent} (Level 3 Contractor)\n\nThis will use paid API credits.`);
                    } else {
                        showSuccess(`🔄 Retry #${data.attempt_number} started with internal team\n\n${data.attempt_number >= 2 ? '⚠️ Next failure will escalate to Level 3 support' : ''}`);
                    }
                    setTimeout(() => loadProposals(), 1500);
                } else {
                    showError(`Failed to retry: ${data.error || 'Unknown error'}`);
                }
            } catch (e) {
                console.error('Error retrying proposal:', e);
                showError(`Error: ${e.message}`);
            }
        }

