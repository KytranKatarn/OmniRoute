            let html = '';
            categoryBreakdown.forEach(cat => {
                const successRate = cat.count > 0 ? Math.round((cat.implemented / cat.count) * 100) : 0;
                html += `
                    <div style="border-bottom: 1px solid rgba(0,200,255,0.2); padding: 10px; display: flex; justify-content: space-between; align-items: center;">
                        <div style="flex: 1;">
                            <div style="color: #00C8FF; font-weight: bold;">${cat.category}</div>
                            <div style="font-size: 0.85rem; color: #888;">
                                ${cat.implemented} implemented, ${cat.failed} failed
                            </div>
                        </div>
                        <div style="text-align: right;">
                            <div style="font-size: 1.2rem; color: ${successRate >= 50 ? '#00FF00' : '#FFA500'}; font-weight: bold;">
