        // Load and display activity log for a proposal
        async function loadActivityLog(proposalId) {
            try {
                const res = await fetch(`/tools/improvements-lab/proposals/${proposalId}/activity`);
                const data = await res.json();
                const container = document.getElementById(`activity-log-${proposalId}`);

                if (!data.success || !data.activities || data.activities.length === 0) {
                    container.innerHTML = '<div style="opacity: 0.6; padding: 10px; text-align: center;">No activity recorded yet</div>';
