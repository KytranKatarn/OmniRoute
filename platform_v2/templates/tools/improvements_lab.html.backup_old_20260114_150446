                            border: 2px solid ${borderColor};
                            border-radius: 6px;
                            ${pulse}
                            ${cursor}
                        " ${onclick} ${hoverEffect}>
                            <div style="font-size: 1.1rem;">${step.icon}</div>
                            <div style="font-size: 0.65rem; margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${step.name}</div>
                        </div>
                    `;

                    // Arrow between steps (except after last)
                    if (index < steps.length - 1) {
                        html += '<div style="color: #666;">→</div>';
                    }
                });

                html += `
                        </div>

                        
                        <div style="background: rgba(0,0,0,0.3); padding: 10px; border-radius: 4px; font-size: 0.75rem;">
                            <div style="color: #FFA500; font-weight: bold; margin-bottom: 5px;">📋 Workflow Status:</div>
                            <div style="opacity: 0.8; line-height: 1.4;">
                                • Current State: <span style="color: #FFA500; font-weight: bold;">${currentState.toUpperCase().replace(/_/g, ' ')}</span><br>
                                ${workflowStatus && workflowStatus.status === 'running'
                                    ? `• Workflow: <span style="color: #00FFFF; animation: pulse 2s infinite;">⚡ RUNNING IN BACKGROUND</span><br>` +
                                      `• Started: ${new Date(workflowStatus.started_at).toLocaleTimeString()}<br>`
                                    : workflowStatus && workflowStatus.status === 'completed'
                                    ? `• Workflow: <span style="color: #00FF00;">✓ COMPLETED</span><br>` +
                                      `• Completed: ${new Date(workflowStatus.completed_at).toLocaleTimeString()}<br>`
                                    : workflowStatus && workflowStatus.status === 'failed'
                                    ? `• Workflow: <span style="color: #FF0000;">❌ FAILED</span><br>` +
                                      `• Error: ${workflowStatus.error || 'Unknown error'}<br>`
                                    : `• Workflow: <span style="color: #888;">Not started</span><br>`
                                }
                                ${currentState === 'ready_for_review'
                                    ? `• <span style="color: #00FF00; font-weight: bold;">✅ Ready to view in sandbox!</span><br>` +
                                      `• <span style="color: #00FFFF;">Click "VIEW IN SANDBOX" below</span>`
                                    : ''
                                }
                            </div>
                        </div>

                        
                        <div style="margin-top: 10px; text-align: center; display: flex; gap: 10px; justify-content: center;">
                            <button class="btn btn-small" onclick="viewProposal(${proposal.id})" style="background: rgba(0,200,255,0.2);">
                                👁️ VIEW DETAILS
                            </button>
                            ${currentState === 'ready_for_review' || currentStateIndex >= stateOrder.indexOf('ready_for_review')
                                ? `<button class="btn btn-small" onclick="openSandboxViewer(${proposal.id})" style="background: rgba(0,255,0,0.2); border: 2px solid #00FF00;">
                                    🧪 VIEW IN SANDBOX
                                </button>`
                                : ''
                            }
                        </div>
                    </div>
                `;

                // Count only active proposals (pending_approval + approved)
                const activeProposals = data.proposals.filter(p =>
                    p.status === 'pending_approval' || p.status === 'approved'
                );

                // Show count if more than one active proposal
                if (activeProposals.length > 1) {
                    html += `
                        <div style="margin-top: 10px; text-align: center; font-size: 0.75rem; opacity: 0.6;">
                            +${activeProposals.length - 1} more in queue
                        </div>
                    `;
                }

                container.innerHTML = html;

                // Fade out indicator
                setTimeout(() => {
                    if (indicator) indicator.style.opacity = '0.3';
                }, 500);
            } catch (e) {
                console.error('Error loading workflow pipeline:', e);
            }
        }

