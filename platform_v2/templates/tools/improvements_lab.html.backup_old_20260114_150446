        function updateStatusBreakdownChart(statusBreakdown) {
            const ctx = document.getElementById('statusBreakdownChart');
            if (statusBreakdownChart) statusBreakdownChart.destroy();

            const statusMap = {
                'implemented': { label: '✅ Implemented', color: '#00FF00' },
                'proposed': { label: '⏳ Proposed', color: '#FFA500' },
                'failed': { label: '❌ Failed', color: '#FF0000' },
                'rejected': { label: '🚫 Rejected', color: '#888888' }
            };

            const labels = [];
            const dataValues = [];
            const colors = [];

            statusBreakdown.forEach(item => {
                const statusInfo = statusMap[item.status] || { label: item.status, color: '#FFFFFF' };
                labels.push(statusInfo.label);
                dataValues.push(item.count);
                colors.push(statusInfo.color);
            });

            statusBreakdownChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: dataValues,
                        backgroundColor: colors,
                        borderColor: '#000',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { color: '#FFFFFF', font: { family: "'Courier New', monospace" } }
                        }
                    }
                }
            });
        }

