        async function saveAPISettings() {
            showInfo('Saving API settings...');

            try {
                // Collect API keys
                const settings = {};
                ['claude', 'openai', 'gemini', 'grok'].forEach(provider => {
                    const input = document.getElementById(`api_key_${provider}`);
                    if (input) {
                        settings[provider + '_api_key'] = input.value;
                    }
                });

                const res = await fetch('/tools/improvements-lab/api-settings/save', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    credentials: 'same-origin',
                    body: JSON.stringify(settings)
                });

                const data = await res.json();
                if (data.success) {
                    showSuccess('API settings saved successfully!');
                    // Reload provider display
                    await loadAPIProviders();
                } else {
                    showError('Failed to save API settings: ' + (data.error || 'Unknown error'));
                }
            } catch (error) {
                showError('Failed to save API settings: ' + error.message);
            }
        }

        async function testAPIConnections() {
            showInfo('Testing API connections...');

            try {
                const res = await fetch('/tools/improvements-lab/api-settings/test', {
                    method: 'POST',
                    credentials: 'same-origin'
                });

                const data = await res.json();
                if (data.success) {
                    const working = data.results.filter(r => r.working).length;
                    const total = data.results.length;

                    if (working === total) {
                        showSuccess(`All ${total} API connections working!`);
                    } else if (working > 0) {
                        showWarning(`${working}/${total} API connections working`);
                    } else {
                        showError('All API connections failed');
                    }
                } else {
                    showError('Failed to test API connections');
                }
            } catch (error) {
                showError('Failed to test API connections: ' + error.message);
            }
        }
        

        

        // Combined workflow data loader
        async function loadWorkflowData() {
            try {
                await Promise.all([
                    refreshTeamAssignmentsCompact(),
                    refreshWorkflowPipeline(),
                    refreshDeploymentsCompact(),
                    refreshRecentWorkflows()
                ]);
            } catch (e) {
                console.error('Error loading workflow data:', e);
            }
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🚀 Improvements Lab initializing...');
            loadImprovementsStats();
            loadProposals();
            loadImprovementsConversationHistory();
            loadWorkflowData();

            // Start auto-refresh every 3 seconds
            setInterval(loadWorkflowData, 3000);
            console.log('✅ Improvements Lab initialized');
        });

        // Global event delegation for action buttons using data attributes
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.action-btn');
            if (!btn) return;

            const action = btn.getAttribute('data-action');
            const id = parseInt(btn.getAttribute('data-id'));
            const title = btn.getAttribute('data-title') || '';

            if (!action || !id) return;

            // Prevent default and stop propagation
            e.preventDefault();
            e.stopPropagation();

            console.log(`🔘 Action button: ${action} (id: ${id})`);

            // Route to appropriate function
            switch (action) {
                case 'approve':
                    approveProposal(id);
                    break;
                case 'reject':
                    rejectProposal(id);
                    break;
                case 'view':
                    viewProposal(id);
                    break;
                case 'delete':
                    deleteProposal(id, title);
                    break;
                case 'execute':
                    executeProposal(id);
                    break;
                case 'regenerate':
                    regenerateProposalPlan(id);
                    break;
                case 'archive':
                    archiveProposal(id);
                    break;
                case 'deploy':
                    deployProposal(id);
                    break;
                case 'retry':
                    retryProposalWithEscalation(id);
                    break;
                default:
                    console.warn(`Unknown action: ${action}`);
            }
        }, true); // Use capture phase to intercept before other handlers
    </script>
</body>
</html>
