        async function loadProposals(status = null) {
            console.log('📋 loadProposals called, status filter:', status);
            try {
                const url = status ? `/tools/improvements-lab/proposals?status=${status}` : '/tools/improvements-lab/proposals';
                const res = await fetch(url);
                const data = await res.json();
                console.log('📥 Proposals loaded:', data.proposals ? data.proposals.length : 0, 'proposals');

                if (data.success) {
                    allProposals = data.proposals;
                    console.log('✅ All proposals stored. Total:', allProposals.length);
                    displayProposals(allProposals);
                } else {
                    console.error('❌ Failed to load proposals:', data.error);
                }
            } catch (e) {
                console.error('❌ Error loading proposals:', e);
            }
        }

        function filterProposals(status) {
            currentProposalFilter = status;
            if (status) {
                let filtered;
                // Special case: 'implemented' should show both 'implemented' and 'completed'
                if (status === 'implemented') {
                    filtered = allProposals.filter(p => p.status === 'implemented' || p.status === 'completed');
                }
                // Special case: 'proposed' should show proposed, pending_approval, and pending
                else if (status === 'proposed') {
                    filtered = allProposals.filter(p =>
                        p.status === 'proposed' ||
                        p.status === 'pending_approval' ||
                        p.status === 'pending'
                    );
                }
                else {
                    filtered = allProposals.filter(p => p.status === status);
                }
                displayProposals(filtered);
            } else {
                displayProposals(allProposals);
            }
        }

        function displayProposals(proposals) {
            console.log('🖼️ displayProposals called with', proposals.length, 'proposals');
            const container = document.getElementById('proposalsList');

            if (proposals.length === 0) {
                console.log('⚠️ No proposals to display');
                container.innerHTML = `
                    <div style="padding: 40px; text-align: center; opacity: 0.6; border: 1px dashed #00FF00;">
                        No proposals found. Click "NEW PLAN" to create one.
                    </div>
                `;
                return;
            }

            // Group by status for better organization
            const grouped = {
                'proposed': [],
                'pending': [],
                'approved': [],
                'failed': [],
                'completed': [],
                'other': []
            };

            proposals.forEach(p => {
                const status = p.status || 'other';
                if (status === 'proposed') {
                    grouped.proposed.push(p);
                } else if (status === 'pending_approval' || status === 'pending') {
                    grouped.pending.push(p);
                } else if (status === 'approved') {
                    grouped.approved.push(p);
                } else if (status === 'failed') {
                    grouped.failed.push(p);
                } else if (status === 'completed' || status === 'implemented') {
                    grouped.completed.push(p);
                } else {
                    grouped.other.push(p);
                }
            });

            let html = '';

            // Show FAILED first (needs attention)
            if (grouped.failed.length > 0) {
                html += renderProposalGroup('❌ FAILED - NEEDS ATTENTION', grouped.failed, '#FF4444', true, true);
            }

            // Then PROPOSED (waiting for review)
            if (grouped.proposed.length > 0) {
                html += renderProposalGroup('⏳ PROPOSED - WAITING FOR REVIEW', grouped.proposed, '#FFAA00', true, true);
            }

            // Then PENDING (action required)
            if (grouped.pending.length > 0) {
                html += renderProposalGroup('⏳ PENDING REVIEW', grouped.pending, '#FFAA00', true, true);
            }

            // Then APPROVED (ready to execute)
            if (grouped.approved.length > 0) {
                html += renderProposalGroup('✓ APPROVED', grouped.approved, '#00AAFF', true, true);
            }

            // COMPLETED last (collapsed by default)
            if (grouped.completed.length > 0) {
                html += renderProposalGroup('✔ COMPLETED', grouped.completed, '#00FF00', false, true);
            }

            // Other
            if (grouped.other.length > 0) {
                html += renderProposalGroup('📋 OTHER', grouped.other, '#888888', false, false);
            }

            container.innerHTML = html;
        }

        function renderProposalGroup(title, proposals, color, expanded = false, showActions = false) {
            const groupId = 'group-' + title.replace(/[^a-z0-9]/gi, '-');
            const displayStyle = expanded ? 'block' : 'none';

            let html = `
                <div style="margin-bottom: 20px; border: 2px solid ${color}; border-radius: 5px; overflow: hidden;">
                    <div onclick="document.getElementById('${groupId}').style.display = document.getElementById('${groupId}').style.display === 'none' ? 'block' : 'none'"
                         style="background: rgba(${hexToRgb(color)}, 0.1); padding: 12px 15px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid ${color};">
                        <h4 style="margin: 0; color: ${color}; font-size: 0.95rem;">${title} (${proposals.length})</h4>
                        <span style="color: ${color};">▼</span>
                    </div>
                    <div id="${groupId}" style="display: ${displayStyle};">
            `;

            proposals.forEach(p => {
                html += renderCompactProposal(p, color, showActions);
            });

            html += `
                    </div>
                </div>
            `;

            return html;
        }

