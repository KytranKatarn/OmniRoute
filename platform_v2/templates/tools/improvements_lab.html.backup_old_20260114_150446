        // ============================================
        // NOTIFICATION FUNCTIONS - CRITICAL FOR UI
        // ============================================
        function showNotification(type, message, duration = 4000) {
            const colors = {
                success: '#00FF00',
                error: '#FF4444',
                warning: '#FFA500',
                info: '#00FFFF'
            };
            const icons = {
                success: '✓',
                error: '✗',
                warning: '⚠️',
                info: 'ℹ️'
            };

            // Remove any existing notification
            const existing = document.querySelector('.archie-notification');
            if (existing) existing.remove();

            const div = document.createElement('div');
            div.className = 'archie-notification';
            div.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                background: rgba(0,0,0,0.95);
                border: 2px solid ${colors[type]};
                color: ${colors[type]};
                padding: 15px 25px;
                border-radius: 8px;
                font-family: 'Courier New', monospace;
                font-size: 14px;
                z-index: 99999;
                max-width: 400px;
                box-shadow: 0 4px 20px rgba(0,0,0,0.5);
                animation: slideInRight 0.3s ease;
            `;
            div.innerHTML = `<strong>${icons[type]}</strong> ${message}`;
            document.body.appendChild(div);

            // Add animation keyframes if not exists
            if (!document.querySelector('#notification-styles')) {
                const style = document.createElement('style');
                style.id = 'notification-styles';
                style.textContent = `
                    @keyframes slideInRight {
                        from { transform: translateX(100%); opacity: 0; }
                        to { transform: translateX(0); opacity: 1; }
                    }
                `;
                document.head.appendChild(style);
            }

            setTimeout(() => {
                if (div.parentNode) {
                    div.style.animation = 'slideInRight 0.3s ease reverse';
                    setTimeout(() => div.remove(), 300);
                }
            }, duration);

            console.log(`[${type.toUpperCase()}] ${message}`);
        }

        function showSuccess(message) { showNotification('success', message); }
        function showError(message) { showNotification('error', message, 6000); }
        function showWarning(message) { showNotification('warning', message); }
        function showInfo(message) { showNotification('info', message); }

        // ============================================
        // Improvements Chat Functions
        async function loadImprovementsConversationHistory() {
            try {
                const res = await fetch('/tools/improvements-lab/chat/history');
                const data = await res.json();

                if (data.success && data.conversations && data.conversations.length > 0) {
                    const container = document.getElementById('improvementChatMessages');
                    container.innerHTML = '';

                    data.conversations.forEach(conv => {
                        addChatMessage('user', conv.user_message, null, false);
                        addChatMessage('archie', conv.archie_response, null, conv.memory_used, conv.memories_learned);
                    });
                }
            } catch (e) {
                console.error('Error loading conversation history:', e);
            }
        }

        async function sendImprovementChat() {
            const input = document.getElementById('improvementChatInput');
            const msg = input.value.trim();
            if (!msg) return;

            addChatMessage('user', msg);
            input.value = '';

            const thinkingId = 'thinking-' + Date.now();
            addChatMessage('archie', '🧠 Thinking... (checking my memories)', thinkingId, false);

            try {
                const res = await fetch('/tools/improvements-lab/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ message: msg })
                });
                const data = await res.json();

                document.getElementById(thinkingId)?.remove();

                if (data.success) {
                    // Check if we have separate messages (A.R.C.H.I.E. + specialist)
                    if (data.messages && data.messages.length > 0) {
                        // Display each message separately
                        data.messages.forEach(msg => {
                            const msgDelegation = {
                                employee_name: msg.from,
                                employee_title: msg.title,
                                worker_type: msg.worker_type
                            };
                            addChatMessage('archie', msg.response, null, data.memory_used, data.memories_learned, msgDelegation);
                        });
                    } else {
                        // Single message (old format or A.R.C.H.I.E. direct)
                        addChatMessage('archie', data.response, null, data.memory_used, data.memories_learned, data.delegation);
                    }

                    if (data.proposal_created) {
                        setTimeout(loadImprovementsList, 1000);
                    }

                    // Show notification indicator if task was delegated
                    if (data.notification_created) {
                        console.log('📬 Notification created - check your notifications tab');
                        // Optionally trigger a notification badge update here
                    }
                } else {
                    addChatMessage('archie', 'Error: ' + data.error);
                }
            } catch (e) {
                document.getElementById(thinkingId)?.remove();
                addChatMessage('archie', 'Error: ' + e.message);
            }
        }

        function addChatMessage(sender, text, id, memoryUsed, memoriesLearned, delegation) {
            const container = document.getElementById('improvementChatMessages');
            const div = document.createElement('div');
            if (id) div.id = id;

            const isUser = sender === 'user';

            div.style.cssText = `
                margin-bottom: 15px;
                padding: 12px;
                border-left: 3px solid ${isUser ? '#0088ff' : '#00FF00'};
                background: ${isUser ? 'rgba(0,136,255,0.08)' : 'rgba(0,255,65,0.08)'};
                border-radius: 4px;
            `;

            let memoryIndicator = '';
            if (!isUser && memoryUsed) {
                memoryIndicator = '<span style="color: #00FF00; font-size: 0.75rem; margin-left: 10px;">💡 Used Memory</span>';
            }
            if (!isUser && memoriesLearned > 0) {
                memoryIndicator += `<span style="color: #00FF00; font-size: 0.75rem; margin-left: 10px;">📚 Learned ${memoriesLearned} new thing${memoriesLearned > 1 ? 's' : ''}</span>`;
            }

            // Agent info - just name and title
            let agentName = 'A.R.C.H.I.E.';
            let agentTitle = '';

            if (!isUser && delegation && delegation.employee_name) {
                agentName = delegation.employee_name;
                agentTitle = delegation.employee_title || delegation.department;
            }

            div.innerHTML = `
                <div style="font-size: 0.85rem; opacity: 0.7; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center;">
                    <span>
                        <strong>${isUser ? '👤 YOU' : '🤖 ' + agentName}</strong>
                        ${!isUser && agentTitle ? `<span style="opacity: 0.6; font-size: 0.75rem; margin-left: 6px;">• ${agentTitle}</span>` : ''}
                    </span>
                    ${memoryIndicator}
                </div>
                <div style="line-height: 1.6; white-space: pre-wrap;">${escapeHtmlImprovement(text)}</div>
            `;

            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
        }

        function escapeHtmlImprovement(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function clearImprovementChat() {
            if (confirm('Clear conversation history? (Memory will be retained)')) {
                document.getElementById('improvementChatMessages').innerHTML =
                    '<div style="opacity: 0.6; text-align: center; padding: 20px;">Conversation cleared. Start a new discussion...</div>';
            }
        }

        let improvementsStatsData = null;
        let statusBreakdownChart = null;
        let improvementsTimelineChart = null;

        async function loadImprovementsStats() {
            console.log('🔄 [FRONTEND] loadImprovementsStats() called');
            try {
                console.log('📡 [FRONTEND] Fetching improvements stats...');
                const response = await fetch('/tools/improvements-lab/stats/comprehensive');
                console.log('📡 [FRONTEND] Response status:', response.status);
                const data = await response.json();
                console.log('📡 [FRONTEND] Data received:', data);

                if (data.success) {
                    improvementsStatsData = data.stats;

                    // Update main stats
                    document.getElementById('improvements-total').textContent = data.stats.overall.total || 0;
                    document.getElementById('improvements-implemented').textContent = data.stats.overall.implemented || 0;
                    document.getElementById('improvements-proposed').textContent = data.stats.overall.proposed || 0;
                    document.getElementById('improvements-failed').textContent = data.stats.overall.failed || 0;
