        // Deploy proposal to production
        async function deployProposal(proposalId) {
            if (!confirm('Deploy this proposal to PRODUCTION? This will apply the tested changes to the live system.')) {
                return;
            }

            showInfo(`🚀 Deploying Proposal #${proposalId} to production...`);

            try {
                const res = await fetch(`/tools/improvements-lab/proposals/${proposalId}/deploy`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({})
                });

                const data = await res.json();

                if (data.success) {
                    let message = `✅ Deployment successful!\n\n`;
                    message += `Files modified: ${data.files_modified}\n`;

                    if (data.modified_files && data.modified_files.length > 0) {
                        message += `\nModified files:\n${data.modified_files.join('\n')}`;
                    }

                    if (data.deployment_log && data.deployment_log.length > 0) {
                        console.log('📋 Deployment Log:');
                        data.deployment_log.forEach(line => console.log(line));
                    }

                    showSuccess(message);

                    // If restart is required, ask user
                    if (data.restart_required) {
                        if (confirm('⚠️  Python files were modified. Restart A.R.C.H.I.E. to apply changes?')) {
                            await restartArchie();
                        }
                    }

                    closeProposalModal();
                    loadProposals(); // Refresh the list
                } else {
                    let errorMsg = `❌ Deployment failed: ${data.error}`;
                    if (data.deployment_log) {
                        console.error('Deployment log:', data.deployment_log);
                        errorMsg += '\n\nCheck console for details.';
                    }
                    showError(errorMsg);
                }
            } catch (e) {
                console.error('Error deploying proposal:', e);
                showError(`❌ Error deploying proposal: ${e.message}`);
            }
        }

        // Restart A.R.C.H.I.E. services
        async function restartArchie() {
            showInfo('🔄 Restarting A.R.C.H.I.E. services...');

            try {
                const res = await fetch('/tools/improvements-lab/restart-archie', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({})
                });

                const data = await res.json();

                if (data.success) {
                    showSuccess('✅ A.R.C.H.I.E. restarted successfully! Page will reload in 3 seconds...');
                    setTimeout(() => {
                        window.location.reload();
                    }, 3000);
                } else {
                    showError(`❌ Restart failed: ${data.error}`);
                }
            } catch (e) {
                console.error('Error restarting A.R.C.H.I.E.:', e);
                showError(`❌ Error restarting: ${e.message}`);
            }
        }

