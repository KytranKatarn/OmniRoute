        updates.append("updated_at = NOW()")
        values.append(project_id)

        cur.execute(f"""
            UPDATE website_builder_projects
            SET {', '.join(updates)}
            WHERE id = %s
            RETURNING *
        """, values)

        updated = cur.fetchone()
        conn.commit()

        cur.close()
        conn.close()

        return jsonify({
            'success': True,
            'message': 'Project updated',
            'project': dict(updated)
        })
    except Exception as e:
