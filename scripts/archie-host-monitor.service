[Unit]
Description=A.R.C.H.I.E. Host System Monitor
After=network.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /mnt/archie_brain/scripts/host_monitor.py --daemon --output /mnt/archie_brain/host_monitor_data.json
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
