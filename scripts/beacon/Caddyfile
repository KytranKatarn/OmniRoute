        Referrer-Policy "strict-origin-when-cross-origin"
    }
}

# MTA-STS policy host (#mail-sec 2026-06-11). testing mode = report-only,
# never rejects inbound mail. Flip mode->enforce after relay.kytranempowerment.com
# gets a real cert (currently CN=localhost self-signed → would break enforce).
mta-sts.kytranempowerment.com {
	handle /.well-known/mta-sts.txt {
		header Content-Type "text/plain"
		respond `version: STSv1
mode: enforce
mx: mail.kytranempowerment.com
mx: relay.kytranempowerment.com
max_age: 604800
` 200
	}
	respond 404
}


