# Beacon front-door Caddyfile — Phase 3: all hub subdomains
# Route: public DNS -> Beacon (2.25.170.252) -> Headscale mesh -> hub/boston-2
#
# (platform_backend) is the ONE line failover.sh flips hub<->boston-2 in DR:
#   sed 's#reverse_proxy http://100.64.0.4:3000#reverse_proxy http://100.64.0.10:3000#'
# All platform aliases use `import platform_backend` so one flip covers them all.
#
# EXCLUDED from Beacon (DNS stays at hub IP 173.182.133.96):
#   mail, mail-admin, mta-sts  — SMTP/IMAP clients use the A record directly
#   n8n, voice                 — no known running service; dead DNS entries
#
# Hub mesh IP: 100.64.0.4  |  DR (boston-2) mesh IP: 100.64.0.10

(platform_backend) {
	reverse_proxy http://100.64.0.4:3000
}

# ---------------------------------------------------------------------------
# PLATFORM + ALIASES  (all -> archie_platform :3000; DR-flippable)
# ---------------------------------------------------------------------------

platform.kytranempowerment.com {
	import platform_backend
}

