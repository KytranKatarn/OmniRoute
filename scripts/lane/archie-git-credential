#!/usr/bin/env bash
# archie-git-credential - git credential helper: each AI lane pushes to GitHub with its OWN token.
#
# Lane resolution, first match wins:
#   1. $ARCHIE_LANE = codex | claude | opencode  (explicit override)
#   2. the nearest ancestor process whose name is `codex`, `claude` or `opencode`
#      (so a shell spawned by Claude Code, Codex or the OpenCode TUI needs no setup)
#   3. none -> print nothing; git falls through to the next helper (`gh auth git-credential`)
#
# Token = /mnt/archie_brain/secrets/<lane>/github_token.txt. Only answers for github.com.
# The token goes to git on stdout only; it is never logged or placed in argv.
[ "${1:-}" = get ] || exit 0
host=""
while IFS='=' read -r k v; do [ -z "$k" ] && break; [ "$k" = host ] && host="$v"; done
[ "$host" = github.com ] || exit 0

lane="${ARCHIE_LANE:-}"
if [ -z "$lane" ]; then
    p=$PPID
    for _ in $(seq 1 30); do
        [ -r "/proc/$p/stat" ] || break
        case "$(cat "/proc/$p/comm" 2>/dev/null)" in
            codex)    lane=codex;    break ;;
            claude)   lane=claude;   break ;;
            opencode) lane=opencode; break ;;
        esac
        p=$(awk '{print $4}' "/proc/$p/stat" 2>/dev/null)
        [ -n "$p" ] && [ "$p" -gt 1 ] || break
    done
fi
case "$lane" in codex|claude|opencode) ;; *) exit 0 ;; esac

f="/mnt/archie_brain/secrets/${lane}/github_token.txt"
[ -r "$f" ] && [ -s "$f" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(tr -d '\r\n' < "$f")"
