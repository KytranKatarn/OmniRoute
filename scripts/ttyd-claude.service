[Unit]
Description=ttyd Claude CLI Terminal for ARCHIE
Documentation=https://github.com/tsl0922/ttyd
After=network.target

[Service]
Type=simple
User=kytran
Group=kytran
WorkingDirectory=/mnt/archie_brain
ExecStart=/mnt/archie_brain/scripts/start_ttyd.sh
Restart=always
RestartSec=5
Environment=TTYD_PORT=7681
Environment=TTYD_USER=admin
Environment=TTYD_PASS=archie2026

# Security
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/mnt/archie_brain
PrivateTmp=true

[Install]
WantedBy=multi-user.target
