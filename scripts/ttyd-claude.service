[Unit]
Description=ttyd Claude CLI Terminal for ARCHIE
Documentation=https://github.com/tsl0922/ttyd
After=network.target

[Service]
Type=simple
User=kytran
Group=kytran
WorkingDirectory=/mnt/archie_brain
ExecStart=/mnt/archie_brain/scripts/start_ttyd.sh
Restart=always
RestartSec=5
# ⚠️ 17681, NOT 7681. 7681 is the AUTH PROXY's port. start_ttyd.sh does
# TTYD_PORT=${TTYD_PORT:-17681}, so this file saying 7681 made an install start the
# BACKEND on the proxy's port — which is exactly the orphaned `ttyd -p 7681` in #6698.
# The installed unit has always said 17681; only this repo copy was wrong.
Environment=TTYD_PORT=17681
# NOTE: there are deliberately no TTYD_USER/TTYD_PASS here. ttyd itself runs with NO
# credentials of its own, bound to 127.0.0.1; authentication is ttyd_auth_proxy.py on
# :7681, which checks the platform `users` table for is_active AND is_admin. Two dead
# Environment= lines carrying a plaintext user/password sat here and were consumed by
# nothing — removed 2026-09-10. Do not reintroduce credentials into this unit.

# Security
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/mnt/archie_brain
PrivateTmp=true

[Install]
WantedBy=multi-user.target
