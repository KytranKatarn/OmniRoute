# Copy to .env and fill in. Never commit .env.
#
# Generate MEDIA_HUB_SECRET_KEY and MEDIA_HUB_DB_PASSWORD with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Generate MEDIA_HUB_ENCRYPTION_KEY (Fernet) with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# If you are migrating existing encrypted service API keys from the
# ARCHIE platform, reuse the platform's MEDIA_HUB_ENCRYPTION_KEY here —
# otherwise you'll need to re-paste every service API key in the UI.

MEDIA_HUB_DB_PASSWORD=changeme
MEDIA_HUB_SECRET_KEY=changeme
MEDIA_HUB_ENCRYPTION_KEY=changeme

# Initial admin password — only consumed on first boot (creates user
# `admin` if the users table is empty). Rotate via the UI afterwards.
# Leave blank to skip bootstrap; you'll need another way to seed users.
MEDIA_HUB_ADMIN_PASSWORD=

# Optional — enrichment only, can be blank for local-only testing
TMDB_API_KEY=

# Kytran SSO — dual-mode auth. Leave blank to run local-only (passwords only).
# Seed the matching row in the hub's oauth_clients table before enabling.
#   KYTRAN_CLIENT_ID defaults to "media-hub-viewer".
#   KYTRAN_AUTH_URL is used for BOTH the browser OAuth redirect (must be
#     reachable from the user's browser) AND the container's server-to-server
#     token-exchange call (must be reachable from inside Docker — container
#     DNS override in docker-compose.yml handles this). Use the public HTTPS
#     URL. ADR-001 (2026-04-08) will eventually split these once the shared
#     kytran_auth SDK lands (platform task #2064).
#   KYTRAN_REDIRECT_URI must EXACTLY match oauth_clients.redirect_uri or the
#     callback will fail.
KYTRAN_CLIENT_ID=media-hub-viewer
KYTRAN_CLIENT_SECRET=
KYTRAN_AUTH_URL=https://platform.kytranempowerment.com
KYTRAN_REDIRECT_URI=https://media.kytranempowerment.com/auth/kytran/callback
# LAN-access clone — a second oauth_clients row is needed because browser
# session cookies don't cross host boundaries (public subdomain vs LAN IP).
# app.py swaps between these at request time based on request.host. Seed a
# second hub client row with redirect_uri http://192.168.1.200:8105/auth/kytran/callback.
KYTRAN_CLIENT_ID_LAN=media-hub-viewer-lan
KYTRAN_CLIENT_SECRET_LAN=
KYTRAN_REDIRECT_URI_LAN=http://192.168.1.200:8105/auth/kytran/callback
