FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY shared/ /app/shared/
# entity-graph ingest endpoint (T-ING-1) reuses the SINGLE resolver in
# ingest/shared/entity_graph.py (_upsert_entity) — ship it so the consumer can
# import it. No third resolver (ADR-EG-001 §5 / must-fix I1).
COPY ingest/ /app/ingest/
COPY consumer/ /app/consumer/
ENV PYTHONPATH=/app

# Deploy-provenance stamp (#4776, KB #279350): the commit this image was built from,
# surfaced at GET /version so the fleet drift monitor can compare it to the repo head.
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ENV WTF_GIT_SHA=$GIT_SHA
ENV WTF_BUILD_TIME=$BUILD_TIME

EXPOSE 8103
USER nobody
CMD ["gunicorn", "--bind", "0.0.0.0:8103", "--workers", "4", "--timeout", "120", "--access-logfile", "-", "consumer.app:create_app()"]
