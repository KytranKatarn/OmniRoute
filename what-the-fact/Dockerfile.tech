FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# tech/app.py imports `from shared.kytran_auth import KytranAuth` which is a
# shim that re-exports from the pip-installed `kytran_auth` module. Install
# the local kytran-auth-pkg so the shim resolves. A fresh image build of
# wtf-tech silently dropped this in PR #820 deploy — adding it explicitly so
# the dependency is always present.
COPY kytran-auth-pkg/ /app/kytran-auth-pkg/
RUN pip install --no-cache-dir /app/kytran-auth-pkg/
COPY shared/ /app/shared/
COPY tech/ /app/tech/
ENV PYTHONPATH=/app

# Deploy-provenance stamp (#4776, KB #279350): the commit this image was built from,
# surfaced at GET /version so the fleet drift monitor can compare it to the repo head.
ARG GIT_SHA=unknown
ARG BUILD_TIME=unknown
ENV WTF_GIT_SHA=$GIT_SHA
ENV WTF_BUILD_TIME=$BUILD_TIME

EXPOSE 8104
USER nobody
CMD ["gunicorn", "--bind", "0.0.0.0:8104", "--workers", "2", "--timeout", "300", "--access-logfile", "-", "tech.app:create_app()"]
