{
  "manifest_version": 3,
  "name": "What The Fact — Bias Ratings",
  "version": "0.1.0",
  "description": "See Canadian news outlet bias ratings while browsing social media.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://what-the-fact.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.facebook.com/*",
        "https://www.linkedin.com/*",
        "https://www.reddit.com/*"
      ],
      "js": ["bias-logic.js", "content.js"],
      "css": ["bias-badge.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "What The Fact",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
